{
  // Kestrel listens on plain HTTP on the LAN; HAProxy terminates HTTPS in front of it.
  // Restrict this port to the HAProxy host with Windows Firewall (scripts\install-service.ps1 does this).
  "Urls": "http://0.0.0.0:5080",

  "Storage": {
    // Empty = C:\ProgramData\EtsyShopManager. Must NOT be inside Dropbox/OneDrive.
    "DataRoot": ""
  },

  "ReverseProxy": {
    // IP address(es) of HAProxy. Only these may set X-Forwarded-For / X-Forwarded-Proto.
    "TrustedProxies": []
  },

  "Etsy": {
    // Shared by both shops (Etsy limits are per API key).
    "RequestsPerSecond": 5,
    "BurstSize": 2,
    "MaxRetries": 4,
    "Scopes": "listings_r listings_w listings_d shops_r shops_w transactions_r profile_r"
  },

  "Jobs": {
    "PollInterval": "00:00:05",
    "JobTimeout": "00:30:00",
    "SucceededRetentionDays": 30,
    "FailedRetentionDays": 90
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
