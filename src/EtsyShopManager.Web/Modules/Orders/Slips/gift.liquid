{%- comment -%}
  The built-in gift slip, laid out like Etsy's (sizes in points from Etsy's PDF). A gift slip is half a letter page
  (8.5 x 5.5 in) and two print on one sheet, cut apart in the middle: the order on the left (no prices) and, past a fold
  line, the gift side: "A gift for you" with gold sparkles, the item photo, the gift message and who it's from, and a QR
  code to the shop. Etsy's own logo and slogans aren't used, and the shop's name stays on the left so the gift doesn't
  read as the shop's. Instructions linked to the order's listings go small under the items, for the recipient.
{%- endcomment -%}
{%- if order.address_changed %}
{%- comment %}
  A changed address gets a sheet of its own: this box fills the top half, which is cut away, so the gift's recipient
  never sees it.
{% endcomment %}
<div class="gift-label-half">
    <div class="slip-changed gift-changed">
        <div class="slip-changed-flag">&#9888; Address changed</div>
        <div class="slip-changed-body">
            <div class="gift-strong">Ship to</div>
            {%- if order.ship_to_name %}<div>{{ order.ship_to_name }}</div>{% endif %}
            {%- for line in order.address_lines %}<div>{{ line }}</div>{% endfor %}
            <div class="slip-changed-hint">Change the shipping label. Etsy has:</div>
            <div class="slip-changed-was">
                {%- if order.etsy_ship_to_name %}<div>{{ order.etsy_ship_to_name }}</div>{% endif %}
                {%- for line in order.etsy_address_lines %}<div>{{ line }}</div>{% endfor %}
            </div>
        </div>
    </div>
</div>
{%- endif -%}
<section class="gift-slip">
    <div class="gift-fold" aria-hidden="true"></div>

    <div class="gift-left">
        <div class="gift-shop">
            {%- if shop.icon_url %}<img src="{{ shop.icon_url }}" alt="" />{% endif %}
            <div>
                <div class="gift-shop-name">{{ shop.name }}</div>
                {%- if shop.title %}<div>{{ shop.title }}</div>{% endif %}
                {%- if shop.location %}<div>{{ shop.location }}</div>{% endif %}
                {%- if shop.star_seller or shop.sales %}
                <div class="gift-shop-stats">
                    {%- if shop.star_seller %}
                    <span class="star-seller">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" /><path d="M12 5.2l1.95 4.15 4.55.45-3.45 3.05 1 4.45L12 15l-4.05 2.3 1-4.45L5.5 9.8l4.55-.45z" /></svg>
                        Star seller
                    </span>
                    {%- endif %}
                    {%- if shop.sales %}<span>{{ shop.sales }} Sales</span>{% endif %}
                </div>
                {%- endif %}
            </div>
        </div>
        <div class="gift-order">
            <div class="gift-strong">Order #{{ order.receipt_id }}</div>
            {%- if order.ship_to_name %}<div>Shipped to: {{ order.ship_to_name }}</div>{% endif %}
        </div>
        {%- for item in items %}
        <div class="gift-item">
            <div class="gift-strong gift-item-title">{{ item.title }}</div>
            {%- for v in item.variations %}<div>{{ v }}</div>{% endfor %}
            {%- if item.personalization %}<div>Personalization: {{ item.personalization }}</div>{% endif %}
            <div class="gift-qty">Quantity: {{ item.quantity }}</div>
        </div>
        {%- endfor %}
        {%- if order.seller_note %}<div class="gift-seller-note"><div class="gift-strong">Note from {{ shop.name }}</div><div>{{ order.seller_note }}</div></div>{% endif %}
        {%- for doc in documents %}
        <div class="gift-doc">
            {%- if doc.qr_code %}
            <div class="gift-doc-qr">
                <div class="gift-doc-code">{{ doc.qr_code | raw }}</div>
                {%- if doc.qr_caption %}<div>{{ doc.qr_caption }}</div>{% endif %}
            </div>
            {%- endif %}
            <div class="gift-doc-text">
                {%- if doc.heading %}<div class="gift-strong">{{ doc.heading }}</div>{% endif %}
                {%- if doc.text %}<div>{{ doc.text }}</div>{% endif %}
            </div>
        </div>
        {%- endfor %}
    </div>

    <div class="gift-right">
        <div class="gift-head">
            {%- for i in (1..5) %}
            <svg class="gift-sparkle gift-sparkle-{{ i }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.4 2 L11.6 22 M3.2 7.4 L20.6 16.2 M3.8 17 L20.2 6.6" /></svg>
            {%- endfor %}
            <div class="gift-headline">A gift for you</div>
        </div>
        {%- if order.photo_url %}<img class="gift-photo" src="{{ order.photo_url }}" alt="" />{% else %}<div class="gift-photo"></div>{% endif %}
        {%- if order.gift_message %}<div class="gift-message">{{ order.gift_message }}</div>{% endif %}
        {%- if order.gift_from %}<div class="gift-sender">- {{ order.gift_from }}</div>{% endif %}
        <div class="gift-qr">
            <div>Scan below to shop more from this independent seller.</div>
            <div class="gift-qr-code">{{ shop.qr_code | raw }}</div>
        </div>
    </div>
</section>
