<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>EtsyShopManager</AssemblyName>
    <RootNamespace>EtsyShopManager.Web</RootNamespace>
    <UserSecretsId>etsy-shop-manager-0b6f2c1e</UserSecretsId>
    <!-- After NavigateTo during static SSR, code keeps running; pages always `return` after redirecting. -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Fluid.Core" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EtsyShopManager.Core\EtsyShopManager.Core.csproj" />
    <ProjectReference Include="..\EtsyShopManager.Data\EtsyShopManager.Data.csproj" />
    <ProjectReference Include="..\EtsyShopManager.Etsy\EtsyShopManager.Etsy.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Modules\Orders\OrderColors.default.json" LogicalName="OrderColors.default.json" />
    <!-- The built-in packing slip layouts (Liquid + CSS): what a shop prints until it is given a layout of its own. -->
    <EmbeddedResource Include="Modules\Orders\Slips\*.liquid;Modules\Orders\Slips\*.css" LogicalName="Slips.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EtsyShopManager.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shown in the app bar with the git commit, so it's clear which build is running. -->
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
  </ItemGroup>
</Project>
