@using EtsyShopManager.Web.Modules.Listings
@using EtsyShopManager.Web.Modules.Orders
@using EtsyShopManager.Web.Modules.Shops
@inject ShopService Shops
@inject OrderPrintService Print
@inject ISnackbar Snackbar

@* What each shop's packing slips print besides the order: the note printed as "A note from the shop" (Orders → Print
   packing slips), like the packing slip note set on Etsy, which Etsy's API doesn't share; the ships-from address under
   From, whose city and state also go under the shop's name like Etsy's gift slip (Etsy's API has neither); whether it
   prints Etsy's Star Seller
   badge (Etsy's API doesn't say whether a shop is a Star Seller); and the gift message its gift slips print when the buyer
   wrote none. *@
<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Shop details on slips</MudText>
    <MudText Typo="Typo.body2" Class="muted mb-3">
        What each shop prints on its slips besides the order. Etsy doesn't share these with apps, so they are set here.
    </MudText>

    @if (_shops is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_shops.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="muted">Connect a shop to set its packing slip.</MudText>
    }
    else
    {
        @foreach (var s in _shops)
        {
            @* One block per shop, stacked: its name, then the note full width, then the shorter fields side by side on
               wider screens (one under the other on a phone), then the switch and Save. *@
            <div class="esm-slip-shop">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <span class="lp-shopmark">
                        @if (s.IconUrl is { Length: > 0 }) { <img src="@ShopIconCache.UrlFor(s.Id)" alt="" /> }
                        else { @s.Name[..1].ToUpperInvariant() }
                    </span>
                    <MudText Typo="Typo.subtitle1">@s.Name</MudText>
                </MudStack>
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_text[s.Id]" Label="Packing slip note" Lines="3" Variant="Variant.Outlined" Immediate="true"
                                      Margin="Margin.Dense" MaxLength="@OrderPrintService.MaxNoteLength" ReadOnly="@(!_canEdit)"
                                      HelperText="Printed on packing slips as &quot;A note from the shop&quot;. Empty for none."
                                      Placeholder="Thanks for your order! If you have any issues, please send me a message on Etsy!" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="_from[s.Id]" Label="Ships from address" Lines="4" Variant="Variant.Outlined" Immediate="true"
                                      Margin="Margin.Dense" MaxLength="@OrderPrintService.MaxFromAddressLength" ReadOnly="@(!_canEdit)"
                                      Placeholder="@("Shop name\nStreet\nCITY, ST 12345\nUnited States")"
                                      HelperText="@FromHelp(s.Id)" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" @bind-Value="_giftMessage[s.Id]" Label="Gift message when the buyer wrote none" Variant="Variant.Outlined" Immediate="true"
                                      Margin="Margin.Dense" MaxLength="@OrderPrintService.MaxGiftMessageLength"
                                      ReadOnly="@(!_canEdit)" Placeholder="@OrderPrintService.DefaultGiftMessageText"
                                      HelperText="@($"On gift slips without a message from the buyer. Empty means \"{OrderPrintService.DefaultGiftMessageText}\".")" />
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2" Wrap="Wrap.Wrap">
                    <div>
                        <MudSwitch T="bool" @bind-Value="_star[s.Id]" Color="Color.Primary" Label="Star Seller" ReadOnly="@(!_canEdit)" />
                        <MudText Typo="Typo.caption" Class="muted">On while the shop has Etsy's Star Seller badge (Etsy reviews it monthly).</MudText>
                    </div>
                    @if (_canEdit)
                    {
                        <MudStack Row="true" Spacing="2">
                            <SaveButtons Text="@($"Save {s.Name}")" Size="Size.Small" Changed="_saved[s.Id].Changed" Busy="_saving.Contains(s.Id)"
                                         OnSave="() => SaveAsync(s)" OnCancel="_saved[s.Id].Revert" />
                        </MudStack>
                    }
                </MudStack>
            </div>
        }
    }
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<ShopSummary>? _shops;
    private readonly Dictionary<int, string?> _text = [];
    private readonly Dictionary<int, string?> _from = [];
    private readonly Dictionary<int, bool> _star = [];
    private readonly Dictionary<int, string?> _giftMessage = [];
    private readonly Dictionary<int, SavedValues<SlipFields>> _saved = [];
    private readonly HashSet<int> _saving = [];
    private bool _canEdit;

    /// <summary>One shop's fields as the form has them, for spotting unsaved changes.</summary>
    private sealed record SlipFields(string Note, string From, string GiftMessage, bool Star);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _canEdit = user.IsInRole(Roles.Admin);
        _shops = (await Shops.ListAsync(includeInactive: false)).ToList();
        var ids = _shops.Select(s => s.Id).ToList();
        var notes = await Print.GetNotesAsync(ids);
        var from = await Print.GetFromAddressesAsync(ids);
        var stars = await Print.GetStarSellersAsync(ids);
        var giftMessages = await Print.GetDefaultGiftMessagesAsync(ids);
        foreach (var s in _shops)
        {
            _text[s.Id] = notes.GetValueOrDefault(s.Id);
            _from[s.Id] = from.GetValueOrDefault(s.Id);
            _star[s.Id] = stars.Contains(s.Id);
            _giftMessage[s.Id] = giftMessages[s.Id];
            var id = s.Id;
            _saved[id] = new(
                () => new(_text[id] ?? "", _from[id] ?? "", _giftMessage[id] ?? "", _star[id]),
                v => (_text[id], _from[id], _giftMessage[id], _star[id]) = (v.Note, v.From, v.GiftMessage, v.Star));
        }
    }

    private async Task SaveAsync(ShopSummary shop)
    {
        _saving.Add(shop.Id);
        try
        {
            var user = (await AuthState).User.Identity?.Name;
            var error = await Print.SetNoteAsync(shop.Id, _text[shop.Id], user)
                ?? await Print.SetFromAddressAsync(shop.Id, _from[shop.Id], user)
                ?? await Print.SetDefaultGiftMessageAsync(shop.Id, _giftMessage[shop.Id], user);
            if (error is null)
            {
                await Print.SetStarSellerAsync(shop.Id, _star[shop.Id], user);
                _giftMessage[shop.Id] = (await Print.GetDefaultGiftMessagesAsync([shop.Id]))[shop.Id];
                _saved[shop.Id].Accept();
            }
            Snackbar.Add(error ?? $"Saved the packing slip for {shop.Name}", error is null ? Severity.Success : Severity.Warning);
        }
        finally
        {
            _saving.Remove(shop.Id);
        }
    }

    /// <summary>What the address does, with the city and state it gives the gift slip.</summary>
    private static string FromHelp(int shopId, string? address) =>
        OrderPrintService.CityState(OrderPrintService.FromLines(address)) is { } cityState
            ? $"Printed under From on packing slips; \"{cityState}\" goes under the shop's name on gift slips."
            : "Printed under From on packing slips; its city and state go under the shop's name on gift slips. Empty for none.";

    private string FromHelp(int shopId) => FromHelp(shopId, _from.GetValueOrDefault(shopId));
}
