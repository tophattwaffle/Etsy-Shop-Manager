@using EtsyShopManager.Web.Modules.Editor
@implements IDisposable
@inject PendingChangesCount Pending

@* The title-bar Pending changes button: always shown to Admins, with how many listings have changes not on Etsy yet,
   and opens the Pending changes page to review and push them. *@

@if (_loaded)
{
    <a href="listings/pending" class="esm-pending-pill @(_count > 0 ? "esm-pending-pill-active" : null)"
       title="@Summary" aria-label="@Summary">
        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" Class="esm-pending-icon" />
        <span>@_count.ToString("N0")</span><span class="esm-pending-label"> pending</span>
    </a>
}

@code {
    private bool _loaded;
    private int _count;

    private string Summary => _count switch
    {
        0 => "No listings have pending changes",
        1 => "1 listing has pending changes",
        _ => $"{_count:N0} listings have pending changes",
    };

    protected override async Task OnInitializedAsync()
    {
        Pending.Changed += OnChanged;
        await Pending.EnsureLoadedAsync();
        _count = Pending.Value;
        _loaded = true;
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        _count = Pending.Value;
        StateHasChanged();
    });

    public void Dispose() => Pending.Changed -= OnChanged;
}
