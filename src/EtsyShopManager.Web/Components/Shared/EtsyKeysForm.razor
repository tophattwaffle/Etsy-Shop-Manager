@inject ISettingsStore Settings
@inject IAuditLog Audit
@inject ISnackbar Snackbar

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Etsy app keys</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        From the Etsy developer portal → Your Apps → your existing app. Both are stored encrypted
        and sent to Etsy as <code>x-api-key: keystring:shared_secret</code>.
    </MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudTextField T="string" @bind-Value="_keystring" Label="Keystring" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                          Error="@(_keystringError is not null)" ErrorText="@_keystringError" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" @bind-Value="_secret" Label="Shared secret" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                          InputType="InputType.Password"
                          Placeholder="@(_hasSecret ? "Saved — leave blank to keep" : "")"
                          HelperText="@(_hasSecret ? "A shared secret is saved. Leave blank to keep it." : null)"
                          Error="@(_secretError is not null)" ErrorText="@_secretError" />
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Class="mt-3">
        <SaveButtons Text="Save keys" Changed="Changed" Busy="_busy" OnSave="SaveAsync" OnCancel="Revert" />
    </MudStack>
</MudPaper>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string? _keystring;
    private string? _savedKeystring;
    private string? _secret;
    private bool _hasSecret;
    private bool _busy;
    private string? _keystringError;
    private string? _secretError;

    protected override async Task OnInitializedAsync()
    {
        _keystring = _savedKeystring = await Settings.GetAsync(SettingKeys.EtsyKeystring);
        _hasSecret = await Settings.HasValueAsync(SettingKeys.EtsySharedSecret);
    }

    // The saved secret is never shown, so typing one is the change; a blank secret keeps the saved one.
    private bool Changed => (_keystring ?? "") != (_savedKeystring ?? "") || !string.IsNullOrEmpty(_secret);

    private void Revert() => (_keystring, _secret, _keystringError, _secretError) = (_savedKeystring, null, null, null);

    private async Task SaveAsync()
    {
        _keystringError = string.IsNullOrWhiteSpace(_keystring) ? "Required" : null;
        _secretError = string.IsNullOrWhiteSpace(_secret) && !_hasSecret ? "Required" : null;
        if (_keystringError is not null || _secretError is not null) return;

        _busy = true;
        try
        {
            var user = (await AuthState).User.Identity?.Name;
            await Settings.SetAsync(SettingKeys.EtsyKeystring, _keystring!.Trim(), updatedBy: user);
            _keystring = _savedKeystring = _keystring.Trim();
            if (!string.IsNullOrWhiteSpace(_secret))
            {
                await Settings.SetAsync(SettingKeys.EtsySharedSecret, _secret.Trim(), encrypt: true, updatedBy: user);
                _hasSecret = true;
                _secret = null;
            }
            await Audit.WriteAsync("settings.etsy-keys", "Setting", SettingKeys.EtsyKeystring, "Etsy app keys updated", user);
            Snackbar.Add("Etsy keys saved", Severity.Success);
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
