@inherits LayoutComponentBase
@inject SetupState Setup
@inject IWebHostEnvironment Env

<MudThemeProvider Theme="_theme" IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<AuthorizeView><Authorized><JobNotifier /></Authorized></AuthorizeView>

<MudLayout Class="@(_dark ? null : "esm-light")">
    <MudAppBar Elevation="0" Dense="true" Class="esm-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="Toggle navigation"
                       OnClick="() => _drawerOpen = !_drawerOpen" />
        <a class="esm-brand" href="" aria-label="Etsy Shop Manager">
            <MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Secondary" Size="Size.Small" />
            <span class="esm-brand-full">Etsy Shop Manager</span><span class="esm-brand-short" aria-hidden="true">ESM</span>
        </a>
        <MudTooltip Text="@VersionTooltip">
            <span class="esm-version">v@(AppVersion.Display)</span>
        </MudTooltip>
        @if (Env.IsStaging())
        {
            <MudTooltip Text="A copy of the shop data for trying changes before they are merged. It cannot reach Etsy.">
                <span class="esm-staging">Staging<span class="esm-staging-branch">@StagingBranch</span></span>
            </MudTooltip>
        }
        <MudSpacer />
        <AuthorizeView><Authorized><JobsIndicator /></Authorized></AuthorizeView>
        <AuthorizeView Roles="@Roles.Admin"><Authorized><ListingChangesIndicator /></Authorized></AuthorizeView>
        <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="() => _dark = !_dark" title="@(_dark ? "Switch to light mode" : "Switch to dark mode")" />
        <AuthorizeView Roles="@Roles.Admin">
            <Authorized>
                <span class="esm-user">@context.User.Identity?.Name</span>
                <form action="account/logout" method="post" class="d-inline">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="/" />
                    <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" title="Sign out" />
                </form>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="account/login" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login">Sign in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="esm-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="esm-content">
            <AuthorizeView Roles="@Roles.Admin">
                @if (_setupIncomplete)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        First-run setup is not finished. <MudLink Href="setup/etsy">Continue setup</MudLink>
                    </MudAlert>
                }
            </AuthorizeView>
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _dark = true; // dark by default; the app-bar button switches for the session
    private bool _setupIncomplete;

    private readonly MudTheme _theme = AppTheme.Create();

    private static string VersionTooltip =>
        $"Version {AppVersion.Version}" +
        (AppVersion.Commit is null ? "" : $", commit {AppVersion.Commit}") +
        (AppVersion.BuiltAtUtc is { } built ? $", built {built.ToLocalTime():yyyy-MM-dd HH:mm}" : "");

    private static string StagingBranch => StagingCopy.Branch is { } branch ? $" · {branch}" : "";

    protected override async Task OnInitializedAsync() =>
        _setupIncomplete = !await Setup.IsSetupCompletedAsync();
}
