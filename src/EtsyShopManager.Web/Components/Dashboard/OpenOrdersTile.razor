@using System.Text.Json.Nodes
@using EtsyShopManager.Core.Jobs
@using EtsyShopManager.Web.Components.Pages.Orders
@using EtsyShopManager.Web.Modules.Orders
@using EtsyShopManager.Web.Modules.Shops
@implements IDisposable
@inject OrderQueries Queries
@inject OrderColorService Colors
@inject ShopAccentService ShopAccents
@inject ShopOrderLinkService ShopOrderLinks
@inject IJobEvents JobEvents
@inject OrderMadeService MadeItems
@inject ISnackbar Snackbar
@inject EtsyShopManager.Core.Services.ISettingsStore Settings
@inject IAddressVerificationService VerificationService
@inject IPersonalizationVerificationService PersonalizationVerification
@inject TimeProvider Time

@* Open orders, most urgent first, each opening on Etsy in its shop's browser. Variations and personalization are
   colored like the Orders page and the Home Assistant card. Each item has its Made checkbox, the same mark as on the
   Orders page; the checkboxes sit above the order's link, so ticking one doesn't open the order. *@
@if (_open is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_open.Count == 0)
{
    <MudText Class="muted">No open orders. 🎉</MudText>
}
else
{
    <div class="esm-orders esm-dash-list">
        @foreach (var o in _open)
        {
            var due = OrderDue.For(o.ShipByUtc, Time.GetUtcNow().UtcDateTime);
            var url = ShopOrderLinkService.FormatUrl(_orderLinks.GetValueOrDefault(o.ShopId), o.EtsyReceiptId);
            <div class="esm-dash-order @(due.Urgent ? "urgent" : "")" style="@($"--shop: {Accent(o.ShopId)}")">
                <a class="esm-dash-order-head esm-dash-order-link" href="@url" target="@(ShopOrderLinkService.OpensInNewTab(url) ? "_blank" : null)">
                    <span class="esm-grow">
                        <span class="esm-dash-buyer">@(o.BuyerName ?? $"#{o.EtsyReceiptId}")</span>
                        <span class="small muted">@o.Shop.Name</span>
                    </span>
                    <span class="esm-due" style="@due.Style">@due.Text</span>
                </a>
                @if (_uspsEnabled && o.IsOpen && o.HasActiveAddressAlert)
                {
                    <div class="esm-address-alert @(o.AddressCheckStatus == AddressCheckStatuses.SuggestedAddress ? "is-suggested" : "is-error")">
                        <div class="esm-address-alert-body">
                            <div>
                                <div class="esm-address-alert-msg">@o.AddressCheckAlert</div>
                                @if (!string.IsNullOrWhiteSpace(o.AddressCheckSuggested))
                                {
                                    <div class="esm-address-alert-suggested">USPS suggests: @OneLineAddress(o.AddressCheckSuggested)</div>
                                }
                                <div class="esm-address-alert-actions">
                                    @if (!string.IsNullOrWhiteSpace(o.AddressCheckSuggested))
                                    {
                                        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" OnClick="() => ApplyUspsAddressAsync(o)">Use USPS's version</MudButton>
                                    }
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => DismissAddressAlertAsync(o)">Address is fine</MudButton>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (_personalizationEnabled && o.IsOpen && o.HasActivePersonalizationAlert)
                {
                    <div class="esm-personalization-alert">
                        <div class="esm-personalization-alert-body">
                            <div>
                                <div class="esm-personalization-alert-msg">@o.PersonalizationCheckAlert</div>
                                <div class="esm-personalization-alert-actions">
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => DismissPersonalizationAlertAsync(o)">Looks fine</MudButton>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @foreach (var (i, ii) in o.Items.OrderBy(i => i.EtsyTransactionId).Select((item, index) => (item, index)))
                {
                    var (variations, personalization) = OrderDue.Split(i);
                    <div class="esm-dash-order-item @(i.UnitsMade >= i.UnitsToMake ? "is-made" : "")">
                        <div class="esm-grow">
                            <span class="esm-dash-item esm-made-text">@(i.Quantity > 1 ? $"×{i.Quantity} " : "")@OrderDue.ShortTitle(i.Title)</span>
                            @if (variations.Count > 0)
                            {
                                <span class="order-vars">
                                    @foreach (var (v, vi) in variations.Select((v, n) => (v, n)))
                                    {
                                        <ColorBox Colors="_colors" Text="@v.Value" Title="@v.Name" Seed="@($"{o.EtsyReceiptId}|{ii}.{vi}")" />
                                    }
                                </span>
                            }
                            @if (personalization is not null)
                            {
                                <ColorBox Colors="_colors" Text="@personalization" Kind="@ColorBox.Note" Seed="@($"{o.EtsyReceiptId}|{ii}.note")" />
                            }
                        </div>
                        <MadeToggle Made="@i.UnitsMade" Quantity="@i.UnitsToMake" ReadOnly="@(!_canMark)" What="@OrderDue.ShortTitle(i.Title)"
                                    MadeChanged="@(made => SetMadeAsync(i, made))" />
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // Used when a shop has no color yet (--esm-shop-fallback-N in app.css), as on the Orders page.
    private const int FallbackAccentCount = 4;

    private List<Order>? _open;
    private List<int> _shopIds = [];
    private Dictionary<int, string> _accents = [];
    private Dictionary<int, string> _orderLinks = [];
    private OrderColorEngine? _colors;
    private IDisposable? _live;
    private Timer? _timer;

    // Both Admin and User (including unsigned-in visitors) can mark items made.
    private bool _canMark;
    private bool _uspsEnabled;
    private bool _personalizationEnabled;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _canMark = true;
        _uspsEnabled = (await Settings.GetAsync(SettingKeys.UspsEnabled)) is "1" or "true";
        _personalizationEnabled = (await Settings.GetAsync(SettingKeys.PersonalizationVerificationEnabled)) is not ("0" or "false");
        _colors = new OrderColorEngine(await Colors.GetAsync());
        await LoadAsync();
        _live = JobEvents.Subscribe(c => c.JobType == PollShopOrdersJob.Type || c.JobType == VerifyAddressJob.Type || c.JobType == RecheckPersonalizationJob.Type,
            _ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }));
        MadeItems.Changed += OnMade;
        // Ship-by countdowns are relative to now.
        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private static string OneLineAddress(string multiline) =>
        string.Join(", ", multiline.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));

    private async Task ApplyUspsAddressAsync(Order o)
    {
        var user = (await AuthState).User.Identity?.Name;
        var ok = await VerificationService.ApplyUspsSuggestedAddressAsync(o.Id, user);
        if (ok)
        {
            Snackbar.Add("Applied USPS suggested address", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add("Could not apply suggested address", Severity.Error);
        }
    }

    private async Task DismissAddressAlertAsync(Order o)
    {
        var user = (await AuthState).User.Identity?.Name;
        var ok = await VerificationService.DismissAlertAsync(o.Id, user);
        if (ok)
        {
            Snackbar.Add("Address marked fine", Severity.Info);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add("Could not dismiss alert", Severity.Error);
        }
    }

    private async Task DismissPersonalizationAlertAsync(Order o)
    {
        var user = (await AuthState).User.Identity?.Name;
        var ok = await PersonalizationVerification.DismissAlertAsync(o.Id, user);
        if (ok)
        {
            Snackbar.Add("Personalization marked fine", Severity.Info);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add("Could not dismiss alert", Severity.Error);
        }
    }

    private async Task SetMadeAsync(OrderItem item, int made)
    {
        if (!_canMark) return;
        try
        {
            await MadeItems.SetMadeAsync([item], made, source: this);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't save what's made: {ex.Message}", Severity.Error);
            await LoadAsync();
        }
    }

    // Marked in another module, page or browser (this tile's own marks are already shown).
    private void OnMade(object? source)
    {
        if (ReferenceEquals(source, this)) return;
        _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    private async Task LoadAsync()
    {
        var open = await Queries.GetOpenOrdersAsync(null);
        _shopIds = open.Select(o => o.ShopId).Distinct().Order().ToList();
        _accents = await ShopAccents.GetEffectiveAsync(_shopIds);
        _orderLinks = await ShopOrderLinks.GetOverridesAsync(_shopIds);
        _open = open.OrderBy(o => o.ShipByUtc ?? DateTime.MaxValue).ToList();
    }


    private string Accent(int shopId) => _accents.TryGetValue(shopId, out var color)
        ? color
        : $"var(--esm-shop-fallback-{Math.Max(0, _shopIds.IndexOf(shopId)) % FallbackAccentCount})";

    public void Dispose()
    {
        MadeItems.Changed -= OnMade;
        _live?.Dispose();
        _timer?.Dispose();
    }
}
