@using System.Text.Json.Nodes
@using EtsyShopManager.Core.Jobs
@using EtsyShopManager.Web.Components.Pages.Orders
@using EtsyShopManager.Web.Modules.Orders
@using EtsyShopManager.Web.Modules.Shops
@implements IDisposable
@inject OrderQueries Queries
@inject OrderColorService Colors
@inject ShopAccentService ShopAccents
@inject ShopOrderLinkService ShopOrderLinks
@inject IJobEvents JobEvents
@inject OrderMadeService MadeItems
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject TimeProvider Time

@* Open orders, most urgent first, each opening on Etsy in its shop's browser. Variations and personalization are
   colored like the Orders page and the Home Assistant card. Each item has its Made checkbox, the same mark as on the
   Orders page; the checkboxes sit above the order's link, so ticking one doesn't open the order. *@
@if (_open is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_open.Count == 0)
{
    <MudText Class="muted">No open orders. 🎉</MudText>
}
else
{
    <div class="esm-orders esm-dash-list">
        @foreach (var o in _open)
        {
            var due = OrderDue.For(o.ShipByUtc, Time.GetUtcNow().UtcDateTime);
            var url = ShopOrderLinkService.FormatUrl(_orderLinks.GetValueOrDefault(o.ShopId), o.EtsyReceiptId);
            <div class="esm-dash-order @(due.Urgent ? "urgent" : "")" style="@($"--shop: {Accent(o.ShopId)}")">
                <a class="esm-dash-order-head esm-dash-order-link" href="@url" target="@(ShopOrderLinkService.OpensInNewTab(url) ? "_blank" : null)">
                    <span class="esm-grow">
                        <span class="esm-dash-buyer">@(o.BuyerName ?? $"#{o.EtsyReceiptId}")</span>
                        <span class="small muted">@o.Shop.Name</span>
                    </span>
                    <span class="esm-due" style="@due.Style">@due.Text</span>
                </a>
                @foreach (var (i, ii) in o.Items.OrderBy(i => i.EtsyTransactionId).Select((item, index) => (item, index)))
                {
                    var (variations, personalization) = OrderDue.Split(i);
                    <div class="esm-dash-order-item @(i.UnitsMade >= i.UnitsToMake ? "is-made" : "")">
                        <div class="esm-grow">
                            <span class="esm-dash-item esm-made-text">@(i.Quantity > 1 ? $"×{i.Quantity} " : "")@OrderDue.ShortTitle(i.Title)</span>
                            @if (variations.Count > 0)
                            {
                                <span class="order-vars">
                                    @foreach (var (v, vi) in variations.Select((v, n) => (v, n)))
                                    {
                                        <ColorBox Text="@v.Value" Title="@v.Name" Seed="@($"{o.EtsyReceiptId}|{ii}.{vi}")" />
                                    }
                                </span>
                            }
                            @if (personalization is not null)
                            {
                                <ColorBox Text="@personalization" Kind="@ColorBox.Note" Seed="@($"{o.EtsyReceiptId}|{ii}.note")" />
                            }
                        </div>
                        <MadeToggle Made="@i.UnitsMade" Quantity="@i.UnitsToMake" ReadOnly="@(!_canMark)" What="@OrderDue.ShortTitle(i.Title)"
                                    MadeChanged="@(made => SetMadeAsync(i, made))" />
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // Used when a shop has no color yet (--esm-shop-fallback-N in app.css), as on the Orders page.
    private const int FallbackAccentCount = 4;

    private List<Order>? _open;
    private List<int> _shopIds = [];
    private Dictionary<int, string> _accents = [];
    private Dictionary<int, string> _orderLinks = [];
    private JsonObject? _colorConfig;
    private IDisposable? _live;
    private Timer? _timer;

    // Admins and Editors mark items made; Viewers see what is made.
    private bool _canMark;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _canMark = user.IsInRole(Roles.Admin);
        _colorConfig = (await Colors.GetAsync()).ToCardJson();
        await LoadAsync();
        _live = JobEvents.Subscribe(c => c.JobType == PollShopOrdersJob.Type,
            _ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }));
        MadeItems.Changed += OnMade;
        // Ship-by countdowns are relative to now.
        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task SetMadeAsync(OrderItem item, int made)
    {
        if (!_canMark) return;
        try
        {
            await MadeItems.SetMadeAsync([item], made, source: this);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't save what's made: {ex.Message}", Severity.Error);
            await LoadAsync();
        }
    }

    // Marked in another module, page or browser (this tile's own marks are already shown).
    private void OnMade(object? source)
    {
        if (ReferenceEquals(source, this)) return;
        _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    private async Task LoadAsync()
    {
        var open = await Queries.GetOpenOrdersAsync(null);
        _shopIds = open.Select(o => o.ShopId).Distinct().Order().ToList();
        _accents = await ShopAccents.GetEffectiveAsync(_shopIds);
        _orderLinks = await ShopOrderLinks.GetOverridesAsync(_shopIds);
        _open = open.OrderBy(o => o.ShipByUtc ?? DateTime.MaxValue).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await Js.InvokeVoidAsync("esm.colorOrders", _colorConfig);

    private string Accent(int shopId) => _accents.TryGetValue(shopId, out var color)
        ? color
        : $"var(--esm-shop-fallback-{Math.Max(0, _shopIds.IndexOf(shopId)) % FallbackAccentCount})";

    public void Dispose()
    {
        MadeItems.Changed -= OnMade;
        _live?.Dispose();
        _timer?.Dispose();
    }
}
