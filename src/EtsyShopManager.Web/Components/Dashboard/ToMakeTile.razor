@using System.Text.Json.Nodes
@using EtsyShopManager.Core.Jobs
@using EtsyShopManager.Web.Components.Pages.Orders
@using EtsyShopManager.Web.Modules.Listings
@using EtsyShopManager.Web.Modules.Orders
@implements IDisposable
@inject OrderQueries Queries
@inject OrderColorService Colors
@inject IJobEvents JobEvents
@inject OrderMadeService MadeItems
@inject IJSRuntime Js

@* What is still to be made for the open orders: identical items (same listing, variations and personalization) added up,
   less what is marked made, soonest ship-by first. The same list as Orders → To make (where items are marked made). *@
@if (_rows is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_rows.Count == 0)
{
    <MudText Class="muted">Nothing to make.</MudText>
}
else
{
    <div class="esm-orders esm-dash-list">
        <div class="small muted">@_total item@(_total == 1 ? "" : "s") left to make for the open orders</div>
        @foreach (var make in _rows)
        {
            var row = make.Row;
            <div class="esm-dash-make">
                <span class="esm-dash-qty">×@make.Left</span>
                <div class="esm-grow">
                    <div>@OrderDue.ShortTitle((string?)row["title"])</div>
                    <div class="order-vars">
                        @foreach (var v in row["variations"]?.AsArray().Select(n => n!.AsObject()) ?? [])
                        {
                            if ((string?)v["value"] is { Length: > 0 } value)
                            {
                                <ColorBox Text="@value" Title="@((string?)v["property"])" Seed="@($"make|{(string?)row["listing_id"]}|{value}")" />
                            }
                        }
                    </div>
                    @if ((string?)row["personalization"] is { Length: > 0 } note)
                    {
                        <ColorBox Text="@note" Kind="@ColorBox.Note" Seed="@($"make|{note}")" />
                    }
                </div>
                @if (row["ship_by_ts"] is { } ts)
                {
                    <span class="small muted esm-dash-shipby">Ship by @ListingFormat.Local(DateTime.UnixEpoch.AddSeconds((long)ts), "ddd MMM d")</span>
                }
            </div>
        }
    </div>
}

@code {
    private List<ToMakeRow>? _rows;
    private int _total;
    private JsonObject? _colorConfig;
    private IDisposable? _live;

    protected override async Task OnInitializedAsync()
    {
        _colorConfig = (await Colors.GetAsync()).ToCardJson();
        await LoadAsync();
        _live = JobEvents.Subscribe(c => c.JobType == PollShopOrdersJob.Type,
            _ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }));
        MadeItems.Changed += OnMade;
    }

    private async Task LoadAsync()
    {
        var rows = ToMakeList.Build(await Queries.GetOpenOrdersAsync(null), TimeZoneInfo.Local);
        _rows = rows.Where(r => !r.IsMade).OrderBy(r => (long?)r.Row["ship_by_ts"] ?? long.MaxValue).ToList();
        _total = _rows.Sum(r => r.Left);
    }

    private void OnMade(object? _) => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override async Task OnAfterRenderAsync(bool firstRender) => await Js.InvokeVoidAsync("esm.colorOrders", _colorConfig);

    public void Dispose()
    {
        MadeItems.Changed -= OnMade;
        _live?.Dispose();
    }
}
