@page "/packing-slips"
@attribute [Authorize(Roles = "Admin,Editor")]
@using EtsyShopManager.Core.Domain
@using EtsyShopManager.Web.Modules.Listings
@using EtsyShopManager.Web.Modules.Orders
@using EtsyShopManager.Web.Modules.Shops
@inject ShopService Shops
@inject SlipLayoutService Layouts
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@* The Packing slips section: which layout each shop prints, each shop's note, location line and Star Seller badge, and the
   layouts themselves (Liquid templates edited on PackingSlipLayoutPage, by admins only: a layout is HTML the app prints). *@
<PageTitle>Packing slips · Etsy Shop Manager</PageTitle>

<PageHeader Title="Packing slips">
    <Summary>
        What Orders → Print packing slips prints for each shop. Every shop starts with the built-in layouts, which look
        like Etsy's own slips; copy one to make your own.
    </Summary>
    <Actions>
        @if (_isAdmin)
        {
            <MudButton Variant="Variant.Outlined" Href="packing-slips/layouts/new?kind=Gift">New gift slip layout</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="packing-slips/layouts/new?kind=Packing">New packing slip layout</MudButton>
        }
    </Actions>
</PageHeader>

@if (_shops is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" GutterBottom="true">Layout for each shop</MudText>
        @if (_shops.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="muted">Connect a shop to choose its layouts.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <SortHeader Sort="_shopSort" Column="shop" Changed="StateHasChanged">Shop</SortHeader>
                        <SortHeader Sort="_shopSort" Column="packing" Changed="StateHasChanged">Packing slip</SortHeader>
                        <SortHeader Sort="_shopSort" Column="gift" Changed="StateHasChanged">Gift slip</SortHeader>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _shopSort.Apply(_shops))
                    {
                        <tr>
                            <td>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <span class="lp-shopmark">
                                        @if (s.IconUrl is { Length: > 0 }) { <img src="@ShopIconCache.UrlFor(s.Id)" alt="" /> }
                                        else { @s.Name[..1].ToUpperInvariant() }
                                    </span>
                                    <span>@s.Name</span>
                                </MudStack>
                            </td>
                            @foreach (var kind in Enum.GetValues<SlipKind>())
                            {
                                <td>
                                    <MudSelect T="int" Value="@_assigned.GetValueOrDefault((s.Id, kind))" ValueChanged="@(id => AssignAsync(s, kind, id))"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="esm-minw-md" aria-label="@($"{s.Name} {SlipLayoutService.Describe(kind)} layout")">
                                        <MudSelectItem Value="0">@SlipLayoutService.BuiltIn(kind).Name</MudSelectItem>
                                        @foreach (var l in _layouts.Where(l => l.Kind == kind))
                                        {
                                            <MudSelectItem Value="l.Id">@l.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>

    <ShopSlipPanel />

    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" GutterBottom="true">Layouts (@(_layouts.Count + 2))</MudText>
        <MudText Typo="Typo.body2" Class="muted mb-3">
            A layout is an HTML template with placeholders such as <code>{{ order.receipt_id }}</code>, and the CSS that styles
            it. The built-in layouts can't be changed, but you can copy them. Only admins can make or edit layouts.
        </MudText>
        <MudSimpleTable Dense="true" Hover="true">
            <thead>
                <tr>
                    <SortHeader Sort="_layoutSort" Column="name" Changed="StateHasChanged">Name</SortHeader>
                    <SortHeader Sort="_layoutSort" Column="kind" Changed="StateHasChanged">For</SortHeader>
                    <SortHeader Sort="_layoutSort" Column="used" Changed="StateHasChanged">Shops using it</SortHeader>
                    <SortHeader Sort="_layoutSort" Column="updated" Changed="StateHasChanged">Updated</SortHeader>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in _layoutSort.Apply(Rows))
                {
                    <tr>
                        <td>
                            @if (l.Id == 0 || !_isAdmin) { @l.Name }
                            else { <MudLink Href="@($"packing-slips/layouts/{l.Id}")">@l.Name</MudLink> }
                        </td>
                        <td>@SlipLayoutService.Describe(l.Kind)</td>
                        <td>@UsedBy(l)</td>
                        <td>@(l.Id == 0 ? "—" : ListingFormat.Local(l.UpdatedAtUtc))</td>
                        <td class="text-right">
                            @if (_isAdmin)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"packing-slips/layouts/new?kind={l.Kind}&from={l.Id}")">Copy</MudButton>
                            }
                            @if (l.Id != 0 && _isAdmin)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"packing-slips/layouts/{l.Id}")">Edit</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteAsync(l)">Delete</MudButton>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<ShopSummary>? _shops;
    private bool _isAdmin;
    private List<SlipLayout> _layouts = [];
    private Dictionary<(int ShopId, SlipKind Kind), int> _assigned = [];

    private IEnumerable<SlipLayout> Rows =>
        [SlipLayoutService.BuiltIn(SlipKind.Packing), SlipLayoutService.BuiltIn(SlipKind.Gift), .. _layouts];

    private readonly TableSort<ShopSummary> _shopSort = new()
    {
        ["shop"] = s => s.Name,
        ["packing"] = s => s.Id, // replaced in OnInitializedAsync, once the layout names are known
        ["gift"] = s => s.Id,
    };

    private readonly TableSort<SlipLayout> _layoutSort = new()
    {
        ["name"] = l => l.Name,
        ["kind"] = l => (int)l.Kind,
        ["used"] = l => 0,
        ["updated"] = l => l.UpdatedAtUtc,
    };

    protected override async Task OnInitializedAsync()
    {
        _shopSort["packing"] = s => LayoutName(s.Id, SlipKind.Packing);
        _shopSort["gift"] = s => LayoutName(s.Id, SlipKind.Gift);
        _isAdmin = (await AuthState).User.IsInRole(Roles.Admin);
        _layoutSort["used"] = l => _shops?.Count(s => _assigned.GetValueOrDefault((s.Id, l.Kind)) == l.Id) ?? 0;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _shops = await Shops.ListAsync(includeInactive: false);
        _layouts = await Layouts.ListAsync();
        _assigned = await Layouts.GetAssignmentsAsync(_shops.Select(s => s.Id));
    }

    private string LayoutName(int shopId, SlipKind kind) =>
        _assigned.GetValueOrDefault((shopId, kind)) is var id and not 0 && _layouts.FirstOrDefault(l => l.Id == id) is { } l
            ? l.Name
            : SlipLayoutService.BuiltIn(kind).Name;

    private string UsedBy(SlipLayout layout)
    {
        var names = _shops?.Where(s => _assigned.GetValueOrDefault((s.Id, layout.Kind)) == layout.Id).Select(s => s.Name).ToList() ?? [];
        return names.Count == 0 ? "—" : string.Join(", ", names);
    }

    private async Task AssignAsync(ShopSummary shop, SlipKind kind, int layoutId)
    {
        var error = await Layouts.AssignAsync(shop.Id, kind, layoutId, (await AuthState).User.Identity?.Name);
        if (error is null) _assigned[(shop.Id, kind)] = layoutId;
        Snackbar.Add(error ?? $"{shop.Name} now prints {LayoutName(shop.Id, kind)}", error is null ? Severity.Success : Severity.Warning);
    }

    private async Task DeleteAsync(SlipLayout layout)
    {
        var users = UsedBy(layout);
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete layout",
            users == "—" ? $"Delete {layout.Name}? This can't be undone."
                : $"Delete {layout.Name}? {users} will print the built-in {SlipLayoutService.Describe(layout.Kind)} instead. This can't be undone.",
            yesText: "Delete layout", cancelText: "Cancel");
        if (confirmed != true) return;
        await Layouts.DeleteAsync(layout.Id, _shops?.Select(s => s.Id) ?? [], (await AuthState).User.Identity?.Name);
        await ReloadAsync();
        Snackbar.Add($"Deleted {layout.Name}", Severity.Success);
    }
}
