@page "/jobs"
@attribute [Authorize(Roles = Roles.Admin)]
@using EtsyShopManager.Core.Jobs
@using EtsyShopManager.Web.Infrastructure.Jobs
@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJobQueue Queue
@inject IEnumerable<RecurringJobDefinition> RecurringDefinitions
@inject ISnackbar Snackbar
@inject ISettingsStore Settings
@inject IJobEvents JobEvents
@inject JobCatalog Catalog

<PageTitle>Jobs · Etsy Shop Manager</PageTitle>

<PageHeader Title="Background jobs" />

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Recurring</MudText>
    <MudSimpleTable Dense="true">
        <thead>
            <tr><th>Name</th><th>Job type</th><th>Every</th><th>Last queued</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var def in RecurringDefinitions.OrderBy(d => d.Name))
            {
                _recurringState.TryGetValue(def.Name, out var last);
                <tr>
                    <td>@def.Name</td>
                    <td><code>@def.JobType</code></td>
                    <td>@(_intervals.GetValueOrDefault(def.Name, def.Interval))@(def.IntervalSettingKey is null ? "" : " (setting)")</td>
                    <td>@Local(last)</td>
                    <td class="text-right">
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => RunNowAsync(def)">Run now</MudButton>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudText Typo="Typo.h6">Queue</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudSelect T="string" Value="_filter" ValueChanged="OnFilterChanged" Label="Status" Dense="true" Variant="Variant.Outlined" Class="esm-minw-sm">
                <MudSelectItem T="string" Value="@("all")">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("active")">Pending + running</MudSelectItem>
                <MudSelectItem T="string" Value="@("failed")">Failed</MudSelectItem>
                <MudSelectItem T="string" Value="@("succeeded")">Succeeded</MudSelectItem>
            </MudSelect>
            <MudSwitch T="bool" @bind-Value="_autoRefresh" Label="Live updates" Color="Color.Primary" />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" title="Refresh" />
        </MudStack>
    </MudStack>

    <MudSimpleTable Dense="true" Hover="true" Class="job-table">
        <thead>
            <tr>
                <th class="esm-col-icon"></th><th>#</th><th>Job</th><th>Status</th><th>Shop</th><th>Attempts</th>
                <th>Created</th><th>Finished</th><th>Result / error</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stack in _stacks)
            {
                var expanded = stack.Count == 1 || _expanded.Contains(stack.Key);
                @if (stack.Count > 1)
                {
                    <tr class="job-stack" @onclick="() => Toggle(stack.Key)">
                        <td><MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" /></td>
                        <td class="muted">@stack.Jobs[^1].Id–@stack.Latest.Id</td>
                        <td>@Catalog.DisplayName(stack.JobType) <span class="muted small">×@stack.Count</span><br /><code class="small">@stack.JobType</code></td>
                        <td>@StatusChips(stack)</td>
                        <td>@string.Join(", ", stack.Jobs.Select(j => ShopName(j.ShopId)).Distinct())</td>
                        <td></td>
                        <td>@Local(stack.Jobs[^1].CreatedAtUtc) – @Local(stack.Latest.CreatedAtUtc)</td>
                        <td>@Local(stack.Latest.CompletedAtUtc)</td>
                        <td class="small">@stack.Latest.Result</td>
                        <td></td>
                    </tr>
                }
                @if (expanded)
                {
                    foreach (var j in stack.Jobs)
                    {
                        <tr class="@(stack.Count > 1 ? "job-child" : "")">
                            <td></td>
                            <td>@j.Id</td>
                            <td>@Catalog.DisplayName(j.JobType)<br /><code class="small">@j.JobType</code></td>
                            <td><MudChip T="string" Size="Size.Small" Color="@StatusColor(j.Status)">@j.Status</MudChip></td>
                            <td>@ShopName(j.ShopId)</td>
                            <td>@j.Attempts / @j.MaxAttempts</td>
                            <td>@Local(j.CreatedAtUtc)@(j.CreatedBy is null ? "" : $" · {j.CreatedBy}")</td>
                            <td>@(j.Status == JobStatus.Pending ? $"runs {Local(j.RunAfterUtc)}" : Local(j.CompletedAtUtc))</td>
                            <td>
                                @if (!string.IsNullOrEmpty(j.LastError) && j.Status != JobStatus.Succeeded)
                                {
                                    <div class="error-cell" title="@j.LastError">@FirstLine(j.LastError)</div>
                                }
                                else
                                {
                                    <span class="small">@j.Result</span>
                                }
                            </td>
                            <td class="text-right">
                                @if (j.Status is JobStatus.Failed or JobStatus.Cancelled)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => RetryAsync(j.Id)">Retry</MudButton>
                                }
                                else if (j.Status == JobStatus.Pending)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => CancelAsync(j.Id)">Cancel</MudButton>
                                }
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </MudSimpleTable>
    @if (_jobs.Count == 0)
    {
        <MudText Class="mt-2">No jobs.</MudText>
    }
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<Job> _jobs = [];
    private List<JobStack> _stacks = [];
    private readonly HashSet<long> _expanded = [];
    private Dictionary<int, string> _shops = [];
    private IDisposable? _live;
    private Dictionary<string, DateTime?> _recurringState = [];
    private Dictionary<string, TimeSpan> _intervals = [];
    private string _filter = "all";
    private bool _autoRefresh = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // Re-render when any job is queued, starts, finishes or is retried (bursts are coalesced).
        _live = JobEvents.Subscribe(_ => _autoRefresh, _ => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }));
    }

    private void Toggle(long key)
    {
        if (!_expanded.Remove(key)) _expanded.Add(key);
    }

    private string ShopName(int? shopId) => shopId is { } id ? _shops.GetValueOrDefault(id, $"#{id}") : "—";

    private RenderFragment StatusChips(JobStack stack) => builder =>
    {
        var seq = 0;
        foreach (var group in stack.Jobs.GroupBy(j => j.Status).OrderBy(g => g.Key))
        {
            builder.OpenComponent<MudChip<string>>(seq++);
            builder.AddAttribute(seq++, "Size", Size.Small);
            builder.AddAttribute(seq++, "Color", StatusColor(group.Key));
            builder.AddAttribute(seq++, "ChildContent", (RenderFragment)(b => b.AddContent(0, $"{group.Key} {group.Count()}")));
            builder.CloseComponent();
        }
    };

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        IQueryable<Job> q = db.Jobs.AsNoTracking();
        q = _filter switch
        {
            "active" => q.Where(j => j.Status == JobStatus.Pending || j.Status == JobStatus.Running),
            "failed" => q.Where(j => j.Status == JobStatus.Failed),
            "succeeded" => q.Where(j => j.Status == JobStatus.Succeeded),
            _ => q,
        };
        _jobs = await q.OrderByDescending(j => j.Id).Take(500).ToListAsync();
        _stacks = JobStacks.Group(_jobs);
        _shops = await db.Shops.AsNoTracking().ToDictionaryAsync(x => x.Id, x => x.Name);
        _recurringState = await db.RecurringJobs.AsNoTracking().ToDictionaryAsync(r => r.Name, r => r.LastEnqueuedAtUtc);
        foreach (var def in RecurringDefinitions)
            _intervals[def.Name] = await RecurringJobScheduler.GetIntervalAsync(def, Settings);
    }

    private async Task OnFilterChanged(string value)
    {
        _filter = value;
        await LoadAsync();
    }

    private async Task RunNowAsync(RecurringJobDefinition def)
    {
        var user = (await AuthState).User.Identity?.Name;
        var id = await RecurringJobScheduler.RunNowAsync(Queue, def, user);
        Snackbar.Add(id is null ? $"{def.Name} is already queued" : $"{def.Name} queued (job {id})", Severity.Info);
        await LoadAsync();
    }

    private async Task RetryAsync(long id)
    {
        if (await Queue.RetryAsync(id)) Snackbar.Add($"Job {id} re-queued", Severity.Info);
        await LoadAsync();
    }

    private async Task CancelAsync(long id)
    {
        if (await Queue.CancelAsync(id)) Snackbar.Add($"Job {id} cancelled", Severity.Info);
        await LoadAsync();
    }

    private static Color StatusColor(JobStatus s) => s switch
    {
        JobStatus.Succeeded => Color.Success,
        JobStatus.Failed => Color.Error,
        JobStatus.Running => Color.Info,
        JobStatus.Pending => Color.Warning,
        _ => Color.Default,
    };

    private static string Local(DateTime? utc) =>
        utc is null ? "—" : utc.Value.ToLocalTime().ToString("MM-dd HH:mm:ss");

    private static string FirstLine(string? s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        var line = s.Split('\n')[0].TrimEnd();
        return line.Length > 120 ? line[..120] + "…" : line;
    }

    public void Dispose() => _live?.Dispose();
}
