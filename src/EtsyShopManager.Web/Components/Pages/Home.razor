@page "/"
@attribute [Authorize]
@using System.Security.Claims
@using EtsyShopManager.Web.Modules.Dashboard
@inject DashboardLayoutService Layouts
@inject ISnackbar Snackbar

<PageTitle>Dashboard · Etsy Shop Manager</PageTitle>

@* A grid of modules each user arranges for themselves: in edit mode modules can be dragged (or moved with the arrow
   buttons), resized down to their minimum size, removed and added. Layouts are saved per user. *@
<PageHeader Title="Dashboard">
    <Actions>
        @if (_editing)
        {
            <MudMenu Label="Add module" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Disabled="@(Available.Count == 0)"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                @foreach (var kind in Available)
                {
                    <MudMenuItem OnClick="() => Add(kind)">@kind.Title</MudMenuItem>
                }
            </MudMenu>
            <MudButton Variant="Variant.Text" OnClick="ResetAsync">Reset to default</MudButton>
            <MudButton Variant="Variant.Text" OnClick="CancelAsync">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save layout</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DashboardCustomize" OnClick="Edit">Edit layout</MudButton>
        }
    </Actions>
</PageHeader>

@if (_items is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <div class="lp-empty">
        <p>Your dashboard is empty.</p>
        <button type="button" class="esm-button" @onclick="Edit">Add modules</button>
    </div>
}
else
{
    <div class="esm-dash @(_editing ? "is-editing" : "")">
        @for (var index = 0; index < _items.Count; index++)
        {
            var i = index;
            var item = _items[i];
            var kind = DashboardModules.Find(item.Module)!;
            <section class="esm-dash-module @(_dragFrom == i ? "is-dragging" : "") @(_dragOver == i && _dragFrom != i ? "is-drop-target" : "")"
                     style="@($"--w: {item.Width}; --h: {item.Height}")" aria-label="@kind.Title"
                     draggable="@(_editing ? "true" : "false")"
                     @ondragstart="() => _dragFrom = i" @ondragend="() => { _dragFrom = null; _dragOver = null; }"
                     @ondragenter="() => _dragOver = i" @ondragover:preventDefault="_editing" @ondrop="() => Drop(i)">
                <header class="esm-dash-head">
                    @if (_editing)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Class="esm-dash-grip" aria-hidden="true" />
                    }
                    <h2 class="esm-dash-title">@kind.Title</h2>
                    @if (_editing)
                    {
                        <div class="esm-dash-tools">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" aria-label="@($"Move {kind.Title} earlier")"
                                           title="Move earlier" Disabled="@(i == 0)" OnClick="() => Move(i, -1)" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" aria-label="@($"Move {kind.Title} later")"
                                           title="Move later" Disabled="@(i == _items.Count - 1)" OnClick="() => Move(i, 1)" />
                            <span class="esm-dash-size" title="Width">
                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" aria-label="@($"Make {kind.Title} narrower")"
                                               Disabled="@(item.Width <= kind.MinWidth)" OnClick="() => Resize(i, -1, 0)" />
                                <span class="small">W @item.Width</span>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-label="@($"Make {kind.Title} wider")"
                                               Disabled="@(item.Width >= DashboardModules.Columns)" OnClick="() => Resize(i, 1, 0)" />
                            </span>
                            <span class="esm-dash-size" title="Height">
                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" aria-label="@($"Make {kind.Title} shorter")"
                                               Disabled="@(item.Height <= kind.MinHeight)" OnClick="() => Resize(i, 0, -1)" />
                                <span class="small">H @item.Height</span>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" aria-label="@($"Make {kind.Title} taller")"
                                               Disabled="@(item.Height >= DashboardModules.MaxHeight)" OnClick="() => Resize(i, 0, 1)" />
                            </span>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@($"Remove {kind.Title}")"
                                           title="Remove" OnClick="() => Remove(i)" />
                        </div>
                    }
                </header>
                <div class="esm-dash-body">
                    <DynamicComponent Type="kind.Component" />
                </div>
            </section>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string _userId = "";
    private List<DashboardItem>? _items;
    private bool _editing;
    private int? _dragFrom;
    private int? _dragOver;

    private List<DashboardModuleKind> Available =>
        DashboardModules.All.Where(k => _items?.Any(i => i.Module == k.Id) != true).ToList();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _userId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? user.Identity?.Name ?? "";
        _items = await Layouts.GetAsync(_userId);
    }

    private void Edit() => _editing = true;

    private void Move(int index, int by)
    {
        var to = Math.Clamp(index + by, 0, _items!.Count - 1);
        var item = _items[index];
        _items.RemoveAt(index);
        _items.Insert(to, item);
    }

    // Dropping a module on another puts it in that module's place.
    private void Drop(int target)
    {
        if (_dragFrom is { } from && from != target) Move(from, target - from);
        _dragFrom = null;
        _dragOver = null;
    }

    private void Resize(int index, int width, int height)
    {
        var item = _items![index];
        _items[index] = DashboardModules.Normalize([item with { Width = item.Width + width, Height = item.Height + height }])[0];
    }

    private void Remove(int index) => _items!.RemoveAt(index);

    private void Add(DashboardModuleKind kind) => _items!.Add(new DashboardItem(kind.Id, kind.Width, kind.Height));

    private async Task SaveAsync()
    {
        await Layouts.SaveAsync(_userId, _items!);
        _items = await Layouts.GetAsync(_userId);
        _editing = false;
        Snackbar.Add("Saved your dashboard layout", Severity.Success);
    }

    private async Task CancelAsync()
    {
        _items = await Layouts.GetAsync(_userId);
        _editing = false;
    }

    private async Task ResetAsync()
    {
        await Layouts.ResetAsync(_userId);
        _items = await Layouts.GetAsync(_userId);
        _editing = false;
        Snackbar.Add("Dashboard set back to the default layout", Severity.Info);
    }
}
