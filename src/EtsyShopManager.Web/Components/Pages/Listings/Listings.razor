@page "/listings"
@using EtsyShopManager.Web.Modules.Listings
@using EtsyShopManager.Core.Jobs
@using EtsyShopManager.Web.Modules.Stock
@using EtsyShopManager.Web.Modules.Editor
@implements IDisposable
@inject ListingQueries Queries
@inject ListingImportQueue ImportQueue
@inject ISnackbar Snackbar
@inject IJobEvents JobEvents
@inject IJSRuntime Js
@inject TimeProvider Time
@inject StockRefiller Refiller
@inject IDialogService Dialogs
@inject EtsyShopManager.Web.Modules.Shops.ShopAccentService ShopAccents
@inject PendingChangesService PendingChanges

<PageTitle>Listings · Etsy Shop Manager</PageTitle>

<div class="listings-page">
    <PageHeader Title="Listings">
        <Summary>
            @if (_facets is not null && _shops is { Count: > 0 })
            {
                @($"{_facets.OnEtsy:N0} on Etsy across {_shops.Count} shop{(_shops.Count == 1 ? "" : "s")}")
            }
        </Summary>
        <Actions>
            @if (_pending > 0)
            {
                <AuthorizeView Roles="@Roles.Admin" Context="auth">
                    <MudButton Variant="Variant.Outlined" Href="listings/pending" StartIcon="@Icons.Material.Filled.CloudUpload">
                        @($"{_pending:N0} listing{(_pending == 1 ? " has" : "s have")} pending changes")
                    </MudButton>
                </AuthorizeView>
            }
            <AuthorizeView Roles="@Roles.Admin" Context="auth">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="listings/new" StartIcon="@Icons.Material.Filled.Add">
                    New listing
                </MudButton>
            </AuthorizeView>
        </Actions>
    </PageHeader>

    <div class="lp-layout @(_railCollapsed ? "is-rail-collapsed" : "")">
        <section class="lp-main" aria-label="Listings">
            <div class="lp-toolbar">
                <MudTextField T="string" Value="_text" ValueChanged="OnTextChanged" Placeholder="Search by title, SKU, tag or listing id"
                              Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="lp-search" aria-label="Search listings" />
                <MudSelect T="ListingSort" Value="_sort" ValueChanged="OnSortChanged" Variant="Variant.Outlined" Margin="Margin.Dense"
                           ToStringFunc="@(s => SortLabel(s))" Class="lp-sort" aria-label="Sort listings">
                    @foreach (var option in MenuSorts.Contains(_sort) ? MenuSorts : [.. MenuSorts, _sort])
                    {
                        <MudSelectItem T="ListingSort" Value="option">@SortLabel(option)</MudSelectItem>
                    }
                </MudSelect>
                <div class="lp-viewtoggle" role="group" aria-label="View">
                    <button type="button" aria-pressed="@(_view == GridView ? "true" : "false")" title="Gallery view"
                            @onclick="() => SetViewAsync(GridView)">
                        <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                    </button>
                    <button type="button" aria-pressed="@(_view == ListView ? "true" : "false")" title="List view"
                            @onclick="() => SetViewAsync(ListView)">
                        <MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small" />
                    </button>
                </div>
                <AuthorizeView Roles="@Roles.Admin" Context="auth">
                    <MudButton Variant="@(_selecting ? Variant.Filled : Variant.Outlined)" Color="@(_selecting ? Color.Primary : Color.Default)"
                               Size="Size.Small" OnClick="ToggleSelecting" aria-pressed="@(_selecting ? "true" : "false")">
                        @(_selecting ? "Done" : "Bulk edit")
                    </MudButton>
                </AuthorizeView>
            </div>

            @if (_selecting)
            {
                <MudPaper Class="lp-bulk pa-4 mb-4" Elevation="0" Outlined="true">
                    <div class="lp-bulk-head">
                        <MudText Typo="Typo.h6">Bulk edit selected listings</MudText>
                        <span class="lp-muted">
                            @_selected.Count.ToString("N0") selected
                            @if (_total > 0 && _selected.Count < _total)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="SelectAllMatchingAsync">Select all @_total.ToString("N0") matching</MudButton>
                            }
                            @if (_selected.Count > 0)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _selected.Clear()">Clear selection</MudButton>
                            }
                        </span>
                    </div>
                    <div class="lp-bulk-fields mb-3">
                        <MudSelect T="BulkEditKind?" @bind-Value="_bulkKind" Label="What to change" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   ToStringFunc="@(k => BulkKindLabel(k))" Class="lp-bulk-kind">
                            @foreach (var kind in BulkKinds)
                            {
                                <MudSelectItem T="BulkEditKind?" Value="kind">@BulkKindLabel(kind)</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    @if (_bulkKind is { } bulkKind)
                    {
                        <BulkEditPanel Kind="bulkKind" ListingIds="_selected" Saved="LoadAsync" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="muted mb-3">
                            Leave a setting on "No change" or empty to keep each listing's own value. Only the settings are saved;
                            refills happen at the next stock check (after an order, or within the hour).
                        </MudText>
                        <div class="lp-bulk-fields">
                            <MudSelect T="bool?" @bind-Value="_bulkEnabled" Label="Auto-refill" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem T="bool?" Value="@((bool?)null)">No change</MudSelectItem>
                                <MudSelectItem T="bool?" Value="@((bool?)true)">On</MudSelectItem>
                                <MudSelectItem T="bool?" Value="@((bool?)false)">Off</MudSelectItem>
                            </MudSelect>
                            <MudNumericField T="int?" @bind-Value="_bulkThreshold" Label="Refill when below" Placeholder="No change"
                                             Min="1" Max="998" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField T="int?" @bind-Value="_bulkRefillTo" Label="Refill to" Placeholder="No change"
                                             Min="2" Max="@StockRefiller.MaxQuantity" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_selected.Count == 0 || _applying)"
                                       OnClick="ApplyBulkAsync">
                                Apply to @_selected.Count.ToString("N0") listing@(_selected.Count == 1 ? "" : "s")
                            </MudButton>
                        </div>
                        @if (_bulkError is not null)
                        {
                            <MudText Typo="Typo.body2" Class="error-text mt-2">@_bulkError</MudText>
                        }
                    }
                </MudPaper>
            }

            @if (_rows is null)
            {
                <MudProgressLinear Indeterminate="true" Class="my-6" />
            }
            else if (_rows.Count == 0)
            {
                <div class="lp-empty">
                    @if (_shops is { Count: 0 })
                    {
                        <p>Connect an Etsy shop to import its listings.</p>
                        <a class="esm-button" href="shops">Connect a shop</a>
                    }
                    else if (IsFiltered)
                    {
                        <p>No listings match these filters.</p>
                        <button type="button" class="esm-button esm-button-secondary" @onclick="ClearFiltersAsync">Clear filters</button>
                    }
                    else
                    {
                        <p>No listings yet. Import a shop from the panel on the right.</p>
                    }
                </div>
            }
            else if (_view == GridView && !_selecting)
            {
                <div class="lp-grid @(_loading ? "is-loading" : "")">
                    @foreach (var row in _rows)
                    {
                        <a class="lp-card" href="@($"listings/{row.Id}")" style="@ShopStyle(row.ShopId)">
                            <div class="lp-photo">
                                @if (ImageStore.UrlFor(row.ThumbFileName) is { } thumb)
                                {
                                    <img src="@thumb" alt="" loading="lazy" />
                                }
                                <ShopMark Shop="ShopFor(row.ShopId)" Name="@row.ShopName" />
                                @if (StateBadge(row) is { } badge)
                                {
                                    <span class="lp-badge lp-badge-@badge.Kind">@badge.Label</span>
                                }
                            </div>
                            <div class="lp-card-body">
                                <span class="lp-title">@row.Title</span>
                                <span class="lp-card-meta">
                                    <span class="lp-stock">@StockLabel(row.Quantity)</span>
                                    <span class="lp-price">@ListingFormat.PriceWithSymbol(row.PriceAmount, row.PriceDivisor, row.CurrencyCode)</span>
                                </span>
                                @if (row.Refill is { Enabled: true } refill)
                                {
                                    <span class="lp-refill" title="@($"Auto-refill is on: when stock drops below {refill.Threshold}, it's set back to {refill.RefillTo}")">
                                        <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" aria-hidden="true" />
                                        Auto-refill below @refill.Threshold → @refill.RefillTo
                                    </span>
                                }
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="lp-list-wrap">
                    <table class="lp-list @(_loading ? "is-loading" : "")">
                        <thead>
                            <tr>
                                @if (_selecting)
                                {
                                    <th scope="col" class="lp-list-check">
                                        <MudCheckBox T="bool" Value="@PageSelected" ValueChanged="SelectPage" Size="Size.Small" Dense="true"
                                                     aria-label="Select all listings on this page" />
                                    </th>
                                }
                                <th scope="col"><span class="visually-hidden">Photo</span></th>
                                <SortHeader Sort="_columnSort" Column="title" Changed="OnColumnSortAsync">Listing</SortHeader>
                                <SortHeader Sort="_columnSort" Column="status" Changed="OnColumnSortAsync">Status</SortHeader>
                                <SortHeader Sort="_columnSort" Column="stock" Changed="OnColumnSortAsync" Class="num">Stock</SortHeader>
                                <SortHeader Sort="_columnSort" Column="price" Changed="OnColumnSortAsync" Class="num">Price</SortHeader>
                                <SortHeader Sort="_columnSort" Column="sku" Changed="OnColumnSortAsync">SKU</SortHeader>
                                <SortHeader Sort="_columnSort" Column="refill" Changed="OnColumnSortAsync">Auto-refill</SortHeader>
                                <SortHeader Sort="_columnSort" Column="updated" Changed="OnColumnSortAsync">Updated on Etsy</SortHeader>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _rows)
                            {
                                @* While selecting, a click anywhere on the row (title included) ticks it instead of opening the listing. *@
                                <tr style="@ShopStyle(row.ShopId)" class="@RowClass(row.Id)"
                                    @onclick="@(() => { if (_selecting) Select(row.Id, !_selected.Contains(row.Id)); })">
                                    @if (_selecting)
                                    {
                                        <td class="lp-list-check" @onclick:stopPropagation="true">
                                            <MudCheckBox T="bool" Value="@_selected.Contains(row.Id)" ValueChanged="@(v => Select(row.Id, v))"
                                                         Size="Size.Small" Dense="true" aria-label="@($"Select {row.Title}")" />
                                        </td>
                                    }
                                    <td class="lp-list-photo">
                                        @if (ImageStore.UrlFor(row.ThumbFileName) is { } thumb)
                                        {
                                            <img src="@thumb" alt="" loading="lazy" />
                                        }
                                    </td>
                                    <td>
                                        @if (_selecting)
                                        {
                                            <span class="lp-list-title">@row.Title</span>
                                        }
                                        else
                                        {
                                            <a class="lp-list-title" href="@($"listings/{row.Id}")">@row.Title</a>
                                        }
                                        <span class="lp-list-sub">
                                            <ShopMark Shop="ShopFor(row.ShopId)" Name="@row.ShopName" Small="true" Decorative="true" />
                                            @row.ShopName, #@row.EtsyListingId@(row.VariationCount > 1 ? $", {row.VariationCount} variations" : "")
                                        </span>
                                    </td>
                                    <td>
                                        @if (StateBadge(row) is { } badge)
                                        {
                                            <span class="lp-badge lp-badge-@badge.Kind">@badge.Label</span>
                                        }
                                        else
                                        {
                                            <span class="lp-badge lp-badge-active">Active</span>
                                        }
                                    </td>
                                    <td class="num">@row.Quantity</td>
                                    <td class="num">@ListingFormat.PriceWithSymbol(row.PriceAmount, row.PriceDivisor, row.CurrencyCode)</td>
                                    <td class="lp-sku">@string.Join(", ", row.Skus.Take(2))@(row.Skus.Count > 2 ? $" +{row.Skus.Count - 2}" : "")</td>
                                    <td class="lp-muted">@RefillLabel(row.Refill)</td>
                                    <td class="lp-muted">@ListingFormat.Ago(row.EtsyUpdatedAtUtc, Now)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (_rows is { Count: > 0 })
            {
                <div class="lp-pager">
                    <span class="lp-muted">@(_page * PageSize + 1)–@(_page * PageSize + _rows.Count) of @_total.ToString("N0")</span>
                    @if (PageCount > 1)
                    {
                        <MudPagination Count="PageCount" Selected="_page + 1" SelectedChanged="OnPageChanged" Size="Size.Small" />
                    }
                </div>
            }
        </section>

        <aside class="lp-rail" aria-label="Filters">
            <RailToggle Collapsed="_railCollapsed" CollapsedChanged="@(c => _railCollapsed = c)" />
            <fieldset class="lp-facets">
                <legend>Shop</legend>
                <button type="button" class="lp-facet" aria-pressed="@(_shopId is null ? "true" : "false")" @onclick="() => OnShopChanged(null)">
                    <span class="lp-facet-label">All shops</span>
                    <span class="lp-count">@(_facets?.ByShop.Values.Sum().ToString("N0"))</span>
                </button>
                @foreach (var s in _shops ?? [])
                {
                    <div class="lp-shop" style="@ShopStyle(s.ShopId)">
                        <button type="button" class="lp-facet" aria-pressed="@(_shopId == s.ShopId ? "true" : "false")"
                                @onclick="() => OnShopChanged(s.ShopId)">
                            <ShopMark Shop="s" Name="@s.ShopName" Small="true" Decorative="true" />
                            <span class="lp-facet-label">@s.ShopName</span>
                            <span class="lp-count">@(_facets?.ByShop.GetValueOrDefault(s.ShopId).ToString("N0"))</span>
                        </button>
                        <div class="lp-shop-status">
                            <ImportStatusLine Shop="s" Now="Now" />
                            <AuthorizeView Roles="@Roles.Admin" Context="auth">
                                <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Dense="true"
                                         AriaLabel="@($"Import options for {s.ShopName}")" Disabled="!s.IsHealthy">
                                    <MudMenuItem OnClick="() => ImportAsync(s, force: false)">Import now</MudMenuItem>
                                    <MudMenuItem OnClick="() => ImportAsync(s, force: true)">Full re-import (re-reads attributes)</MudMenuItem>
                                </MudMenu>
                            </AuthorizeView>
                        </div>
                    </div>
                }
            </fieldset>

            <fieldset class="lp-facets">
                <legend>Listing status</legend>
                @foreach (var (key, label) in Statuses)
                {
                    var count = StatusCount(key);
                    if (key == MissingStatus && count == 0 && _status != MissingStatus) continue;
                    <button type="button" class="lp-facet" aria-pressed="@(_status == key ? "true" : "false")" @onclick="() => OnStatusChanged(key)">
                        <span class="lp-facet-label">@label</span>
                        <span class="lp-count">@count?.ToString("N0")</span>
                    </button>
                }
            </fieldset>
        </aside>
    </div>
</div>

@code {
    private const string GridView = "grid";
    private const string ListView = "list";
    private const string AllStatus = "all";
    private const string MissingStatus = "missing";
    private const int PageSize = 48;

    private static readonly (string Key, string Label)[] Statuses =
    [
        (AllStatus, "All"),
        ("active", "Active"),
        ("draft", "Draft"),
        ("expired", "Expired"),
        ("sold_out", "Sold out"),
        ("inactive", "Inactive"),
        (MissingStatus, "Gone from Etsy"),
    ];

    // Used when a shop has no profile image, or its colour can't be read (--esm-shop-fallback-N in app.css).
    private const int FallbackAccentCount = 4;

    private static readonly HashSet<string> ListingJobTypes =
    [
        ImportShopListingsJob.Type, DownloadListingImagesJob.Type, ImportShopLookupsJob.Type, RefillListingJob.Type, EtsyShopManager.Web.Modules.Editor.PushListingJob.Type,
        EtsyShopManager.Web.Modules.Editor.ListingCloneJob.Type,
        EtsyShopManager.Web.Modules.Shops.ShopRefreshJob.Type, EtsyShopManager.Web.Modules.Shops.TokenKeepAliveJob.Type,
    ];

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<ShopImportStatus>? _shops;
    private readonly Dictionary<int, string> _accents = [];
    private bool _accentsRequested;
    private List<ListingRow>? _rows;
    private ListingFacets? _facets;
    private int _pending; // listings with changes not on Etsy yet (the Pending changes page)
    private int _total;
    private int _page;
    private bool _loading;
    private string _view = GridView;

    // Desktop only: the filter panel folded to a strip (remembered per browser, see RailToggle).
    private bool _railCollapsed;
    private string? _text;
    private int? _shopId;
    private string _status = "active";
    private ListingSort _sort = ListingSort.UpdatedDesc;
    private IDisposable? _live;
    private CancellationTokenSource? _loadCts;

    // Bulk edit: selection survives paging and filter changes, so listings can be picked across pages.
    private bool _selecting;
    private readonly HashSet<int> _selected = [];
    private BulkEditKind? _bulkKind; // null: auto-refill
    private static readonly BulkEditKind?[] BulkKinds =
    [
        null, BulkEditKind.Price, BulkEditKind.AddTags, BulkEditKind.RemoveTags, BulkEditKind.AddMaterials, BulkEditKind.RemoveMaterials,
        BulkEditKind.ShippingProfile, BulkEditKind.Section,
    ];
    private bool? _bulkEnabled;
    private int? _bulkThreshold;
    private int? _bulkRefillTo;
    private string? _bulkError;
    private bool _applying;

    private DateTime Now => Time.GetUtcNow().UtcDateTime;
    private int PageCount => Math.Max(1, (_total + PageSize - 1) / PageSize);
    private bool IsFiltered => !string.IsNullOrWhiteSpace(_text) || _shopId is not null || _status != AllStatus;

    protected override async Task OnInitializedAsync()
    {
        SyncColumnSort();
        _shops = await Queries.GetImportStatusAsync();
        // Colors picked on the Shops page; the others are read from each shop's profile image after render.
        foreach (var (id, color) in await ShopAccents.GetOverridesAsync(_shops.Select(s => s.ShopId))) _accents[id] = color;
        await LoadAsync();
        // Import status follows the job queue; the list itself changes when an import or photo download finishes.
        _live = JobEvents.Subscribe(c => ListingJobTypes.Contains(c.JobType), changes => InvokeAsync(async () =>
        {
            _shops = await Queries.GetImportStatusAsync();
            if (changes.Any(c => c.IsFinal && c.JobType is ImportShopListingsJob.Type or DownloadListingImagesJob.Type
                    or RefillListingJob.Type or EtsyShopManager.Web.Modules.Editor.PushListingJob.Type
                    or EtsyShopManager.Web.Modules.Editor.ListingCloneJob.Type))
                await LoadAsync();
            StateHasChanged();
        }));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (await RailToggle.LoadAsync(Js))
            {
                _railCollapsed = true;
                StateHasChanged();
            }
            var view = await Js.InvokeAsync<string?>("esm.getPref", "listingsView");
            if (view is GridView or ListView && view != _view)
            {
                _view = view;
                StateHasChanged();
            }
        }

        if (_shops is not null && !_accentsRequested)
        {
            _accentsRequested = true;
            foreach (var s in _shops.Where(s => s.HasIcon && !_accents.ContainsKey(s.ShopId)))
            {
                if (await Js.InvokeAsync<string?>("esm.dominantColor", ShopIconCache.UrlFor(s.ShopId)) is { } color)
                {
                    _accents[s.ShopId] = color;
                    await ShopAccents.SaveAutomaticAsync(s.ShopId, color); // for the Home Assistant card
                }
            }
            StateHasChanged();
        }
    }

    private ListingFilter CurrentFilter() => new()
    {
        ShopId = _shopId,
        Text = _text,
        States = _status is AllStatus or MissingStatus ? [] : [_status],
        Missing = _status == MissingStatus,
        Sort = _sort,
        Skip = _page * PageSize,
        Take = PageSize,
    };

    private async Task LoadAsync()
    {
        _loadCts?.Cancel();
        var cts = _loadCts = new CancellationTokenSource();
        _loading = true;
        try
        {
            var filter = CurrentFilter();
            var (rows, total) = await Queries.SearchAsync(filter, cts.Token);
            var facets = await Queries.GetFacetsAsync(filter, cts.Token);
            var pending = await PendingChanges.CountAsync(cts.Token);
            if (cts.IsCancellationRequested) return;
            (_rows, _total, _facets, _pending) = (rows, total, facets, pending);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // A newer filter replaced this load.
        }
        finally
        {
            if (_loadCts == cts) _loading = false;
        }
    }

    private Task ReloadFromFirstPageAsync() { _page = 0; return LoadAsync(); }

    private Task OnTextChanged(string? value) { _text = value; return ReloadFromFirstPageAsync(); }
    private Task OnShopChanged(int? value) { _shopId = value; return ReloadFromFirstPageAsync(); }
    private Task OnStatusChanged(string value) { _status = value; return ReloadFromFirstPageAsync(); }
    private Task OnSortChanged(ListingSort value)
    {
        _sort = value;
        SyncColumnSort();
        return ReloadFromFirstPageAsync();
    }

    // List view headers and the sort dropdown are one setting; the server sorts, so the order spans every page.
    private static readonly (string Column, ListingSort Asc, ListingSort Desc)[] ColumnSorts =
    [
        ("title", ListingSort.TitleAsc, ListingSort.TitleDesc),
        ("status", ListingSort.StateAsc, ListingSort.StateDesc),
        ("stock", ListingSort.QuantityAsc, ListingSort.QuantityDesc),
        ("price", ListingSort.PriceAsc, ListingSort.PriceDesc),
        ("sku", ListingSort.SkuAsc, ListingSort.SkuDesc),
        ("refill", ListingSort.RefillAsc, ListingSort.RefillDesc),
        ("updated", ListingSort.UpdatedAsc, ListingSort.UpdatedDesc),
    ];

    private readonly ColumnSort _columnSort = new([.. ColumnSorts.Select(c => c.Column)]);

    private static readonly ListingSort[] MenuSorts =
        [ListingSort.UpdatedDesc, ListingSort.CreatedDesc, ListingSort.TitleAsc, ListingSort.PriceAsc, ListingSort.PriceDesc, ListingSort.QuantityAsc];

    private Task OnColumnSortAsync()
    {
        var c = ColumnSorts.First(c => c.Column == _columnSort.Column);
        _sort = _columnSort.Descending ? c.Desc : c.Asc;
        return ReloadFromFirstPageAsync();
    }

    private void SyncColumnSort()
    {
        var match = ColumnSorts.FirstOrDefault(c => c.Asc == _sort || c.Desc == _sort);
        _columnSort.Set(match.Column, descending: match.Column is not null && match.Desc == _sort);
    }

    private static string SortLabel(ListingSort sort) => sort switch
    {
        ListingSort.UpdatedDesc => "Recently updated",
        ListingSort.UpdatedAsc => "Least recently updated",
        ListingSort.CreatedDesc => "Newest",
        ListingSort.TitleAsc => "Title A–Z",
        ListingSort.TitleDesc => "Title Z–A",
        ListingSort.PriceAsc => "Lowest price",
        ListingSort.PriceDesc => "Highest price",
        ListingSort.QuantityAsc => "Lowest stock",
        ListingSort.QuantityDesc => "Highest stock",
        ListingSort.StateAsc => "Status A–Z",
        ListingSort.StateDesc => "Status Z–A",
        ListingSort.SkuAsc => "SKU A–Z",
        ListingSort.SkuDesc => "SKU Z–A",
        ListingSort.RefillAsc => "Auto-refill off first",
        ListingSort.RefillDesc => "Auto-refill on first",
        _ => sort.ToString(),
    };
    private Task OnPageChanged(int page) { _page = page - 1; return LoadAsync(); }

    private Task ClearFiltersAsync()
    {
        (_text, _shopId, _status) = (null, null, AllStatus);
        return ReloadFromFirstPageAsync();
    }

    private async Task SetViewAsync(string view)
    {
        _view = view;
        await Js.InvokeVoidAsync("esm.setPref", "listingsView", view);
    }

    private int? StatusCount(string key) => _facets is null ? null : key switch
    {
        AllStatus => _facets.OnEtsy,
        MissingStatus => _facets.Missing,
        _ => _facets.ByState.GetValueOrDefault(key),
    };

    private ShopImportStatus? ShopFor(int shopId) => _shops?.FirstOrDefault(s => s.ShopId == shopId);

    private string Accent(int shopId)
    {
        if (_accents.TryGetValue(shopId, out var color)) return color;
        var index = _shops?.FindIndex(s => s.ShopId == shopId) ?? -1;
        return $"var(--esm-shop-fallback-{Math.Max(0, index) % FallbackAccentCount})";
    }

    private string ShopStyle(int shopId) => $"--shop: {Accent(shopId)}";

    private static string StockLabel(int quantity) => quantity == 0 ? "Out of stock" : $"{quantity:N0} in stock";

    private static (string Kind, string Label)? StateBadge(ListingRow row) => row switch
    {
        { IsMissingOnEtsy: true } => ("missing", "Gone from Etsy"),
        { State: "active" } => null,
        { State: "draft" } => ("draft", "Draft"),
        { State: "sold_out" } => ("soldout", "Sold out"),
        { State: "expired" } => ("expired", "Expired"),
        { State: "inactive" } => ("inactive", "Inactive"),
        _ => ("inactive", ListingFormat.Humanize(row.State)),
    };

    private async Task ImportAsync(ShopImportStatus s, bool force)
    {
        var user = (await AuthState).User.Identity?.Name;
        var id = await ImportQueue.ImportShopAsync(s.ShopId, force, user);
        Snackbar.Add(id is null ? $"An import for {s.ShopName} is already queued" : $"Import for {s.ShopName} queued (job {id})",
            Severity.Info);
    }

    private void ToggleSelecting()
    {
        _selecting = !_selecting;
        if (!_selecting) (_bulkEnabled, _bulkThreshold, _bulkRefillTo, _bulkError) = (null, null, null, null);
    }

    private void Select(int id, bool selected)
    {
        if (selected) _selected.Add(id);
        else _selected.Remove(id);
    }

    private string RowClass(int id) =>
        (_selecting ? "is-selectable " : "") + (_selected.Contains(id) ? "is-selected" : "");

    private bool PageSelected => _rows is { Count: > 0 } && _rows.All(r => _selected.Contains(r.Id));

    private void SelectPage(bool selected)
    {
        foreach (var row in _rows ?? []) Select(row.Id, selected);
    }

    private async Task SelectAllMatchingAsync() =>
        _selected.UnionWith(await Queries.SearchIdsAsync(CurrentFilter()));

    private static string BulkKindLabel(BulkEditKind? kind) => kind switch
    {
        null => "Auto-refill",
        BulkEditKind.Price => "Price",
        BulkEditKind.AddTags => "Add tags",
        BulkEditKind.RemoveTags => "Remove tags",
        BulkEditKind.AddMaterials => "Add materials",
        BulkEditKind.RemoveMaterials => "Remove materials",
        BulkEditKind.ShippingProfile => "Shipping profile",
        _ => "Shop section",
    };

    private static string RefillLabel(RefillSetting? r) =>
        r is { Enabled: true } ? $"Below {r.Threshold} → {r.RefillTo}" : "Off";

    private async Task ApplyBulkAsync()
    {
        _bulkError = null;
        var change = new BulkRefillChange(_bulkEnabled, _bulkThreshold, _bulkRefillTo);
        if (change.IsEmpty)
        {
            _bulkError = "Choose on or off, a threshold or a refill-to value first.";
            return;
        }

        var preview = await Refiller.PreviewBulkAsync(_selected, change);
        if (preview.Problems.Count > 0)
        {
            _bulkError = string.Join(" ", preview.Problems);
            return;
        }
        if (preview.Changing == 0)
        {
            Snackbar.Add("Nothing to change: the selected listings already have these settings.", Severity.Info);
            return;
        }

        var message = $"{preview.Changing:N0} of {preview.Selected:N0} selected listing{(preview.Selected == 1 ? "" : "s")} will change " +
                      $"({change.Describe()}). Nothing is sent to Etsy now.";
        if (preview.WouldRefill > 0)
            message += $" {preview.WouldRefill:N0} already have stock below the threshold and will be refilled at the next check " +
                       "(after the next order, or within the hour).";
        if (preview.NotActive > 0)
            message += $" {preview.NotActive:N0} aren't active on Etsy, so they won't be refilled until they are.";
        var confirmed = await Dialogs.ShowMessageBoxAsync("Change auto-refill", message,
            yesText: $"Change {preview.Changing:N0} listing{(preview.Changing == 1 ? "" : "s")}", cancelText: "Cancel");
        if (confirmed != true) return;

        _applying = true;
        try
        {
            var changed = await Refiller.ApplyBulkAsync(_selected, change, (await AuthState).User);
            Snackbar.Add($"Auto-refill updated on {changed:N0} listing{(changed == 1 ? "" : "s")}", Severity.Success);
            await LoadAsync();
        }
        catch (ArgumentException ex)
        {
            _bulkError = ex.Message;
        }
        finally
        {
            _applying = false;
        }
    }

    public void Dispose()
    {
        _live?.Dispose();
        _loadCts?.Cancel();
    }
}
