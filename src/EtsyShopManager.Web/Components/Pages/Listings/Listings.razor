@page "/listings"
@attribute [Authorize]
@using EtsyShopManager.Etsy.Models
@using EtsyShopManager.Web.Modules.Listings
@implements IDisposable
@inject ListingQueries Queries
@inject ListingImportQueue ImportQueue
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Listings · Etsy Shop Manager</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Listings</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudText Typo="Typo.h6">Import from Etsy</MudText>
        <MudText Typo="Typo.body2" Class="muted">Runs nightly; listings are read-only until the editor arrives (Phase 3).</MudText>
    </MudStack>
    @if (_status is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_status.Count == 0)
    {
        <MudText>No shops connected. <MudLink Href="shops">Connect a shop</MudLink></MudText>
    }
    else
    {
        <MudSimpleTable Dense="true">
            <thead>
                <tr><th>Shop</th><th>Listings</th><th>Last import</th><th>Lookups</th><th>Images pending</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in _status)
                {
                    <tr>
                        <td><b>@s.ShopName</b></td>
                        <td>@s.ListingCount</td>
                        <td>@ListingFormat.Local(s.LastCompletedAtUtc)</td>
                        <td>@ListingFormat.Local(s.LookupsImportedAtUtc)</td>
                        <td>@s.ImagesPending</td>
                        <td>
                            @if (!s.IsHealthy)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">Reconnect needed</MudChip>
                            }
                            else if (s.IsRunOpen)
                            {
                                <MudTooltip Text="@($"Started {ListingFormat.Local(s.RunStartedAtUtc)}")">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">Importing…</MudChip>
                                </MudTooltip>
                            }
                            @if (!string.IsNullOrEmpty(s.LastError))
                            {
                                <MudTooltip Text="@s.LastError">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Last import failed</MudChip>
                                </MudTooltip>
                            }
                        </td>
                        <td class="text-right">
                            <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Editor}")" Context="auth">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="!s.IsHealthy"
                                           OnClick="() => ImportAsync(s, force: false)">Import now</MudButton>
                                <MudTooltip Text="Also re-reads every listing's attributes">
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="!s.IsHealthy"
                                               OnClick="() => ImportAsync(s, force: true)">Full re-import</MudButton>
                                </MudTooltip>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

<MudPaper Class="pa-4" Elevation="1">
    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" md="4">
            <MudTextField T="string" Value="_text" ValueChanged="OnTextChanged" Label="Search title, SKU, tag or listing id"
                          Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="int?" Value="_shopId" ValueChanged="OnShopChanged" Label="Shop" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int?" Value="null">All shops</MudSelectItem>
                @foreach (var s in _status ?? [])
                {
                    <MudSelectItem T="int?" Value="s.ShopId">@s.ShopName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="string" MultiSelection="true" SelectedValues="_states" SelectedValuesChanged="OnStatesChanged"
                       Label="State" Variant="Variant.Outlined" Margin="Margin.Dense"
                       MultiSelectionTextFunc="@(v => v.Count == 0 ? "All" : string.Join(", ", v.Select(ListingFormat.StateLabel)))">
                @foreach (var state in EtsyListingStates.All)
                {
                    <MudSelectItem T="string" Value="state">@ListingFormat.StateLabel(state)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="ListingSort" Value="_sort" ValueChanged="OnSortChanged" Label="Sort" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="ListingSort" Value="ListingSort.UpdatedDesc">Recently updated</MudSelectItem>
                <MudSelectItem T="ListingSort" Value="ListingSort.CreatedDesc">Newest</MudSelectItem>
                <MudSelectItem T="ListingSort" Value="ListingSort.TitleAsc">Title</MudSelectItem>
                <MudSelectItem T="ListingSort" Value="ListingSort.PriceAsc">Price (low first)</MudSelectItem>
                <MudSelectItem T="ListingSort" Value="ListingSort.PriceDesc">Price (high first)</MudSelectItem>
                <MudSelectItem T="ListingSort" Value="ListingSort.QuantityAsc">Quantity (low first)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2" Class="d-flex align-center">
            <MudSwitch T="bool" Value="_showMissing" ValueChanged="OnShowMissingChanged" Color="Color.Primary"
                       Label="Gone from Etsy" title="Show only listings a full import no longer found on Etsy" />
        </MudItem>
    </MudGrid>

    <MudTable @ref="_table" T="ListingRow" ServerData="LoadAsync" Dense="true" Hover="true" RowsPerPage="50"
              OnRowClick="@(e => Nav.NavigateTo($"listings/{e.Item!.Id}"))" RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh Style="width: 64px"></MudTh>
            <MudTh>Title</MudTh>
            <MudTh>State</MudTh>
            <MudTh Class="text-right">Price</MudTh>
            <MudTh Class="text-right">Qty</MudTh>
            <MudTh>SKU</MudTh>
            <MudTh>Shop</MudTh>
            <MudTh>Updated on Etsy</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @if (ImageStore.UrlFor(context.ThumbFileName) is { } thumb)
                {
                    <img src="@thumb" alt="" class="listing-thumb" loading="lazy" />
                }
                else
                {
                    <div class="listing-thumb placeholder"></div>
                }
            </MudTd>
            <MudTd>
                <div class="listing-title">@context.Title</div>
                <div class="muted small">
                    #@context.EtsyListingId · @context.ImageCount photo@(context.ImageCount == 1 ? "" : "s")
                    @if (context.VariationCount > 1) { <span> · @context.VariationCount variations</span> }
                </div>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@ListingFormat.StateColor(context.State)">@ListingFormat.StateLabel(context.State)</MudChip>
                @if (context.IsMissingOnEtsy)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error">gone from Etsy</MudChip>
                }
            </MudTd>
            <MudTd Class="text-right">@ListingFormat.Price(context.PriceAmount, context.PriceDivisor, context.CurrencyCode)</MudTd>
            <MudTd Class="text-right">@context.Quantity</MudTd>
            <MudTd><span class="small">@string.Join(", ", context.Skus.Take(3))@(context.Skus.Count > 3 ? " …" : "")</span></MudTd>
            <MudTd>@context.ShopName</MudTd>
            <MudTd>@ListingFormat.Local(context.EtsyUpdatedAtUtc)</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No listings match. If no import has run yet, use <b>Import now</b> above.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 25, 50, 100, 200 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private MudTable<ListingRow>? _table;
    private List<ShopImportStatus>? _status;
    private string? _text;
    private int? _shopId;
    private IReadOnlyCollection<string> _states = [];
    private ListingSort _sort = ListingSort.UpdatedDesc;
    private bool _showMissing;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        _status = await Queries.GetImportStatusAsync();
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            _status = await Queries.GetImportStatusAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task<TableData<ListingRow>> LoadAsync(TableState state, CancellationToken ct)
    {
        var (rows, total) = await Queries.SearchAsync(new ListingFilter
        {
            ShopId = _shopId,
            Text = _text,
            States = _states.ToList(),
            Missing = _showMissing,
            Sort = _sort,
            Skip = state.Page * state.PageSize,
            Take = state.PageSize,
        }, ct);
        return new TableData<ListingRow> { Items = rows, TotalItems = total };
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private Task OnTextChanged(string? value) { _text = value; return ReloadAsync(); }
    private Task OnShopChanged(int? value) { _shopId = value; return ReloadAsync(); }
    private Task OnStatesChanged(IReadOnlyCollection<string>? value) { _states = value ?? []; return ReloadAsync(); }
    private Task OnSortChanged(ListingSort value) { _sort = value; return ReloadAsync(); }
    private Task OnShowMissingChanged(bool value) { _showMissing = value; return ReloadAsync(); }

    private async Task ImportAsync(ShopImportStatus s, bool force)
    {
        var user = (await AuthState).User.Identity?.Name;
        var id = await ImportQueue.ImportShopAsync(s.ShopId, force, user);
        Snackbar.Add(id is null ? $"An import for {s.ShopName} is already queued" : $"Import for {s.ShopName} queued (job {id})",
            Severity.Info);
    }

    public void Dispose() => _timer?.Dispose();
}
