@using System.Text.Json.Nodes
@using EtsyShopManager.Core.Domain
@using EtsyShopManager.Web.Infrastructure.Storage
@using EtsyShopManager.Web.Modules.Listings
@inject VideoStore Store

@* The video of a listing being edited: preview, replace, remove, and upload. Changes go back to the editor
   as the new local "video" node; nothing reaches Etsy until a reviewed push. *@

@if (HasVideo)
{
    <MudStack Spacing="2">
        @if (VideoUrl is { } url)
        {
            @* No poster: Etsy's thumbnail is a 105 px square, which sized the player to it. The #t fragment makes
               browsers that skip preloading (Safari) still show the first frame. *@
            <video controls playsinline preload="metadata" src="@PlayerUrl(url)" class="esm-video"
                   style="@AspectStyle(VideoWidth, VideoHeight)"></video>
        }
        <div class="small muted">
            @VideoDescription
        </div>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadAsync" Accept=".mp4,.mov" Disabled="_uploading">
                <CustomContent>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.SwapHoriz"
                               Disabled="_uploading" OnClick="@(() => context.OpenFilePickerAsync())">
                        Replace video
                    </MudButton>
                </CustomContent>
            </MudFileUpload>
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" Disabled="_uploading" OnClick="RemoveAsync">
                Remove video
            </MudButton>
        </MudStack>
    </MudStack>
}
else
{
    <div class="esm-variation-add">
        <MudFileUpload T="IBrowserFile" FilesChanged="UploadAsync" Accept=".mp4,.mov" Disabled="_uploading">
            <CustomContent>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="_uploading" OnClick="@(() => context.OpenFilePickerAsync())">
                    Add a video
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        <span class="small muted">MP4 or MOV, up to 100 MB.</span>
    </div>
}

@if (_error is not null)
{
    <MudText Typo="Typo.body2" Class="error-text mt-2">@_error</MudText>
}

@code {
    private const long MaxBytes = 100 * 1024 * 1024;

    [Parameter] public JsonNode? Video { get; set; }
    [Parameter] public ListingVideo? Imported { get; set; }
    [Parameter] public EventCallback<JsonNode?> VideoChanged { get; set; }

    private bool _uploading;
    private string? _error;

    private bool HasVideo => Video is not null;

    private string? VideoUrl
    {
        get
        {
            if (Video is null) return null;
            if ((string?)Video["file_name"] is { Length: > 0 } file)
                return VideoStore.UrlFor(file);
            if ((long?)Video["etsy_video_id"] is > 0)
            {
                if (Imported?.FileName is { Length: > 0 } impFile && Store.Exists(impFile))
                    return VideoStore.UrlFor(impFile);
                return Imported?.SourceUrl;
            }
            return null;
        }
    }

    // A newly uploaded video has no known size yet; the imported one's size only applies to the Etsy video.
    private bool IsEtsyVideo => (long?)Video?["etsy_video_id"] is > 0;
    private int? VideoWidth => Dimension("width") ?? (IsEtsyVideo ? Imported?.Width : null);
    private int? VideoHeight => Dimension("height") ?? (IsEtsyVideo ? Imported?.Height : null);

    private int? Dimension(string key) => Video?[key] is JsonValue v && v.TryGetValue<int>(out var n) ? n : null;

    /// <summary>The player's source: the video URL with a start-time fragment, so the first frame shows before play.</summary>
    public static string PlayerUrl(string url) => url.Contains('#') ? url : url + "#t=0.001";

    /// <summary>The player's shape from the video's own size, so it keeps its aspect ratio before the file loads.</summary>
    public static string? AspectStyle(int? width, int? height) =>
        width is > 0 && height is > 0 ? $"--esm-video-ratio: {width} / {height}" : null;

    private string VideoDescription
    {
        get
        {
            if (Video is null) return "No video";
            if ((long?)Video["etsy_video_id"] is { } id)
                return $"Etsy video #{id} ({(string?)Video["video_state"] ?? "active"})";
            var name = (string?)Video["name"] ?? (string?)Video["file_name"] ?? "new video";
            return $"New video ({name}) · unpushed";
        }
    }

    private async Task UploadAsync(IBrowserFile? file)
    {
        if (file is null) return;
        _error = null;
        if (file.Size > MaxBytes)
        {
            _error = $"{file.Name} is larger than {MaxBytes / 1024 / 1024} MB.";
            return;
        }
        _uploading = true;
        try
        {
            using var stream = file.OpenReadStream(MaxBytes);
            var ext = Path.GetExtension(file.Name);
            var fileName = await Store.SaveAsync(stream, ext);
            var node = new JsonObject
            {
                ["file_name"] = fileName,
                ["name"] = file.Name,
            };
            await VideoChanged.InvokeAsync(node);
        }
        catch (Exception ex)
        {
            _error = $"Could not upload video: {ex.Message}";
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task RemoveAsync()
    {
        _error = null;
        await VideoChanged.InvokeAsync(null);
    }
}
