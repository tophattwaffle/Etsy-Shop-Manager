@using System.Text.Json.Nodes
@using EtsyShopManager.Core.Domain
@using EtsyShopManager.Web.Infrastructure.Storage
@using EtsyShopManager.Web.Modules.Editor
@using EtsyShopManager.Web.Modules.Listings
@inject VideoStore Store

@* The videos of a listing being edited: preview, replace, remove, and upload, up to Etsy's limit. Changes go back to the
   editor as the new local "videos" list; nothing reaches Etsy until a reviewed push. Etsy keeps videos in upload order
   and can't reorder them, so new videos always go after the ones already on Etsy (VideoPlan). *@

@if (Items.Count > 0)
{
    <div class="esm-video-list">
        @foreach (var (video, index) in Items.Select((v, i) => (v, i)))
        {
            var imported = ImportedFor(video);
            <div class="esm-video-item" @key="KeyFor(video)">
                @if (VideoUrl(video, imported) is { } url)
                {
                    @* No poster: Etsy's thumbnail is a 105 px square, which sized the player to it. The #t fragment makes
                       browsers that skip preloading (Safari) still show the first frame. *@
                    <video controls playsinline preload="metadata" src="@PlayerUrl(url)" class="esm-video"
                           style="@AspectStyle(Dimension(video, "width") ?? imported?.Width, Dimension(video, "height") ?? imported?.Height)"></video>
                }
                <div class="small muted">Video @(index + 1): @Describe(video)</div>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudFileUpload T="IBrowserFile" FilesChanged="@(f => UploadAsync(f, index))" Accept=".mp4,.mov" Disabled="_uploading">
                        <CustomContent>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.SwapHoriz"
                                       Disabled="_uploading" OnClick="@(() => context.OpenFilePickerAsync())"
                                       aria-label="@($"Replace video {index + 1}")">
                                Replace
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" Disabled="_uploading"
                               OnClick="@(() => RemoveAsync(index))" aria-label="@($"Remove video {index + 1}")">
                        Remove
                    </MudButton>
                </MudStack>
            </div>
        }
    </div>
}

@if (Items.Count < VideoPlan.MaxVideos)
{
    <div class="esm-variation-add @(Items.Count > 0 ? "mt-3" : "")">
        <MudFileUpload T="IBrowserFile" FilesChanged="@(f => UploadAsync(f, null))" Accept=".mp4,.mov" Disabled="_uploading">
            <CustomContent>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="_uploading" OnClick="@(() => context.OpenFilePickerAsync())">
                    @(Items.Count == 0 ? "Add a video" : "Add another video")
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        <span class="small muted">MP4 or MOV, up to 100 MB.</span>
    </div>
}

@if (_error is not null)
{
    <MudText Typo="Typo.body2" Class="error-text mt-2">@_error</MudText>
}

@code {
    private const long MaxBytes = 100 * 1024 * 1024;

    [Parameter] public JsonNode? Videos { get; set; }
    [Parameter] public IReadOnlyList<ListingVideo> Imported { get; set; } = [];
    [Parameter] public EventCallback<JsonNode?> VideosChanged { get; set; }

    private bool _uploading;
    private string? _error;

    private List<JsonObject> Items => VideoPlan.Items(Videos);

    // A newly uploaded video has no imported row (and no known size yet).
    private ListingVideo? ImportedFor(JsonObject video) =>
        VideoPlan.EtsyId(video) is { } id ? Imported.FirstOrDefault(v => v.EtsyVideoId == id) : null;

    private string? VideoUrl(JsonObject video, ListingVideo? imported)
    {
        if (VideoPlan.EtsyId(video) is null)
            return VideoStore.UrlFor(VideoPlan.FileName(video));
        if (imported?.FileName is { Length: > 0 } file && Store.Exists(file))
            return VideoStore.UrlFor(file);
        return imported?.SourceUrl is { Length: > 0 } source ? source : null;
    }

    // Each video keeps its own player when one before it is removed.
    private static string KeyFor(JsonObject video) =>
        VideoPlan.EtsyId(video) is { } id ? $"etsy:{id}" : $"file:{VideoPlan.FileName(video)}";

    private static int? Dimension(JsonObject video, string key) =>
        video[key] is JsonValue v && v.TryGetValue<int>(out var n) ? n : null;

    private static string Describe(JsonObject video)
    {
        if (VideoPlan.EtsyId(video) is { } id)
            return $"Etsy video #{id} ({(string?)video["video_state"] ?? "active"})";
        return $"new video ({(string?)video["name"] ?? VideoPlan.FileName(video) ?? "video"}) · unpushed";
    }

    /// <summary>The player's source: the video URL with a start-time fragment, so the first frame shows before play.</summary>
    public static string PlayerUrl(string url) => url.Contains('#') ? url : url + "#t=0.001";

    /// <summary>The player's shape from the video's own size, so it keeps its aspect ratio before the file loads.</summary>
    public static string? AspectStyle(int? width, int? height) =>
        width is > 0 && height is > 0 ? $"--esm-video-ratio: {width} / {height}" : null;

    private async Task UploadAsync(IBrowserFile? file, int? replacing)
    {
        if (file is null) return;
        _error = null;
        if (file.Size > MaxBytes)
        {
            _error = $"{file.Name} is larger than {MaxBytes / 1024 / 1024} MB.";
            return;
        }
        _uploading = true;
        try
        {
            using var stream = file.OpenReadStream(MaxBytes);
            var fileName = await Store.SaveAsync(stream, Path.GetExtension(file.Name));
            var node = new JsonObject
            {
                ["file_name"] = fileName,
                ["name"] = file.Name,
            };
            await VideosChanged.InvokeAsync(VideoPlan.Add(Videos, node, replacing));
        }
        catch (Exception ex)
        {
            _error = $"Could not upload video: {ex.Message}";
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task RemoveAsync(int index)
    {
        _error = null;
        await VideosChanged.InvokeAsync(VideoPlan.Remove(Videos, index));
    }
}
