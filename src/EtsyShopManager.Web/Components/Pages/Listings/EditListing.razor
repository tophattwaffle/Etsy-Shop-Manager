@page "/listings/{Id:int}/edit"
@attribute [Authorize(Roles = Roles.Admin)]
@using System.Text.Json.Nodes
@using EtsyShopManager.Core.Listings
@using EtsyShopManager.Web.Modules.Editor
@using EtsyShopManager.Web.Modules.Listings
@using EtsyShopManager.Web.Modules.Templates
@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject ListingEditor Editor
@inject IDbContextFactory<AppDbContext> DbFactory
@inject EtsyShopManager.Core.Jobs.IJobEvents JobEvents
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ListingImportQueue ImportQueue
@inject EtsyShopManager.Web.Modules.Templates.TextBlockService TextBlocks
@inject EtsyShopManager.Web.Modules.Templates.VariationListService VariationLists
@inject IJSRuntime Js

<PageTitle>Edit @(_snapshot?.Listing.Title ?? "listing") · Etsy Shop Manager</PageTitle>

<MudLink Href="@($"listings/{Id}")" Class="d-inline-flex align-center mb-2">
    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mr-1" /> Back to listing
</MudLink>

@if (_snapshot is null || _form is null || _lookups is null)
{
    <PageHeader Title="Edit listing" />
    @if (_notFound)
    {
        <MudAlert Severity="Severity.Warning">Listing not found.</MudAlert>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" />
    }
}
else
{
    var l = _snapshot.Listing;
    var model = _snapshot.Model;
    <PageHeader Title="Edit listing">
        <Summary>
            @l.Shop.Name · #@l.EtsyListingId ·
            @(model.DriftFields.Count > 0 ? "changed on Etsy, needs your choice"
                : model.HasDraft ? $"{model.Draft.Count} unpushed change{(model.Draft.Count == 1 ? "" : "s")}" : "matches Etsy")
            @if (Unsaved) { <span> · unsaved edits on this page</span> }
        </Summary>
        <Actions>
            <MudButton Variant="Variant.Text" Disabled="@(!Unsaved && !model.HasDraft)" OnClick="DiscardAsync">Discard changes</MudButton>
            <SaveButtons Text="Save draft" Changed="Unsaved" OnSave="SaveAsync" OnCancel="CancelEditsAsync" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ReviewAsync">Review and push</MudButton>
        </Actions>
    </PageHeader>

    @if (ListingEditor.NeedsRefresh(l))
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            This listing was read from Etsy by an older version of the app, so some text may show Etsy's encoding.
            Refresh it before editing; pushing is blocked until then.
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="RefreshFromEtsyAsync">Refresh from Etsy</MudButton>
        </MudAlert>
    }

    @if (model.DriftFields.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4 esm-drift" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6">Changed on Etsy</MudText>
            <MudText Typo="Typo.body2" Class="muted mb-3">
                These were edited on etsy.com since this app last synced. Choose which version to keep before pushing.
            </MudText>
            @foreach (var key in model.DriftFields)
            {
                <div class="esm-drift-row">
                    <div class="esm-drift-label">@ListingEditor.Label(key)</div>
                    <DriftDiffView Diff="@DriftDiff.For(key, model.Local(key), model.Etsy[key], _lookups)" />
                    <div class="esm-drift-actions">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ResolveAsync(key, DriftResolution.KeepMine)">Keep mine</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => ResolveAsync(key, DriftResolution.TakeEtsy)">Take Etsy's</MudButton>
                    </div>
                </div>
            }
        </MudPaper>
    }

    @if (_preview is not null)
    {
        <ListingPreview Preview="_preview" Lookups="_lookups" OnClose="() => _preview = null" OnPush="PushAsync" Pushing="_pushing" />
    }

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">About</MudText>
                <MudTextField T="string" Value="@Str("title")" ValueChanged="@(v => SetStr("title", v))" Label="Title"
                              Counter="ListingEditor.MaxTitleLength" MaxLength="ListingEditor.MaxTitleLength" Immediate="true"
                              Variant="Variant.Outlined" Class="mb-3" HelperText="@Pending("title")" />
                <div id="esm-description">
                    <MudTextField T="string" Value="@_description" ValueChanged="SetDescription" Label="Description"
                                  Lines="12" Variant="Variant.Outlined" Immediate="true" HelperText="@DescriptionHelp"
                                  Error="@(DescriptionUnknown.Count > 0)" />
                </div>
                @if (_allBlocks.Count > 0)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
                        <MudSelect T="int?" @bind-Value="_blockToInsert" Label="Text template" Variant="Variant.Outlined" Margin="Margin.Dense" Class="esm-w-sm">
                            @foreach (var b in _allBlocks) { <MudSelectItem T="int?" Value="b.Id">@b.Name</MudSelectItem> }
                        </MudSelect>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(_blockToInsert is null)" OnClick="InsertBlockAsync">Insert text template</MudButton>
                    </MudStack>
                }
                @if (_listingBlocks.Count > 0)
                {
                    <MudText Typo="Typo.body2" Class="muted mt-2">
                        Uses:
                        @foreach (var (block, status) in _listingBlocks)
                        {
                            <a href="@($"templates/text/{block.Id}")" class="mr-2">@block.Name</a>
                            @if (status != EtsyShopManager.Web.Modules.Templates.TextBlockUseStatus.UpToDate)
                            {
                                <span class="mr-2">(@BlockStatus(status))</span>
                            }
                        }
                    </MudText>
                }
                @if (PlaceholderEngine.HasPlaceholders(_description))
                {
                    <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
                        <MudExpansionPanel Text="Shown on Etsy as">
                            <pre class="json-block">@Str("description")</pre>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Photos</MudText>
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    Reorder, remove, add photos and edit alt text. A push gives every photo its own position on Etsy (one call
                    per photo that isn't already in place), because Etsy doesn't renumber the others. @Pending(ListingFields.Images)
                </MudText>
                <PhotosEditor Images="@(_form![ListingFields.Images] as JsonArray ?? [])" Imported="l.Images"
                              ImagesChanged="@(i => Set(ListingFields.Images, i))" />
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Video</MudText>
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    Etsy allows up to 1 video per listing (MP4 or MOV, up to 100 MB). @Pending(ListingFields.Video)
                </MudText>
                <VideoEditor Video="@_form![ListingFields.Video]"
                             Imported="@l.Videos.FirstOrDefault(v => v.VideoState != "deleted")"
                             VideoChanged="@(v => Set(ListingFields.Video, v))" />
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Variations, price and processing</MudText>
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    Stock isn't edited here: Etsy, sales and auto-refill manage it, and new combinations start with the
                    listing's current stock. @Pending(ListingFields.Inventory)
                </MudText>
                @if (_form![ListingFields.Inventory] is { } inventoryNode)
                {
                    <VariationsEditor Inventory="inventoryNode" Order="VariationEditor.EtsyOrder(l)"
                                      Links="_links"
                                      @bind-SkuPattern="_skuPattern"
                                      BaseSku="@(l.Skus.FirstOrDefault(s => !string.IsNullOrEmpty(s)) ?? "")"
                                      InventoryChanged="@(i => Set(ListingFields.Inventory, i))" />
                    @if (_variationLists.Count > 0)
                    {
                        @foreach (var v in VariationEditor.Variations(inventoryNode, VariationEditor.EtsyOrder(l)))
                        {
                            var link = _links.FirstOrDefault(k => k.PropertyId == v.PropertyId);
                            var propertyId = v.PropertyId;
                            <div class="esm-variation">
                                <div class="esm-variation-name">@v.Name: variation template</div>
                                @if (link is not null)
                                {
                                    <div class="esm-variation-add">
                                        <span>Follows <a href="@($"templates/variations/{link.ListId}")">@link.ListName</a>.</span>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => ApplyLinkedAsync(link))">Apply template now</MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => UnlinkListAsync(link))">Unlink</MudButton>
                                    </div>
                                    <div class="small muted">
                                        Apply template now brings this listing in line with the template as unpushed edits. Unlink keeps the values as they are.
                                    </div>
                                }
                                else
                                {
                                    <div class="esm-variation-add">
                                        <MudSelect T="int?" Value="@_linkPick.GetValueOrDefault(propertyId)" ValueChanged="@(id => PickLinkAsync(propertyId, id))"
                                                   Label="Link to variation template" Variant="Variant.Outlined" Margin="Margin.Dense" Class="esm-w-sm">
                                            @foreach (var (listId, listName) in _variationLists)
                                            {
                                                <MudSelectItem T="int?" Value="@listId">@listName</MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   Disabled="@(_linkPreview.GetValueOrDefault(propertyId).Preview is null)"
                                                   OnClick="@(() => LinkListAsync(propertyId))">Link</MudButton>
                                    </div>
                                    @if (_linkPreview.TryGetValue(propertyId, out var lp))
                                    {
                                        @if (lp.Error is not null)
                                        {
                                            <MudText Typo="Typo.body2" Class="error-text">@lp.Error</MudText>
                                        }
                                        else if (lp.Preview is { } p)
                                        {
                                            <div class="small">
                                                @p.InList of @p.Values value@(p.Values == 1 ? " is" : "s are") in the template.
                                                @(p.Changes.Count == 0 ? "Applying it changes nothing now." : $"Applying it then: {string.Join(", ", p.Changes.Skip(1))}.")
                                                Linking only records the link.
                                            </div>
                                            @if (p.Warning is not null)
                                            {
                                                <MudText Typo="Typo.body2" Class="warning-text">@p.Warning</MudText>
                                            }
                                        }
                                    }
                                }
                            </div>
                        }
                    }
                    @if (_variationLists.Count > 0 && VariationEditor.Variations(inventoryNode).Count < VariationEditor.MaxVariations)
                    {
                        <div class="esm-variation">
                            <div class="esm-variation-name">Add from variation template</div>
                            <div class="esm-variation-add">
                                <MudSelect T="int?" Value="@_fromList" ValueChanged="PickFromListAsync" Label="Variation template" Variant="Variant.Outlined"
                                           Margin="Margin.Dense" Class="esm-w-sm">
                                    @foreach (var (listId, listName) in _variationLists)
                                    {
                                        <MudSelectItem T="int?" Value="@listId">@listName</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField T="string" @bind-Value="_fromListName" Label="Variation name" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Class="esm-w-sm" />
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(_fromList is null || string.IsNullOrWhiteSpace(_fromListName))"
                                           OnClick="AddFromListAsync">Add from template</MudButton>
                            </div>
                            <div class="small muted">
                                Adds the template's switched-on options as a new variation and links the listing to the template, so later changes
                                to the template follow. The price doesn't vary by it and stock stays shared.
                            </div>
                        </div>
                    }
                }
                @if (Products.Count > 0)
                {
                    <MudSimpleTable Dense="true">
                        @* An editing grid: rows stay in variation order while prices are typed in (not sortable). *@
                        <thead class="esm-fixed-order"><tr><th>Variation</th><th>Price (@(l.CurrencyCode ?? ""))</th><th>Processing profile</th><th>Available</th></tr></thead>
                        <tbody>
                            @foreach (var (product, index) in Products.Select((p, i) => (p!, i)))
                            {
                                var offering = product["offerings"]![0]!;
                                <tr>
                                    <td>@EditorLookups.VariationName(product, VariationEditor.EtsyOrder(l))</td>
                                    <td>
                                        <MudNumericField T="decimal" Value="@Price(offering)" ValueChanged="@(v => SetPrice(index, v))"
                                                         Min="0.20m" Step="0.01m" Format="0.00" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Disabled="@(!Leads(index, "price_on_property"))" Class="esm-w-sm esm-minw-price" />
                                    </td>
                                    <td>
                                        <MudSelect T="long?" Value="@((long?)offering["readiness_state_id"])" ValueChanged="@(v => SetProcessing(index, v))"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(!Leads(index, "readiness_state_on_property"))" Class="esm-minw-md">
                                            <MudSelectItem T="long?" Value="null">—</MudSelectItem>
                                            @foreach (var (id, name) in _lookups.ProcessingProfiles)
                                            {
                                                <MudSelectItem T="long?" Value="id">@name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </td>
                                    <td>
                                        <MudSwitch T="bool" Value="@((bool?)offering["is_enabled"] ?? true)" Color="Color.Primary"
                                                   ValueChanged="@(on => Set(ListingFields.Inventory, VariationEditor.SetAvailable(_form![ListingFields.Inventory]!, index, on)))"
                                                   aria-label="@($"{EditorLookups.VariationName(product)} available to buyers")" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    @if (Products.Count > 1)
                    {
                        <MudText Typo="Typo.body2" Class="muted mt-2">
                            @VariesNote("price_on_property", "price") @VariesNote("readiness_state_on_property", "processing profile")
                        </MudText>
                    }
                }
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Tags and materials</MudText>
                <MudTextField T="string" Value="@List("tags")" ValueChanged="@(v => SetList("tags", v))" Label="Tags (separate with commas)"
                              Variant="Variant.Outlined" Class="mb-1" HelperText="@($"{Count("tags")} of {ListingEditor.MaxTags}. {Pending("tags")}")" />
                <MudTextField T="string" Value="@List("materials")" ValueChanged="@(v => SetList("materials", v))" Label="Materials (separate with commas)"
                              Variant="Variant.Outlined" HelperText="@($"{Count("materials")} of {ListingEditor.MaxMaterials}. {Pending("materials")}")" />
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Category attributes</MudText>
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    The details Etsy asks for in this listing's category (@(_category?.Path ?? "no category")). A push sends one call per
                    attribute changed. @Pending(ListingFields.Attributes)
                </MudText>
                <AttributesEditor Attributes="_form![ListingFields.Attributes]" Properties="_attributeProperties" Name="AttributeName"
                                  AttributesChanged="@(a => Set(ListingFields.Attributes, a))" />
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Personalization</MudText>
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    What buyers are asked when they order. A push replaces all of the listing's questions on Etsy with these.
                    @Pending(ListingFields.Personalization)
                </MudText>
                <PersonalizationQuestions Questions="_form![ListingFields.Personalization]"
                                          QuestionsChanged="@(q => Set(ListingFields.Personalization, q))" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Status</MudText>
                <MudSelect T="string" Value="@Str(ListingFields.State)" ValueChanged="@(v => SetStr(ListingFields.State, v))" Label="Status"
                           Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@Pending(ListingFields.State)">
                    @if (Str(ListingFields.State) is not ("active" or "inactive"))
                    {
                        <MudSelectItem T="string" Value="@Str(ListingFields.State)">@ListingFormat.StateLabel(Str(ListingFields.State) ?? "")</MudSelectItem>
                    }
                    <MudSelectItem T="string" Value="@("active")">Active</MudSelectItem>
                    <MudSelectItem T="string" Value="@("inactive")">Inactive</MudSelectItem>
                </MudSelect>
                <MudSwitch T="bool" Value="@Bool("should_auto_renew")" ValueChanged="@(v => SetBool("should_auto_renew", v))" Color="Color.Primary"
                           Label="Renew automatically when it expires" Class="mt-2" />
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Shop settings</MudText>
                <MudSelect T="long?" Value="@Long("shop_section_id")" ValueChanged="@(v => SetLong("shop_section_id", v))" Label="Shop section"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" HelperText="@Pending("shop_section_id")">
                    <MudSelectItem T="long?" Value="null">None</MudSelectItem>
                    @foreach (var (id, name) in _lookups.Sections) { <MudSelectItem T="long?" Value="id">@name</MudSelectItem> }
                </MudSelect>
                <MudSelect T="long?" Value="@Long("shipping_profile_id")" ValueChanged="@(v => SetLong("shipping_profile_id", v))" Label="Shipping profile"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" HelperText="@Pending("shipping_profile_id")">
                    @foreach (var (id, name) in _lookups.ShippingProfiles) { <MudSelectItem T="long?" Value="id">@name</MudSelectItem> }
                </MudSelect>
                <MudSelect T="long?" Value="@Long("return_policy_id")" ValueChanged="@(v => SetLong("return_policy_id", v))" Label="Return policy"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" HelperText="@Pending("return_policy_id")">
                    @foreach (var (id, name) in _lookups.ReturnPolicies) { <MudSelectItem T="long?" Value="id">@name</MudSelectItem> }
                </MudSelect>
                <MudAutocomplete T="CategoryOption" Value="@_category" ValueChanged="SetCategory" SearchFunc="SearchCategoriesAsync"
                                 ToStringFunc="@(c => c?.Path ?? "")" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 MinCharacters="2" ResetValueOnEmptyText="false" HelperText="@Pending("taxonomy_id")" />
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Details</MudText>
                <MudSelect T="string" Value="@Str("who_made")" ValueChanged="@(v => SetStr("who_made", v))" Label="Who made it?"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    <MudSelectItem T="string" Value="@("i_did")">I did</MudSelectItem>
                    <MudSelectItem T="string" Value="@("collective")">A member of my shop</MudSelectItem>
                    <MudSelectItem T="string" Value="@("someone_else")">Another company or person</MudSelectItem>
                </MudSelect>
                <MudSelect T="string" Value="@Str("when_made")" ValueChanged="@(v => SetStr("when_made", v))" Label="When was it made?"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    @foreach (var w in WhenMade) { <MudSelectItem T="string" Value="w">@ListingFormat.Humanize(w)</MudSelectItem> }
                </MudSelect>
                <MudSwitch T="bool" Value="@Bool("is_supply")" ValueChanged="@(v => SetBool("is_supply", v))" Color="Color.Primary" Label="A supply or tool to make things" />
                <MudSwitch T="bool" Value="@Bool("is_taxable")" ValueChanged="@(v => SetBool("is_taxable", v))" Color="Color.Primary" Label="Taxable" />
                @if (_lookups.ProductionPartners.Count > 0)
                {
                    <MudSelect T="long" MultiSelection="true" SelectedValues="@Partners" SelectedValuesChanged="SetPartners" Label="Production partners"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3">
                        @foreach (var (id, name) in _lookups.ProductionPartners) { <MudSelectItem T="long" Value="id">@name</MudSelectItem> }
                    </MudSelect>
                }
            </MudPaper>

            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Weight and size</MudText>
                <MudStack Row="true" Spacing="2">
                    <MudNumericField T="decimal?" Value="@Dec("item_weight")" ValueChanged="@(v => SetDec("item_weight", v))" Label="Weight" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudSelect T="string" Value="@Str("item_weight_unit")" ValueChanged="@(v => SetStr("item_weight_unit", v))" Label="Unit" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var u in new[] { "oz", "lb", "g", "kg" }) { <MudSelectItem T="string" Value="u">@u</MudSelectItem> }
                    </MudSelect>
                </MudStack>
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudNumericField T="decimal?" Value="@Dec("item_length")" ValueChanged="@(v => SetDec("item_length", v))" Label="Length" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudNumericField T="decimal?" Value="@Dec("item_width")" ValueChanged="@(v => SetDec("item_width", v))" Label="Width" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudNumericField T="decimal?" Value="@Dec("item_height")" ValueChanged="@(v => SetDec("item_height", v))" Label="Height" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudStack>
                <MudSelect T="string" Value="@Str("item_dimensions_unit")" ValueChanged="@(v => SetStr("item_dimensions_unit", v))" Label="Size unit"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2">
                    @foreach (var u in new[] { "in", "ft", "mm", "cm", "m", "yd" }) { <MudSelectItem T="string" Value="u">@u</MudSelectItem> }
                </MudSelect>
            </MudPaper>

            <RefillPanel ListingId="Id" ShopId="l.ShopId" />
        </MudItem>
    </MudGrid>

    @if (_snapshot.RecentPushes.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Push history</MudText>
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <SortHeader Sort="_pushSort" Column="when" Changed="StateHasChanged">When</SortHeader>
                        <SortHeader Sort="_pushSort" Column="by" Changed="StateHasChanged">By</SortHeader>
                        <SortHeader Sort="_pushSort" Column="status" Changed="StateHasChanged">Status</SortHeader>
                        <SortHeader Sort="_pushSort" Column="changed" Changed="StateHasChanged">Changed</SortHeader>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _pushSort.Apply(_snapshot.RecentPushes))
                    {
                        <tr>
                            <td>@ListingFormat.Local(p.RequestedAtUtc)</td>
                            <td>@p.RequestedBy</td>
                            <td>
                                <MudChip T="string" Size="Size.Small" Color="@PushColor(p.Status)">@PushLabel(p.Status)</MudChip>
                                @if (p.Error is not null) { <div class="small error-text">@p.Error</div> }
                            </td>
                            <td class="small">@ChangedLabels(p)</td>
                            <td class="text-right">
                                @if (p.SnapshotId is { } snapshotId)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => RestoreAsync(snapshotId)">Restore the version before this</MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    public sealed record CategoryOption(long Id, string Path);

    private static readonly string[] WhenMade =
        ["made_to_order", "2020_2026", "2010_2019", "2007_2009", "before_2007", "2000_2006", "1990s", "1980s", "1970s",
         "1960s", "1950s", "1940s", "1930s", "1920s", "1910s", "1900s", "1800s", "1700s", "before_1700"];

    private EditorSnapshot? _snapshot;
    private EditorLookups? _lookups;
    private JsonObject? _form;
    private CategoryOption? _category;
    private PushPreview? _preview;
    private IReadOnlyList<TextBlock> _allBlocks = [];
    private IReadOnlyList<(TextBlock Block, EtsyShopManager.Web.Modules.Templates.TextBlockUseStatus Status)> _listingBlocks = [];
    private int? _blockToInsert;
    /// <summary>The description as written here, with text block placeholders; the form's "description" is its rendered text.</summary>
    private string _description = "", _savedDescription = "";
    private IReadOnlyList<AttributeProperty>? _attributeProperties;
    private bool _pushing, _notFound;
    private IReadOnlyList<(int Id, string Name)> _variationLists = [];
    private int? _fromList;
    private string? _fromListName;
    private IReadOnlyList<EtsyShopManager.Web.Modules.Templates.VariationListLink> _links = [];
    private readonly Dictionary<long, int?> _linkPick = [];
    private readonly Dictionary<long, (EtsyShopManager.Web.Modules.Templates.VariationListLinkPreview? Preview, string? Error)> _linkPreview = [];
    private IDisposable? _live;
    private string? _skuPattern;
    private string? _savedSkuPattern;

    private TableSort<FieldChange> _changeSort = new();
    private readonly TableSort<ListingPush> _pushSort = new()
    {
        ["when"] = p => p.RequestedAtUtc,
        ["by"] = p => p.RequestedBy,
        ["status"] = p => PushLabel(p.Status),
        ["changed"] = p => ChangedLabels(p),
    };

    protected override async Task OnInitializedAsync()
    {
        // The change values sort by what the table shows (lookup names, not ids).
        _changeSort = new()
        {
            ["field"] = c => c.Label,
            ["from"] = c => _lookups?.Describe(c.Key, c.From),
            ["to"] = c => _lookups?.Describe(c.Key, c.To),
        };
        await LoadAsync();
        // Reload when a push, import or refill for this shop finishes (the page shows the result).
        _live = JobEvents.Subscribe(c => c.IsFinal && c.ShopId == _snapshot?.Listing.ShopId
                                         && c.JobType is PushListingJob.Type or ImportShopListingsJob.Type,
            _ => InvokeAsync(async () => { await LoadAsync(keepForm: Unsaved); StateHasChanged(); }));
    }

    private async Task LoadAsync(bool keepForm = false)
    {
        _snapshot = await Editor.LoadAsync(Id);
        if (_snapshot is null) { _notFound = true; return; }
        var model = _snapshot.Model;
        await using var db = await DbFactory.CreateDbContextAsync();
        var categoryIds = new[] { model.Etsy["taxonomy_id"], model.Local("taxonomy_id") }
            .Where(v => v is not null).Select(v => (long)v!);
        _lookups = await EditorLookups.LoadAsync(db, _snapshot.Listing.ShopId, categoryIds, _snapshot.Listing.CurrencyCode);
        _allBlocks = await TextBlocks.AllAsync();
        _listingBlocks = await TextBlocks.ForListingAsync(Id);
        _variationLists = [.. (await db.VariationLists.AsNoTracking().OrderBy(v => v.Name).Select(v => new { v.Id, v.Name }).ToListAsync())
            .Select(v => (v.Id, v.Name))];
        _links = await VariationLists.ListingLinksAsync(Id);
        if (keepForm && _form is not null) return;
        _form = model.LocalState();
        _description = _savedDescription = await TextBlocks.SourceAsync(Id);
        _skuPattern = _savedSkuPattern = _snapshot.Listing.SkuPattern;
        _category = Long("taxonomy_id") is { } t ? new CategoryOption(t, _lookups.Categories.GetValueOrDefault(t, $"#{t}")) : null;
        _attributeProperties = await AttributeEditor.LoadAsync(db, Long("taxonomy_id"));
    }

    private static string BlockStatus(EtsyShopManager.Web.Modules.Templates.TextBlockUseStatus s) => s switch
    {
        EtsyShopManager.Web.Modules.Templates.TextBlockUseStatus.WillChange => "the template changed; apply it from the template's page",
        _ => "changed on Etsy",
    };

    private (string Text, IReadOnlyList<string> Unknown) RenderDescription(string source)
    {
        if (_form is null || _snapshot is null) return (source, []);
        var blocks = _allBlocks.ToDictionary(b => b.Slug, b => b.Text);
        var context = new PlaceholderContext(
            _snapshot.Listing.Shop ?? new Shop { Name = "" },
            _form,
            _snapshot.Listing.Skus,
            blocks);
        return PlaceholderEngine.Render(source, context);
    }

    private IReadOnlyList<string> DescriptionUnknown => RenderDescription(_description).Unknown;

    private string? DescriptionHelp => DescriptionUnknown.Count > 0
        ? $"No text template called {string.Join(", ", DescriptionUnknown.Select(EtsyShopManager.Web.Modules.Templates.TextBlockMarkup.Token))}. Fix the placeholder or create the template."
        : PlaceholderEngine.HasPlaceholders(_description)
            ? $"Text templates show as placeholders here and are filled in on Etsy; their text is changed on the template's page. {Pending("description")}"
            : Pending("description");

    /// <summary>The description as written (placeholders kept); the form gets the text Etsy will show.</summary>
    private void SetDescription(string? source)
    {
        _description = (source ?? "").Replace("\r\n", "\n");
        SetStr("description", RenderDescription(_description).Text);
    }

    /// <summary>Puts the block's placeholder where the cursor is (or replaces the selection) in the description.</summary>
    private async Task InsertBlockAsync()
    {
        if (_blockToInsert is not { } blockId || _allBlocks.FirstOrDefault(b => b.Id == blockId) is not { } block) return;
        var token = EtsyShopManager.Web.Modules.Templates.TextBlockMarkup.Token(block.Slug);
        var value = await Js.InvokeAsync<string?>("esm.insertAtSelection", "esm-description", token);
        SetDescription(value ?? (_description.Length == 0 ? token : $"{_description.TrimEnd()}\n\n{token}"));
        _blockToInsert = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Every render: the description field appears once the listing has loaded.
        if (_form is not null) await Js.InvokeVoidAsync("esm.trackSelection", "esm-description");
    }

    private string AttributeName(long id) =>
        _lookups!.AttributeProperties?.ContainsKey(id) == true ? _lookups.AttributeName(id)
            : _snapshot!.Listing.Attributes.FirstOrDefault(a => a.PropertyId == id)?.PropertyName ?? $"Property {id}";

    // ---- Form values (the local version as managed-state JSON) ----

    private string? Str(string key) => (string?)_form![key];
    private bool Bool(string key) => (bool?)_form![key] ?? false;
    private long? Long(string key) => (long?)_form![key];
    private decimal? Dec(string key) => (decimal?)_form![key];
    private string List(string key) => string.Join(", ", (_form![key]?.AsArray() ?? []).Select(v => (string?)v));
    private int Count(string key) => _form![key]?.AsArray().Count ?? 0;
    private IReadOnlyCollection<long> Partners => [.. (_form!["production_partner_ids"]?.AsArray() ?? []).Select(v => (long)v!)];

    private void Set(string key, JsonNode? value) { _form![key] = value; _preview = null; }

    /// <summary>The page has edits not saved to the draft yet: anything that differs from the draft, so an edit typed back
    /// to what it was isn't one.</summary>
    private bool Unsaved => _snapshot is { } s && _form is not null
        && (_description != _savedDescription
            || _skuPattern != _savedSkuPattern
            || ListingFields.All.Any(f => f.Editable && !JsonNode.DeepEquals(_form[f.Key], s.Model.Local(f.Key))));

    /// <summary>Cancel: back to the saved draft (Discard changes is the one that goes back to what's on Etsy).</summary>
    private async Task CancelEditsAsync()
    {
        _skuPattern = _savedSkuPattern;
        await LoadAsync();
        _preview = null;
    }
    private void RefreshRenderedDescriptionIfPlaceholders()
    {
        if (_form is not null && PlaceholderEngine.HasPlaceholders(_description))
        {
            Set("description", JsonValue.Create(RenderDescription(_description).Text));
        }
    }

    private void SetStr(string key, string? v)
    {
        Set(key, v is null ? null : JsonValue.Create(v));
        if (key != "description") RefreshRenderedDescriptionIfPlaceholders();
    }
    private void SetBool(string key, bool v) => Set(key, JsonValue.Create(v));
    private void SetLong(string key, long? v) => Set(key, v is null ? null : JsonValue.Create(v.Value));
    private void SetDec(string key, decimal? v)
    {
        Set(key, v is null ? null : JsonValue.Create(v.Value));
        RefreshRenderedDescriptionIfPlaceholders();
    }
    private void SetPartners(IReadOnlyCollection<long>? ids) => Set("production_partner_ids", new JsonArray([.. (ids ?? []).Select(i => (JsonNode)i)]));

    private void SetList(string key, string? text)
    {
        Set(key, new JsonArray([.. (text ?? "").Split(',').Select(t => t.Trim()).Where(t => t.Length > 0).Select(t => (JsonNode)t)]));
        RefreshRenderedDescriptionIfPlaceholders();
    }

    private async Task SetCategory(CategoryOption? c)
    {
        _category = c;
        if (c is null) return;
        SetLong("taxonomy_id", c.Id);
        // The attributes on offer are the new category's.
        await using var db = await DbFactory.CreateDbContextAsync();
        _attributeProperties = await AttributeEditor.LoadAsync(db, c.Id);
    }

    private async Task<IEnumerable<CategoryOption>> SearchCategoriesAsync(string text, CancellationToken ct)
    {
        await using var db = await DbFactory.CreateDbContextAsync(ct);
        var pattern = "%" + (text ?? "").Trim().Replace("\\", "\\\\").Replace("%", "\\%").Replace("_", "\\_") + "%";
        return await db.TaxonomyNodes.Where(n => !n.HasChildren && EF.Functions.Like(n.FullPath, pattern, "\\"))
            .OrderBy(n => n.FullPath).Take(50).Select(n => new CategoryOption(n.Id, n.FullPath)).ToListAsync(ct);
    }

    // Prices and processing: products of the local inventory, in managed-state order.
    private JsonArray Products => _form![ListingFields.Inventory]?["products"]?.AsArray() ?? [];
    private bool PriceVaries => (_form![ListingFields.Inventory]?["price_on_property"]?.AsArray().Count ?? 0) > 0;
    private bool ProcessingVaries => (_form![ListingFields.Inventory]?["readiness_state_on_property"]?.AsArray().Count ?? 0) > 0;

    // The first row of each group that must share a price (or processing profile) is the one edited; the rest follow it.
    /// <summary>"One price applies to every variation." / "Variations with the same Size share a price."</summary>
    private string VariesNote(string onPropertyKey, string what) =>
        InventoryRules.PropertyNames(_form![ListingFields.Inventory]!, onPropertyKey, InventoryRules.Names(_snapshot!.Listing)) is { Length: > 0 } by
            ? (Products.All(p => p!["property_values"]!.AsArray().Count <= 1) ? "" : $"Variations with the same {by} share a {what}.")
            : $"One {what} applies to every variation.";

    private bool Leads(int index, string onPropertyKey) =>
        InventoryRules.Linked(_form![ListingFields.Inventory]!, index, onPropertyKey)[0] == index;

    private static decimal Price(JsonNode offering) =>
        (decimal)((long?)offering["price_amount"] ?? 0) / ((int?)offering["price_divisor"] is int d && d > 0 ? d : 100);

    private void SetPrice(int index, decimal price)
    {
        var inventory = _form![ListingFields.Inventory]!.DeepClone();
        // Every variation sharing the values the price varies by gets the price (all of them when it varies by nothing).
        var linked = InventoryRules.Linked(inventory, index, "price_on_property");
        foreach (var (product, i) in inventory["products"]!.AsArray().Select((p, i) => (p!, i)))
        {
            if (!linked.Contains(i)) continue;
            var offering = product["offerings"]![0]!;
            var divisor = (int?)offering["price_divisor"] is int d && d > 0 ? d : 100;
            offering["price_amount"] = (long)Math.Round(price * divisor);
        }
        Set(ListingFields.Inventory, inventory);
    }

    private void SetProcessing(int index, long? readiness)
    {
        var inventory = _form![ListingFields.Inventory]!.DeepClone();
        var linked = InventoryRules.Linked(inventory, index, "readiness_state_on_property");
        foreach (var (product, i) in inventory["products"]!.AsArray().Select((p, i) => (p!, i)))
        {
            if (!linked.Contains(i)) continue;
            product["offerings"]![0]!["readiness_state_id"] = readiness is null ? null : JsonValue.Create(readiness.Value);
        }
        Set(ListingFields.Inventory, inventory);
    }

    /// <summary>"Unpushed" under a field whose local value differs from Etsy's.</summary>
    private string? Pending(string key) =>
        _snapshot is { } s && !JsonNode.DeepEquals(_form![key], s.Model.Etsy[key]) ? "Not on Etsy yet." : null;

    // ---- Actions ----

    private async Task<string?> User() => (await AuthState).User.Identity?.Name;

    private async Task SaveAsync()
    {
        var model = _snapshot!.Model;
        // The description goes through the text blocks (it keeps its placeholders); everything else straight to the draft.
        var changes = ListingFields.All.Where(f => f.Editable && f.Key != "description" && !JsonNode.DeepEquals(_form![f.Key], model.Local(f.Key)))
            .ToDictionary(f => f.Key, f => _form![f.Key]?.DeepClone());
        if (changes.Count > 0) await Editor.SaveAsync(Id, changes, await User());
        if (_description != _savedDescription || !JsonNode.DeepEquals(_form!["description"], model.Local("description")))
            await TextBlocks.SaveDescriptionAsync(Id, _description, await User());
        if (_skuPattern != _savedSkuPattern)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.Listings.FirstOrDefaultAsync(l => l.Id == Id);
            if (entity is not null)
            {
                entity.SkuPattern = string.IsNullOrWhiteSpace(_skuPattern) ? null : _skuPattern.Trim();
                await db.SaveChangesAsync();
            }
            _savedSkuPattern = _skuPattern;
        }
        await LoadAsync();
        Snackbar.Add("Draft saved. Nothing has been sent to Etsy.", Severity.Success);
    }

    private async Task PickFromListAsync(int? listId)
    {
        _fromList = listId;
        if (listId is { } id) _fromListName = await VariationLists.SuggestedVariationNameAsync(id);
    }

    private async Task AddFromListAsync()
    {
        if (Unsaved) await SaveAsync();
        var (plan, error) = await VariationLists.AddToListingAsync(_fromList!.Value, Id, _fromListName ?? "", await User());
        if (error is not null) { Snackbar.Add(error, Severity.Warning); return; }
        (_fromList, _fromListName, _preview) = (null, null, null);
        await LoadAsync();
        Snackbar.Add($"{plan!.VariationName} added with {plan.Values.Count} options ({plan.Combinations} combinations) as an unpushed edit.", Severity.Success);
    }

    private async Task PickLinkAsync(long propertyId, int? listId)
    {
        _linkPick[propertyId] = listId;
        if (listId is null) { _linkPreview.Remove(propertyId); return; }
        var result = await VariationLists.PreviewLinkAsync(listId.Value, Id, propertyId);
        // The link is checked against the saved draft; a variation added on this page isn't there until it's saved.
        _linkPreview[propertyId] = result.Error is not null && Unsaved ? (null, "Save the draft first, then link this variation.") : result;
    }

    private async Task LinkListAsync(long propertyId)
    {
        if (Unsaved) await SaveAsync();
        var error = await VariationLists.LinkVariationAsync(_linkPick[propertyId]!.Value, Id, propertyId, await User());
        if (error is not null) { Snackbar.Add(error, Severity.Warning); return; }
        var changes = _linkPreview[propertyId].Preview!.Changes.Count;
        _linkPick.Remove(propertyId);
        _linkPreview.Remove(propertyId);
        await LoadAsync();
        Snackbar.Add(changes > 0 ? "Linked. Use Apply template now (or Apply on the template's page) to bring it in line with the template." : "Linked.", Severity.Success);
    }

    private async Task ApplyLinkedAsync(EtsyShopManager.Web.Modules.Templates.VariationListLink link)
    {
        if (Unsaved) await SaveAsync();
        var changed = await VariationLists.ApplyAsync(link.ListId, await User(), listingId: Id);
        _preview = null;
        await LoadAsync();
        Snackbar.Add(changed > 0 ? $"{link.ListName} applied as unpushed edits; review and push when you're ready." : $"Already in line with {link.ListName}.",
            Severity.Success);
    }

    private async Task UnlinkListAsync(EtsyShopManager.Web.Modules.Templates.VariationListLink link)
    {
        if (Unsaved) await SaveAsync();
        await VariationLists.UnlinkAsync(link.ListId, Id, await User());
        await LoadAsync();
        Snackbar.Add($"Unlinked from {link.ListName}; the values stay as they are.", Severity.Success);
    }

    private async Task ReviewAsync()
    {
        if (Unsaved) await SaveAsync();
        _preview = await Editor.PreviewAsync(Id);
    }

    private async Task PushAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Push to Etsy",
            $"Send {_preview!.Changes.Count} change{(_preview.Changes.Count == 1 ? "" : "s")} to the live listing on Etsy? " +
            "A snapshot of the current Etsy version is kept so you can restore it.",
            yesText: "Push to Etsy", cancelText: "Cancel");
        if (confirmed != true) return;
        _pushing = true;
        try
        {
            var (pushId, blockers) = await Editor.RequestPushAsync(Id, await User());
            if (pushId is null) { Snackbar.Add(string.Join(" ", blockers), Severity.Warning); return; }
            Snackbar.Add("Pushing to Etsy…", Severity.Info);
            _preview = null;
            await LoadAsync();
        }
        finally { _pushing = false; }
    }

    private async Task RefreshFromEtsyAsync()
    {
        var id = await ImportQueue.ImportShopAsync(_snapshot!.Listing.ShopId, force: false, await User());
        Snackbar.Add(id is null ? "An import for this shop is already queued" : "Refreshing this shop's listings from Etsy…", Severity.Info);
    }

    private async Task ResolveAsync(string key, DriftResolution resolution)
    {
        await Editor.ResolveDriftAsync(Id, key, resolution, await User());
        await LoadAsync();
        _preview = null;
    }

    private async Task DiscardAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Discard changes",
            "Discard all edits that haven't been pushed? The listing goes back to what's on Etsy.",
            yesText: "Discard", cancelText: "Cancel");
        if (confirmed != true) return;
        await Editor.DiscardAsync(Id, null, await User());
        await LoadAsync();
        _preview = null;
    }

    private async Task RestoreAsync(int snapshotId)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Restore a previous version",
            "Load the version Etsy had before that push into your draft? Nothing is sent until you review and push.",
            yesText: "Load into draft", cancelText: "Cancel");
        if (confirmed != true) return;
        await Editor.RestoreSnapshotAsync(snapshotId, await User());
        await LoadAsync();
        _preview = await Editor.PreviewAsync(Id);
    }

    private static string PushLabel(ListingPushStatus s) => s switch
    {
        ListingPushStatus.Pending => "Queued",
        ListingPushStatus.Running => "Pushing",
        ListingPushStatus.Succeeded => "Pushed",
        ListingPushStatus.PartlyApplied => "Partly applied",
        _ => "Failed",
    };

    private static Color PushColor(ListingPushStatus s) => s switch
    {
        ListingPushStatus.Succeeded => Color.Success,
        ListingPushStatus.Failed => Color.Error,
        ListingPushStatus.PartlyApplied => Color.Warning,
        _ => Color.Info,
    };

    private static string ChangedLabels(ListingPush p)
    {
        try
        {
            return string.Join(", ", (JsonNode.Parse(p.ChangesJson)?.AsArray() ?? []).Select(c => (string?)c!["label"]));
        }
        catch (System.Text.Json.JsonException) { return ""; }
    }

    public void Dispose() => _live?.Dispose();
}
