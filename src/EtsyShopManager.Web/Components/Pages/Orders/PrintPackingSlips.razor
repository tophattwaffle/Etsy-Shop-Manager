@page "/orders/print/slips"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout EtsyShopManager.Web.Components.Layout.PrintLayout
@using EtsyShopManager.Core.Domain
@using EtsyShopManager.Web.Modules.Orders
@inject OrderPrintService Print
@inject SlipLayoutService Layouts

@* Static SSR printout: one slip per selected order, each on its own page. Each shop prints its own layouts (Packing slips
   page): the packing slip for ordinary orders and the gift slip (no prices) for gift orders, the built-in ones like
   Etsy's unless the shop was given others. Read-only: nothing is marked shipped. *@
<PageTitle>Packing slips · Etsy Shop Manager</PageTitle>

@if (_slips.Count == 0)
{
    <p class="print-empty">No orders selected. Choose orders on the Orders page, then print packing slips.</p>
}
else
{
    <div class="print-sheet">
        @* Each layout's CSS reaches only its own slips (nested under .slip-layout-{key}). *@
        <style>@((MarkupString)_css)</style>
        @foreach (var (key, html) in _slips)
        {
            <div class="slip-page slip-layout-@key">@((MarkupString)html)</div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery] private string? Ids { get; set; }

    private readonly List<(string Key, string Html)> _slips = [];
    private string _css = "";

    protected override async Task OnInitializedAsync()
    {
        var orders = await Print.GetOrdersAsync(OrderPrintService.ParseIds(Ids));
        var shopIds = orders.Select(o => o.ShopId).Distinct().ToList();
        var shops = await Print.GetShopSettingsAsync(shopIds);
        var layouts = await Layouts.ResolveAsync(shopIds);

        var used = new Dictionary<string, SlipLayout>();
        foreach (var o in orders)
        {
            var layout = layouts[(o.ShopId, o.IsGift ? SlipKind.Gift : SlipKind.Packing)];
            var key = SlipLayoutService.ScopeKey(layout);
            used.TryAdd(key, layout);
            _slips.Add((key, await SlipRenderer.RenderAsync(layout.Html, SlipModel.For(o, shops[o.ShopId]))));
        }
        _css = string.Join("\n", used.Select(u => SlipRenderer.ScopedCss(u.Key, u.Value.Css)));
    }
}
