@page "/orders"
@attribute [Authorize]
@using System.Text.Json.Nodes
@using EtsyShopManager.Web.Modules.Listings
@using EtsyShopManager.Web.Components.Pages.Listings
@using EtsyShopManager.Web.Modules.Orders
@using EtsyShopManager.Core.Jobs
@implements IDisposable
@inject OrderQueries Queries
@inject OrderPollQueue PollQueue
@inject TimeProvider Time
@inject ISnackbar Snackbar
@inject IJobEvents JobEvents
@inject OrderColorService Colors
@inject EtsyShopManager.Web.Modules.Shops.ShopAccentService ShopAccents
@inject EtsyShopManager.Web.Modules.Shops.ShopOrderLinkService ShopOrderLinks
@inject IJSRuntime Js
@inject IDialogService Dialogs
@inject OrderMadeService MadeItems

<PageTitle>Orders · Etsy Shop Manager</PageTitle>

<PageHeader Title="Orders">
    <Actions>
        <AuthorizeView Roles="@Roles.Admin">
            <MudButton Variant="Variant.Text" Href="admin/order-colors" StartIcon="@Icons.Material.Filled.Palette">Order colors</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<div class="esm-orders">

@* The tabs come first; each tab's shop picker, sync status and filters sit in the panel beside it (above it, folded, on phones). *@
<MudTabs Elevation="0" Outlined="true" Rounded="true" TabPanelsClass="pa-4" KeepPanelsAlive="true">
    <MudTabPanel Text="@($"Open ({_open.Count})")">
        <div class="lp-layout @(_railCollapsed ? "is-rail-collapsed" : "")">
        <section class="lp-main" aria-label="Open orders">
        @if (_open.Count == 0)
        {
            <MudText Class="muted">No open orders. 🎉</MudText>
        }
        else
        {
            @* One row whatever the width: short labels, and the print actions as icon buttons with their names on hover. *@
            <div class="lp-toolbar esm-order-actions">
                @if (_openFilter.IsFiltered)
                {
                    <span class="muted small">@_shown.Count of @_open.Count</span>
                }
                <MudTooltip Text="@(_openFilter.IsFiltered ? "Select all shown orders" : "Select all unshipped orders")">
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="SelectAllOpen" Disabled="@(_shown.Count == 0)">Select all</MudButton>
                </MudTooltip>
                <MudSpacer />
                @PrintActions(Picked.Count, PrintLink, () => _picked.Clear())
            </div>
        @if (_shown.Count == 0)
        {
            <MudStack Spacing="2" AlignItems="AlignItems.Start">
                <MudText Class="muted">No open orders match these filters.</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClearOpenFilters">Clear filters</MudButton>
            </MudStack>
        }
        <div class="order-grid">
            @foreach (var o in _shown)
            {
                @OrderCard(o, history: false)
            }
        </div>
        }
        </section>
        @FilterRail(OpenTab)
        </div>
    </MudTabPanel>

    <MudTabPanel Text="@($"To make ({_toMake.Sum(r => r.Left)})")">
        <div class="lp-layout @(_railCollapsed ? "is-rail-collapsed" : "")">
        <section class="lp-main" aria-label="Items to make">
        @if (_toMake.Count == 0)
        {
            <MudText Class="muted">Nothing to make.</MudText>
        }
        else
        {
            @if (_toMake.Sum(r => r.Made) is var made and > 0)
            {
                <div class="lp-toolbar">
                    <span class="muted small">@made of @_toMake.Sum(r => r.Quantity) made. Marking here marks the order items too.</span>
                </div>
            }
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <SortHeader Sort="_toMakeSort" Column="made" Changed="StateHasChanged">Made</SortHeader>
                        <SortHeader Sort="_toMakeSort" Column="qty" Changed="StateHasChanged" Class="text-right">Qty</SortHeader>
                        <SortHeader Sort="_toMakeSort" Column="item" Changed="StateHasChanged">Item</SortHeader>
                        <SortHeader Sort="_toMakeSort" Column="variations" Changed="StateHasChanged">Variations</SortHeader>
                        <SortHeader Sort="_toMakeSort" Column="personalization" Changed="StateHasChanged">Personalization</SortHeader>
                        <SortHeader Sort="_toMakeSort" Column="shipby" Changed="StateHasChanged">Earliest ship-by</SortHeader>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var make in _toMakeSort.Apply(_toMake))
                    {
                        var row = make.Row;
                        <tr class="@(make.IsMade ? "is-made" : "")">
                            <td>
                                <MadeToggle Made="@make.Made" Quantity="@make.Quantity" Labelled="false" ReadOnly="@(!_canMark)" What="@ShortTitle((string?)row["title"])"
                                            MadeChanged="@(m => SetMadeAsync(make.Items, m))" />
                            </td>
                            <td class="text-right"><b>@make.Quantity</b></td>
                            <td>
                                <div class="esm-make-item">
                                    @if (make.ImageUrl is { } photo) { <img class="esm-make-photo" src="@photo" alt="" loading="lazy" /> } else { <span class="esm-make-photo"></span> }
                                    <span class="esm-made-text">@ShortTitle((string?)row["title"])</span>
                                </div>
                            </td>
                            <td>
                                @* One pill per variation, as on the order cards (one long pill wrapped into a circle on phones). *@
                                <div class="order-vars">
                                    @foreach (var v in row["variations"]?.AsArray().Select(n => n!.AsObject()) ?? [])
                                    {
                                        if ((string?)v["value"] is { Length: > 0 } value)
                                        {
                                            <ColorBox Text="@value" Title="@((string?)v["property"])" Seed="@($"make|{(string?)row["listing_id"]}|{value}")" />
                                        }
                                    }
                                </div>
                            </td>
                            <td>@if ((string?)row["personalization"] is { Length: > 0 } note) { <ColorBox Text="@note" Kind="@ColorBox.Note" Seed="@($"make|{note}")" /> }</td>
                            <td>@(row["ship_by_ts"] is { } ts ? ListingFormat.Local(DateTime.UnixEpoch.AddSeconds((long)ts), "ddd MMM d") : "—")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        </section>
        @FilterRail(ToMakeTab)
        </div>
    </MudTabPanel>

    <MudTabPanel Text="History">
        <div class="lp-layout @(_railCollapsed ? "is-rail-collapsed" : "")">
        <section class="lp-main" aria-label="Order history">
            @* The same cards as the Open tab, a page at a time (searched, filtered and sorted by the server). *@
            <div class="lp-toolbar">
                <MudTextField T="string" Value="_historyText" ValueChanged="OnHistoryTextChanged" Placeholder="Search buyer, item, SKU or receipt #"
                              Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="lp-search" aria-label="Search order history" />
            </div>
            <div class="lp-toolbar esm-order-actions">
                <MudTooltip Text="@(AllHistoryRowsPicked ? "Unselect the orders on this page" : "Select the orders on this page")">
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => PickHistoryPage(!AllHistoryRowsPicked)" Disabled="@(_historyRows.Count == 0)">
                        @(AllHistoryRowsPicked ? "Unselect page" : "Select page")
                    </MudButton>
                </MudTooltip>
                <MudSpacer />
                @PrintActions(_historyPicked.Count, HistoryPrintLink, () => _historyPicked.Clear())
            </div>
            @if (_historyRows.Count == 0)
            {
                <MudText Class="muted">
                    @(string.IsNullOrWhiteSpace(_historyText) && !_historyGifts ? "No orders yet. The first poll pulls the shop's order history." : "No orders match.")
                </MudText>
            }
            <div class="order-grid">
                @foreach (var o in _historyRows)
                {
                    @OrderCard(o, history: true)
                }
            </div>
            @if (_historyTotal > 0)
            {
                <div class="lp-pager">
                    <span class="lp-muted">@(_historyPage * HistoryPageSize + 1)–@(_historyPage * HistoryPageSize + _historyRows.Count) of @_historyTotal.ToString("N0")</span>
                    <MudStack Row="true" Spacing="1">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(_historyPage == 0)" OnClick="() => HistoryPageAsync(_historyPage - 1)">Previous</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@((_historyPage + 1) * HistoryPageSize >= _historyTotal)"
                                   OnClick="() => HistoryPageAsync(_historyPage + 1)">Next</MudButton>
                    </MudStack>
                </div>
            }
        </section>
        @FilterRail(HistoryTab)
        </div>
    </MudTabPanel>
</MudTabs>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // Used when a shop has no profile image, or its colour can't be read (--esm-shop-fallback-N in app.css).
    private const int FallbackAccentCount = 4;

    private List<OrderShopStatus> _status = [];
    private Dictionary<int, string> _accents = [];
    private Dictionary<int, string> _orderLinks = [];
    private bool _accentsRequested;
    private int? _shopId;
    private List<Order> _open = [];
    private List<ToMakeRow> _toMake = [];

    private readonly TableSort<ToMakeRow> _toMakeSort = new()
    {
        ["made"] = r => (double)r.Made / r.Quantity,
        ["qty"] = r => r.Quantity,
        ["item"] = r => ShortTitle((string?)r.Row["title"]),
        ["variations"] = r => string.Join(" ", r.Row["variations"]?.AsArray().Select(v => (string?)v?["value"]) ?? []),
        ["personalization"] = r => (string?)r.Row["personalization"],
        ["shipby"] = r => (long?)r.Row["ship_by_ts"],
    };
    private const int HistoryPageSize = 48;
    private int _historyPage;
    private int _historyTotal;
    private bool _historyOldestFirst;
    private string? _historyText;
    private bool _historyGifts;
    private Timer? _timer;
    private IDisposable? _live;
    private JsonObject? _colorConfig;

    // Admins and Editors mark items made; Viewers see what is made.
    private bool _canMark;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _canMark = user.IsInRole(Roles.Admin) || user.IsInRole(Roles.Editor);
        _colorConfig = (await Colors.GetAsync()).ToCardJson();
        await LoadAsync();
        await LoadHistoryAsync();
        // Orders change when a check for orders runs (or a shop is (re)connected): reload then.
        _live = JobEvents.Subscribe(
            c => c.JobType == PollShopOrdersJob.Type || c.JobType == EtsyShopManager.Web.Modules.Shops.ShopRefreshJob.Type,
            _ => InvokeAsync(async () =>
            {
                await LoadAsync();
                await LoadHistoryAsync();
                StateHasChanged();
            }));
        // Items marked made in another browser (or on the dashboard): reload the open orders.
        MadeItems.Changed += OnMadeElsewhere;
        // Ship-by countdowns and "synced … ago" are relative to now: re-render every 30 s.
        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadAsync()
    {
        _status = await Queries.GetShopStatusAsync();
        var shopIds = _status.Select(s => s.ShopId).ToList();
        _accents = await ShopAccents.GetEffectiveAsync(shopIds);
        _orderLinks = await ShopOrderLinks.GetOverridesAsync(shopIds);
        _open = await Queries.GetOpenOrdersAsync(_shopId);
        _openFilter = _openFilter with { HomeCountries = await Queries.GetHomeCountriesAsync() };
        RefreshShown();
        _toMake = ToMakeList.Build(_open, TimeZoneInfo.Local);
    }

    // The order cards and the To make rows share the same OrderItem objects, so both tabs show the change at once. History
    // loads its own copies, so it is re-read after a change (and the open orders too when the change came from History).
    private async Task SetMadeAsync(IReadOnlyList<OrderItem> items, int made)
    {
        if (!_canMark) return;
        try
        {
            await MadeItems.SetMadeAsync(items, made, source: this);
            RefreshShown(); // an order that is now all made (or no longer) leaves a Made filter
            if (items.Any(i => _historyRows.Any(o => o.Items.Contains(i)))) await LoadAsync();
            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't save what's made: {ex.Message}", Severity.Error);
            await LoadAsync();
        }
    }

    private void OnMadeElsewhere(object? source)
    {
        if (ReferenceEquals(source, this)) return;
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            await LoadHistoryAsync();
            StateHasChanged();
        });
    }

    // Color the variation pills and personalization notes rendered by <ColorBox> (new or changed ones only),
    // and read any shop accent not yet cached from the shop's profile image.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await RailToggle.LoadAsync(Js))
        {
            _railCollapsed = true;
            StateHasChanged();
        }
        await Js.InvokeVoidAsync("esm.colorOrders", _colorConfig);
        if (_status.Count > 0 && !_accentsRequested)
        {
            _accentsRequested = true;
            var changed = false;
            foreach (var s in _status.Where(s => !_accents.ContainsKey(s.ShopId)))
            {
                if (await Js.InvokeAsync<string?>("esm.dominantColor", ShopIconCache.UrlFor(s.ShopId)) is { } color)
                {
                    _accents[s.ShopId] = color;
                    await ShopAccents.SaveAutomaticAsync(s.ShopId, color);
                    changed = true;
                }
            }
            if (changed) StateHasChanged();
        }
    }

    private string Accent(int shopId)
    {
        if (_accents.TryGetValue(shopId, out var color)) return color;
        var index = _status.FindIndex(s => s.ShopId == shopId);
        return $"var(--esm-shop-fallback-{Math.Max(0, index) % FallbackAccentCount})";
    }

    private string ShopStyle(int shopId) => $"--shop: {Accent(shopId)}";

    private string OrderUrl(int shopId, long receiptId) =>
        EtsyShopManager.Web.Modules.Shops.ShopOrderLinkService.FormatUrl(_orderLinks.GetValueOrDefault(shopId), receiptId);

    private string? OrderTarget(int shopId, long receiptId) =>
        EtsyShopManager.Web.Modules.Shops.ShopOrderLinkService.OpensInNewTab(OrderUrl(shopId, receiptId)) ? "_blank" : null;

    private async Task OnShopChanged(int? id)
    {
        _shopId = id;
        await LoadAsync();
        await HistoryPageAsync(0);
    }

    // History is paged by the server; a change of search, filter, sort or shop starts again at the first page.
    private async Task LoadHistoryAsync()
    {
        var (orders, total) = await Queries.GetHistoryAsync(_shopId, _historyText, _historyPage * HistoryPageSize, HistoryPageSize,
            sortBy: OrderQueries.HistorySort.Date, descending: !_historyOldestFirst, giftsOnly: _historyGifts);
        if (orders.Count == 0 && total > 0 && _historyPage > 0)
        {
            // The page ran past the end (orders left the list): show the last page instead.
            _historyPage = (total - 1) / HistoryPageSize;
            await LoadHistoryAsync();
            return;
        }
        _historyRows = orders;
        _historyTotal = total;
    }

    private async Task HistoryPageAsync(int page)
    {
        _historyPage = Math.Max(0, page);
        await LoadHistoryAsync();
    }

    private async Task OnHistoryTextChanged(string? text)
    {
        _historyText = text;
        await HistoryPageAsync(0);
    }

    private async Task OnHistoryGiftsChanged(bool on)
    {
        _historyGifts = on;
        await HistoryPageAsync(0);
    }

    private async Task OnHistorySortChanged(bool oldestFirst)
    {
        _historyOldestFirst = oldestFirst;
        await HistoryPageAsync(0);
    }

    private async Task PollNowAsync()
    {
        var user = (await AuthState).User.Identity?.Name;
        var queued = 0;
        foreach (var s in _status.Where(s => s.IsHealthy && (_shopId is null || s.ShopId == _shopId)))
            if (await PollQueue.PollShopAsync(s.ShopId, user) is not null) queued++;
        Snackbar.Add(queued == 0 ? "A check is already queued" : "Checking Etsy for orders…", Severity.Info);
    }

    /// <summary>One order as a card: the Open tab's layout, used by History too (with the order's status pill in place of
    /// the ship-by pill).</summary>
    private RenderFragment OrderCard(Order o, bool history) => __builder =>
    {
        var due = OrderDue.For(o.ShipByUtc, Time.GetUtcNow().UtcDateTime);
        var (pillText, pillStyle) = history ? OrderDue.Status(o) : (due.Text, due.Style);
        var picked = history ? _historyPicked.Contains(o.Id) : _picked.Contains(o.Id);
        <div class="order-card @(!history && due.Urgent ? "urgent" : "")" style="@ShopStyle(o.ShopId)">
            <div class="order-head">
                <div class="order-pick">
                    <MudCheckBox T="bool" Value="@picked" ValueChanged="@(on => { if (history) PickHistory(o.Id, on); else Pick(o.Id, on); })" Dense="true"
                                 Size="Size.Small" aria-label="@($"Select order {o.EtsyReceiptId} to print")" />
                    <div>
                        <div class="order-buyer">
                            @(o.BuyerName ?? $"#{o.EtsyReceiptId}")
                            @if (o.IsGift) { <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-1">Gift</MudChip> }
                        </div>
                        <div class="muted small">
                            <a href="@OrderUrl(o.ShopId, o.EtsyReceiptId)" target="@OrderTarget(o.ShopId, o.EtsyReceiptId)">#@o.EtsyReceiptId</a>
                            · @o.Shop.Name · @ListingFormat.Local(o.EtsyCreatedAtUtc)
                        </div>
                        @if (OrderOverrides.Address(o) is { } shipTo)
                        {
                            <ChangedMark Caption="Address changed" Label="@AddressChangedLabel(o, shipTo)" />
                        }
                    </div>
                </div>
                <div class="text-right">
                    <span class="esm-due" style="@pillStyle">@pillText</span>
                    <div class="small muted">@OrderTotal(o)</div>
                    @if (o.IsOpen)
                    {
                        <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Editor}")">
                            <MudTooltip Text="Change personalization, variations or address">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => ChangeOrderAsync(o)"
                                               aria-label="@($"Change order {o.EtsyReceiptId}")" />
                            </MudTooltip>
                        </AuthorizeView>
                    }
                </div>
            </div>
            @foreach (var (i, ii) in o.Items.OrderBy(i => i.EtsyTransactionId).Select((item, index) => (item, index)))
            {
                var (variations, personalization) = Split(i);
                <div class="order-item @((!history || o.IsOpen) && i.UnitsMade >= i.UnitsToMake ? "is-made" : "")">
                    @if (!string.IsNullOrEmpty(i.ImageUrl))
                    {
                        <img src="@i.ImageUrl" alt="" loading="lazy" />
                    }
                    else
                    {
                        <div class="noimg"></div>
                    }
                    <div class="order-item-body">
                        <div><b>@(i.Quantity > 1 ? $"×{i.Quantity} " : "")</b>@ShortTitle(i.Title)</div>
                        @if (variations.Count > 0)
                        {
                            <div class="order-vars">
                                @foreach (var (v, vi) in variations.Select((v, n) => (v, n)))
                                {
                                    if (BuyersVariation(i, v) is { } buyers)
                                    {
                                        <span class="esm-changed">
                                            <ColorBox Text="@v.Value" Title="@v.Name" Seed="@($"{o.EtsyReceiptId}|{ii}.{vi}")" />
                                            <ChangedMark Label="@($"{v.Name} changed here. The buyer chose {buyers}.")" />
                                        </span>
                                    }
                                    else
                                    {
                                        <ColorBox Text="@v.Value" Title="@v.Name" Seed="@($"{o.EtsyReceiptId}|{ii}.{vi}")" />
                                    }
                                }
                            </div>
                        }
                        @if (i.PersonalizationOverride is not null)
                        {
                            var buyers = OrderOverrides.BuyersPersonalization(i);
                            <div class="esm-changed esm-changed-note">
                                @if (personalization is not null)
                                {
                                    <ColorBox Text="@personalization" Kind="@ColorBox.Note" Seed="@($"{o.EtsyReceiptId}|{ii}.note")" />
                                }
                                else
                                {
                                    <span class="muted small">No personalization</span>
                                }
                                <ChangedMark Label="@(buyers is null ? "Personalization changed here. The buyer entered none." : $"Personalization changed here. The buyer entered: {buyers}")" />
                            </div>
                        }
                        else if (personalization is not null)
                        {
                            <ColorBox Text="@personalization" Kind="@ColorBox.Note" Seed="@($"{o.EtsyReceiptId}|{ii}.note")" />
                        }
                        @if (i.Sku is not null) { <div class="muted small">SKU @i.Sku</div> }
                    </div>
                    @* Made marks are for orders still to send; History shows them only on orders that are still open. *@
                    @if (!history || o.IsOpen)
                    {
                        <MadeToggle Made="@i.UnitsMade" Quantity="@i.UnitsToMake" ReadOnly="@(!_canMark)" What="@ShortTitle(i.Title)"
                                    MadeChanged="@(made => SetMadeAsync([i], made))" />
                    }
                </div>
            }
            @if (o.MessageFromBuyer is not null)
            {
                <div class="order-message"><b>Note from buyer:</b> @o.MessageFromBuyer</div>
            }
            @if (o.IsGift)
            {
                <div class="order-message"><b>🎁 Gift</b>@(o.GiftMessage is null ? "" : $": {o.GiftMessage}")</div>
            }
        </div>
    };

    /// <summary>
    /// The right-hand end of an order list's toolbar: how many orders are selected (with a clear button) and the two print
    /// actions as icon buttons, their full names in tooltips, so the toolbar stays on one row.
    /// </summary>
    private RenderFragment PrintActions(int selected, Func<string, string> link, Action clear) => __builder =>
    {
        @if (selected > 0)
        {
            <span class="muted small">@selected selected</span>
            <MudTooltip Text="Clear the selection">
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="clear" aria-label="Clear the selection" />
            </MudTooltip>
        }
        <MudTooltip Text="Print pick list">
            <MudIconButton Icon="@Icons.Material.Filled.Checklist" Variant="Variant.Outlined" Size="Size.Small" Disabled="@(selected == 0)"
                           Href="@link("pick")" Target="_blank" aria-label="Print pick list" />
        </MudTooltip>
        <MudTooltip Text="Print packing slips">
            <MudIconButton Icon="@Icons.Material.Filled.Print" Variant="Variant.Outlined" Size="Size.Small" Disabled="@(selected == 0)"
                           Href="@link("slips")" Target="_blank" aria-label="Print packing slips" />
        </MudTooltip>
    };

    private const int OpenTab = 0, ToMakeTab = 1, HistoryTab = 2;

    // Phones only: the filter panel starts folded (on wider screens it is always open beside the list).
    private bool _filtersOpen;

    // Desktop only: the side panel folded to a strip (remembered per browser, see RailToggle).
    private bool _railCollapsed;

    /// <summary>
    /// The panel beside each tab: shop picker and sync status for every tab, then that tab's own sort and filters. Single
    /// choices are dropdowns and on/off filters are switches, so the two don't look alike.
    /// </summary>
    private RenderFragment FilterRail(int tab) => __builder =>
    {
        var active = ActiveFilterCount(tab);
        <aside class="lp-rail esm-filter-rail" aria-label="Shop and filters">
            <RailToggle Collapsed="_railCollapsed" CollapsedChanged="@(c => _railCollapsed = c)" />
            <button type="button" class="esm-filter-toggle" aria-expanded="@Pressed(_filtersOpen)" @onclick="() => _filtersOpen = !_filtersOpen">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
                <span class="esm-filter-toggle-label">Shop and filters</span>
                @if (active > 0) { <span class="lp-count">@active on</span> }
                <MudIcon Icon="@(_filtersOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
            </button>
            <div class="esm-filter-body @(_filtersOpen ? "is-open" : "")">
                @* The shop list from the Listings page: shop marks, open-order counts and each shop's sync status. *@
                <fieldset class="lp-facets">
                    <legend>Shop</legend>
                    <button type="button" class="lp-facet" aria-pressed="@Pressed(_shopId is null)" @onclick="() => OnShopChanged(null)">
                        <span class="lp-facet-label">All shops</span>
                        <span class="lp-count">@_status.Sum(s => s.OpenOrders).ToString("N0")</span>
                    </button>
                    @foreach (var s in _status)
                    {
                        <div class="lp-shop" style="@ShopStyle(s.ShopId)">
                            <button type="button" class="lp-facet" aria-pressed="@Pressed(_shopId == s.ShopId)" @onclick="() => OnShopChanged(s.ShopId)">
                                <ShopMark Name="@s.ShopName" Small="true" Decorative="true" IconShopId="@(s.HasIcon ? s.ShopId : null)" />
                                <span class="lp-facet-label">@s.ShopName</span>
                                <span class="lp-count">@s.OpenOrders.ToString("N0")</span>
                            </button>
                            <div class="lp-shop-status">
                                <MudTooltip Text="@StatusTooltip(s)">
                                    <span class="lp-status @(s.LastError is null ? "" : "lp-status-warn")">
                                        @(s.LastError is null ? $"Synced {Ago(s.LastPolledAtUtc)}" : "Last check failed")
                                    </span>
                                </MudTooltip>
                            </div>
                        </div>
                    }
                </fieldset>
                <fieldset class="esm-filter-group">
                    <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Editor}")">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="PollNowAsync"
                                   Class="align-self-start">
                            Check for orders now
                        </MudButton>
                    </AuthorizeView>
                </fieldset>

                @if (tab == OpenTab && _open.Count > 0)
                {
                    <fieldset class="esm-filter-group">
                        <legend>Sort by</legend>
                        <MudSelect T="string" Value="_openFilter.Sort" ValueChanged="OnOpenSortChanged" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   ToStringFunc="@SortLabel" aria-label="Sort open orders">
                            @foreach (var (key, label) in OpenOrderFilter.SortOptions)
                            {
                                <MudSelectItem T="string" Value="key">@label</MudSelectItem>
                            }
                        </MudSelect>
                    </fieldset>

                    @* Etsy's Seller app filters that apply to open orders and that the stored receipts can answer. *@
                    <fieldset class="esm-filter-group">
                        <legend>Filter</legend>
                        <MudSelect T="string" Value="_openFilter.Destination" ValueChanged="@(v => SetOpenFilter(_openFilter with { Destination = v }))"
                                   Label="Destination" Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="@DestinationLabel">
                            @foreach (var (key, label) in DestinationOptions)
                            {
                                <MudSelectItem T="string" Value="key">@label (@OpenCount(_openFilter with { Destination = key }))</MudSelectItem>
                            }
                        </MudSelect>
                        @if (_shippingMethods.Count > 0)
                        {
                            <MudSelect T="string" Value="_openFilter.Shipping" ValueChanged="@(v => SetOpenFilter(_openFilter with { Shipping = v }))"
                                       Label="Shipping method" Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="@(v => v ?? "Any")">
                                <MudSelectItem T="string" Value="null">Any (@OpenCount(_openFilter with { Shipping = null }))</MudSelectItem>
                                @foreach (var method in _shippingMethods)
                                {
                                    <MudSelectItem T="string" Value="method">@method (@OpenCount(_openFilter with { Shipping = method }))</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        @* The Made marks: orders ready to pack (every item made) or with something still to make. *@
                        <MudSelect T="string" Value="_openFilter.Made" ValueChanged="@(v => SetOpenFilter(_openFilter with { Made = v }))"
                                   Label="Made" Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="@MadeLabel">
                            @foreach (var (key, label) in MadeOptions)
                            {
                                <MudSelectItem T="string" Value="key">@label (@OpenCount(_openFilter with { Made = key }))</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSwitch T="bool" Value="_openFilter.HasNote" ValueChanged="@(on => SetOpenFilter(_openFilter with { HasNote = on }))"
                                   Color="Color.Primary" Label="@($"Has note from buyer ({OpenCount(_openFilter with { HasNote = true })})")" />
                        <MudSwitch T="bool" Value="_openFilter.Gift" ValueChanged="@(on => SetOpenFilter(_openFilter with { Gift = on }))"
                                   Color="Color.Primary" Label="@($"Marked as gift ({OpenCount(_openFilter with { Gift = true })})")" />
                        <MudSwitch T="bool" Value="_openFilter.Personalized" ValueChanged="@(on => SetOpenFilter(_openFilter with { Personalized = on }))"
                                   Color="Color.Primary" Label="@($"Personalized ({OpenCount(_openFilter with { Personalized = true })})")" />
                        @if (_openFilter.IsFiltered)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearOpenFilters" Class="align-self-start">Clear filters</MudButton>
                        }
                    </fieldset>
                }
                @if (tab == HistoryTab)
                {
                    <fieldset class="esm-filter-group">
                        <legend>Sort by</legend>
                        <MudSelect T="bool" Value="_historyOldestFirst" ValueChanged="OnHistorySortChanged" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   ToStringFunc="@(oldest => oldest ? "Oldest" : "Newest")" aria-label="Sort order history">
                            <MudSelectItem T="bool" Value="false">Newest</MudSelectItem>
                            <MudSelectItem T="bool" Value="true">Oldest</MudSelectItem>
                        </MudSelect>
                    </fieldset>
                    <fieldset class="esm-filter-group">
                        <legend>Filter</legend>
                        <MudSwitch T="bool" Value="_historyGifts" ValueChanged="OnHistoryGiftsChanged" Color="Color.Primary" Label="Gift orders only" />
                    </fieldset>
                }
            </div>
        </aside>
    };

    private int ActiveFilterCount(int tab) => (_shopId is null ? 0 : 1) + tab switch
    {
        OpenTab => new[] { _openFilter.Shipping is not null, _openFilter.Destination is not null, _openFilter.Made is not null, _openFilter.HasNote, _openFilter.Gift, _openFilter.Personalized }.Count(on => on),
        HistoryTab => _historyGifts ? 1 : 0,
        _ => 0,
    };

    private string DestinationLabel(string? key) => DestinationOptions.FirstOrDefault(o => o.Key == key).Label ?? "All";

    private static readonly (string? Key, string Label)[] MadeOptions =
        [(null, "Any"), (OpenOrderFilter.MadeStates.AllMade, "All made"), (OpenOrderFilter.MadeStates.ToMake, "Still to make")];

    private static string MadeLabel(string? key) => MadeOptions.FirstOrDefault(o => o.Key == key).Label ?? "Any";

    // Sort and filters of the Open tab (ship-by date first, as before); the To make tab still counts every open order.
    private OpenOrderFilter _openFilter = new();
    private List<Order> _shown = [];
    private List<string> _shippingMethods = [];

    private void RefreshShown()
    {
        _shown = _openFilter.Apply(_open);
        // A chosen method stays listed after its last order ships, so it can still be cleared.
        _shippingMethods = [.. _open.Select(OrderPrintService.ShippingMethod).Append(_openFilter.Shipping).OfType<string>()
            .Distinct().Order(StringComparer.OrdinalIgnoreCase)];
    }

    // As in Etsy's app: "United States" / "International" (or "Domestic" when the shops shown ship from different countries).
    private IEnumerable<(string? Key, string Label)> DestinationOptions
    {
        get
        {
            var homes = _status.Where(s => _shopId is null || s.ShopId == _shopId).Select(s => _openFilter.HomeCountry(s.ShopId)).Distinct().ToList();
            var domestic = homes.Count == 1 ? OrderPrintService.CountryName(homes[0]) ?? "Domestic" : "Domestic";
            return [(null, "All"), (OpenOrderFilter.Destinations.Domestic, domestic), (OpenOrderFilter.Destinations.International, "International")];
        }
    }

    private void SetOpenFilter(OpenOrderFilter filter)
    {
        _openFilter = filter;
        RefreshShown();
    }

    private void OnOpenSortChanged(string sort) => SetOpenFilter(_openFilter with { Sort = sort });

    private void ClearOpenFilters() => SetOpenFilter(new OpenOrderFilter { Sort = _openFilter.Sort, HomeCountries = _openFilter.HomeCountries });

    private int OpenCount(OpenOrderFilter filter) => _open.Count(filter.Matches);

    private static string Pressed(bool on) => on ? "true" : "false";

    private static string SortLabel(string? key) =>
        OpenOrderFilter.SortOptions.FirstOrDefault(s => s.Key == key).Label ?? "Ship by date";

    // Orders picked for printing (open orders shown by the filters only; one that ships or closes drops out on the next refresh).
    private readonly HashSet<int> _picked = [];
    private List<int> Picked => [.. _shown.Where(o => _picked.Contains(o.Id)).Select(o => o.Id)];

    private void Pick(int id, bool on)
    {
        if (on) _picked.Add(id); else _picked.Remove(id);
    }

    private void SelectAllOpen() => _picked.UnionWith(_shown.Select(o => o.Id));

    private string PrintLink(string kind) => $"orders/print/{kind}?ids={string.Join(",", Picked)}";

    // History orders picked for printing, of any status (reprints, and gift slips for orders already sent). Kept across
    // pages, searches and the gift filter, so orders can be gathered from several pages.
    private readonly HashSet<int> _historyPicked = [];
    private IReadOnlyList<Order> _historyRows = [];

    private bool AllHistoryRowsPicked => _historyRows.Count > 0 && _historyRows.All(o => _historyPicked.Contains(o.Id));

    private void PickHistory(int id, bool on)
    {
        if (on) _historyPicked.Add(id); else _historyPicked.Remove(id);
    }

    private void PickHistoryPage(bool on)
    {
        foreach (var o in _historyRows) PickHistory(o.Id, on);
    }

    private string HistoryPrintLink(string kind) => $"orders/print/{kind}?ids={string.Join(",", _historyPicked.Order())}";

    // Changes the buyer asked for after checkout (kept here only); the open orders reload so every view shows them.
    private async Task ChangeOrderAsync(Order o)
    {
        var dialog = await Dialogs.ShowAsync<OrderChangesDialog>($"Change order #{o.EtsyReceiptId}",
            new DialogParameters<OrderChangesDialog> { { d => d.OrderId, o.Id } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        if (await dialog.Result is { Canceled: false })
        {
            await LoadAsync();
            Snackbar.Add("Order changes saved", Severity.Success);
        }
    }

    private static string OneLine(ShippingAddress a) => string.Join(", ", a.Name is null ? a.Lines : a.Lines.Prepend(a.Name));

    private static string AddressChangedLabel(Order o, ShippingAddress shipTo) =>
        $"Ships to {OneLine(shipTo)}. The buyer's address on Etsy: {OneLine(OrderPrintService.EtsyAddress(o))}";

    /// <summary>The buyer's value when this variation was changed here, otherwise null.</summary>
    private static string? BuyersVariation(OrderItem i, OrderVariation shown) =>
        i.Variations.FirstOrDefault(b => b.PropertyId == shown.PropertyId && b.Name == shown.Name) is { } b
        && OrderOverrides.VariationOverride(i, b) is not null ? b.Value : null;

    // With the seller's changes (OrderOverrides), as everywhere else the order is shown.
    private static (List<OrderVariation> Variations, string? Personalization) Split(OrderItem i)
    {
        var all = OrderOverrides.Variations(i);
        var personalization = all.Where(v => v.PropertyId == HaPayloadBuilder.PersonalizationPropertyId && v.Value.Length > 0)
            .Select(v => v.Name.Length > 0 && !v.Name.Trim().Equals("personalization", StringComparison.OrdinalIgnoreCase) ? $"{v.Name}: {v.Value}" : v.Value)
            .ToList();
        return (all.Where(v => v.PropertyId != HaPayloadBuilder.PersonalizationPropertyId && v.Value.Length > 0).ToList(),
            personalization.Count == 0 ? null : string.Join(" | ", personalization));
    }

    private static string ShortTitle(string? title) => (title ?? "").Split('|')[0].Trim();

    private static string OrderTotal(Order o) =>
        o.Grandtotal is { } g ? ListingFormat.Price(g, o.Divisor, o.CurrencyCode)
        : ListingFormat.Price(o.Items.Sum(i => i.PriceAmount * Math.Max(1, i.Quantity)), o.Items.FirstOrDefault()?.PriceDivisor ?? 100, o.CurrencyCode);

    private string Ago(DateTime? utc)
    {
        if (utc is null) return "never";
        var minutes = (Time.GetUtcNow().UtcDateTime - utc.Value).TotalMinutes;
        return minutes < 1 ? "just now" : minutes < 60 ? $"{(int)minutes} min ago" : ListingFormat.Local(utc, "HH:mm");
    }

    private static string StatusTooltip(OrderShopStatus s) =>
        s.LastError ?? (s.BackfillDone ? $"Last checked {ListingFormat.Local(s.LastPolledAtUtc, "yyyy-MM-dd HH:mm:ss")}" : "First sync (order history) not finished yet");

    public void Dispose()
    {
        MadeItems.Changed -= OnMadeElsewhere;
        _live?.Dispose();
        _timer?.Dispose();
    }
}
