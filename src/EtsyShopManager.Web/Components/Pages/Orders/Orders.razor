@page "/orders"
@attribute [Authorize]
@using System.Text.Json.Nodes
@using EtsyShopManager.Web.Modules.Listings
@using EtsyShopManager.Web.Modules.Orders
@using EtsyShopManager.Core.Jobs
@implements IDisposable
@inject OrderQueries Queries
@inject OrderPollQueue PollQueue
@inject TimeProvider Time
@inject ISnackbar Snackbar
@inject IJobEvents JobEvents
@inject OrderColorService Colors
@inject EtsyShopManager.Web.Modules.Shops.ShopAccentService ShopAccents
@inject EtsyShopManager.Web.Modules.Shops.ShopOrderLinkService ShopOrderLinks
@inject IJSRuntime Js

<PageTitle>Orders · Etsy Shop Manager</PageTitle>

<PageHeader Title="Orders">
    <Actions>
        <AuthorizeView Roles="@Roles.Admin">
            <MudButton Variant="Variant.Text" Href="admin/order-colors" StartIcon="@Icons.Material.Filled.Palette">Order colors</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<div class="esm-orders">

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
        <MudSelect T="int?" Value="_shopId" ValueChanged="OnShopChanged" Label="Shop" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Class="esm-minw-md">
            <MudSelectItem T="int?" Value="null">All shops</MudSelectItem>
            @foreach (var s in _status)
            {
                <MudSelectItem T="int?" Value="s.ShopId">@s.ShopName</MudSelectItem>
            }
        </MudSelect>
        @foreach (var s in _status.Where(s => _shopId is null || s.ShopId == _shopId))
        {
            <MudTooltip Text="@StatusTooltip(s)">
                <MudChip T="string" Size="Size.Small" Color="@(s.LastError is null ? Color.Default : Color.Error)">
                    @s.ShopName: @s.OpenOrders open · synced @Ago(s.LastPolledAtUtc)
                </MudChip>
            </MudTooltip>
        }
        <MudSpacer />
        <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Editor}")">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="PollNowAsync">
                Check for orders now
            </MudButton>
        </AuthorizeView>
    </MudStack>
</MudPaper>

<MudTabs Elevation="0" Outlined="true" Rounded="true" TabPanelsClass="pa-4" KeepPanelsAlive="true">
    <MudTabPanel Text="@($"Open ({_open.Count})")">
        @if (_open.Count == 0)
        {
            <MudText Class="muted">No open orders. 🎉</MudText>
        }
        else
        {
        <div class="lp-layout">
        <section class="lp-main" aria-label="Open orders">
            <div class="lp-toolbar">
                <MudSelect T="string" Value="_openFilter.Sort" ValueChanged="OnOpenSortChanged" Variant="Variant.Outlined" Margin="Margin.Dense"
                           ToStringFunc="@SortLabel" Class="lp-sort" aria-label="Sort open orders">
                    @foreach (var (key, label) in OpenOrderFilter.SortOptions)
                    {
                        <MudSelectItem T="string" Value="key">@label</MudSelectItem>
                    }
                </MudSelect>
                @if (_openFilter.IsFiltered)
                {
                    <span class="muted small">@_shown.Count of @_open.Count orders</span>
                }
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="SelectAllOpen" Disabled="@(_shown.Count == 0)">
                    @(_openFilter.IsFiltered ? "Select all shown" : "Select all unshipped")
                </MudButton>
                @if (Picked.Count > 0)
                {
                    <span class="muted small">@Picked.Count selected</span>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _picked.Clear()">Clear</MudButton>
                }
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Checklist"
                           Disabled="@(Picked.Count == 0)" Href="@PrintLink("pick")" Target="_blank">Print pick list</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Print"
                           Disabled="@(Picked.Count == 0)" Href="@PrintLink("slips")" Target="_blank">Print packing slips</MudButton>
            </div>
        @if (_shown.Count == 0)
        {
            <MudStack Spacing="2" AlignItems="AlignItems.Start">
                <MudText Class="muted">No open orders match these filters.</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClearOpenFilters">Clear filters</MudButton>
            </MudStack>
        }
        <div class="order-grid">
            @foreach (var o in _shown)
            {
                var due = OrderDue.For(o.ShipByUtc, Time.GetUtcNow().UtcDateTime);
                <div class="order-card @(due.Urgent ? "urgent" : "")" style="@ShopStyle(o.ShopId)">
                    <div class="order-head">
                        <div class="order-pick">
                            <MudCheckBox T="bool" Value="@_picked.Contains(o.Id)" ValueChanged="@(on => Pick(o.Id, on))" Dense="true"
                                         Size="Size.Small" aria-label="@($"Select order {o.EtsyReceiptId} to print")" />
                            <div>
                                <div class="order-buyer">
                                    @(o.BuyerName ?? $"#{o.EtsyReceiptId}")
                                    @if (o.IsGift) { <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-1">Gift</MudChip> }
                                </div>
                                <div class="muted small">
                                    <a href="@OrderUrl(o.ShopId, o.EtsyReceiptId)" target="@OrderTarget(o.ShopId, o.EtsyReceiptId)">#@o.EtsyReceiptId</a>
                                    · @o.Shop.Name · @ListingFormat.Local(o.EtsyCreatedAtUtc)
                                </div>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="esm-due" style="@due.Style">@due.Text</span>
                            <div class="small muted">@OrderTotal(o)</div>
                        </div>
                    </div>
                    @foreach (var (i, ii) in o.Items.OrderBy(i => i.EtsyTransactionId).Select((item, index) => (item, index)))
                    {
                        var (variations, personalization) = Split(i);
                        <div class="order-item">
                            @if (!string.IsNullOrEmpty(i.ImageUrl))
                            {
                                <img src="@i.ImageUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <div class="noimg"></div>
                            }
                            <div class="order-item-body">
                                <div><b>@(i.Quantity > 1 ? $"×{i.Quantity} " : "")</b>@ShortTitle(i.Title)</div>
                                @if (variations.Count > 0)
                                {
                                    <div class="order-vars">
                                        @foreach (var (v, vi) in variations.Select((v, n) => (v, n)))
                                        {
                                            <ColorBox Text="@v.Value" Title="@v.Name" Seed="@($"{o.EtsyReceiptId}|{ii}.{vi}")" />
                                        }
                                    </div>
                                }
                                @if (personalization is not null)
                                {
                                    <ColorBox Text="@personalization" Kind="@ColorBox.Note" Seed="@($"{o.EtsyReceiptId}|{ii}.note")" />
                                }
                                @if (i.Sku is not null) { <div class="muted small">SKU @i.Sku</div> }
                            </div>
                        </div>
                    }
                    @if (o.MessageFromBuyer is not null)
                    {
                        <div class="order-message"><b>Note from buyer:</b> @o.MessageFromBuyer</div>
                    }
                    @if (o.IsGift)
                    {
                        <div class="order-message"><b>🎁 Gift</b>@(o.GiftMessage is null ? "" : $": {o.GiftMessage}")</div>
                    }
                </div>
            }
        </div>
        </section>

        @* Etsy's Seller app filters that apply to open orders and that the stored receipts can answer. *@
        <aside class="lp-rail" aria-label="Filters">
            <fieldset class="lp-facets">
                <legend>Show only</legend>
                <button type="button" class="lp-facet" aria-pressed="@Pressed(_openFilter.HasNote)"
                        @onclick="() => SetOpenFilter(_openFilter with { HasNote = !_openFilter.HasNote })">
                    <span class="lp-facet-label">Has note from buyer</span>
                    <span class="lp-count">@OpenCount(_openFilter with { HasNote = true })</span>
                </button>
                <button type="button" class="lp-facet" aria-pressed="@Pressed(_openFilter.Gift)"
                        @onclick="() => SetOpenFilter(_openFilter with { Gift = !_openFilter.Gift })">
                    <span class="lp-facet-label">Marked as gift</span>
                    <span class="lp-count">@OpenCount(_openFilter with { Gift = true })</span>
                </button>
                <button type="button" class="lp-facet" aria-pressed="@Pressed(_openFilter.Personalized)"
                        @onclick="() => SetOpenFilter(_openFilter with { Personalized = !_openFilter.Personalized })">
                    <span class="lp-facet-label">Personalized</span>
                    <span class="lp-count">@OpenCount(_openFilter with { Personalized = true })</span>
                </button>
            </fieldset>

            @if (_shippingMethods.Count > 0)
            {
                <fieldset class="lp-facets">
                    <legend>Shipping</legend>
                    <button type="button" class="lp-facet" aria-pressed="@Pressed(_openFilter.Shipping is null)"
                            @onclick="() => SetOpenFilter(_openFilter with { Shipping = null })">
                        <span class="lp-facet-label">Any shipping</span>
                        <span class="lp-count">@OpenCount(_openFilter with { Shipping = null })</span>
                    </button>
                    @foreach (var method in _shippingMethods)
                    {
                        <button type="button" class="lp-facet" aria-pressed="@Pressed(_openFilter.Shipping == method)"
                                @onclick="() => SetOpenFilter(_openFilter with { Shipping = method })">
                            <span class="lp-facet-label">@method</span>
                            <span class="lp-count">@OpenCount(_openFilter with { Shipping = method })</span>
                        </button>
                    }
                </fieldset>
            }

            @if (_destinations.Count > 0)
            {
                <fieldset class="lp-facets">
                    <legend>Destination</legend>
                    <button type="button" class="lp-facet" aria-pressed="@Pressed(_openFilter.Destination is null)"
                            @onclick="() => SetOpenFilter(_openFilter with { Destination = null })">
                        <span class="lp-facet-label">Anywhere</span>
                        <span class="lp-count">@OpenCount(_openFilter with { Destination = null })</span>
                    </button>
                    @foreach (var iso in _destinations)
                    {
                        <button type="button" class="lp-facet" aria-pressed="@Pressed(_openFilter.Destination == iso)"
                                @onclick="() => SetOpenFilter(_openFilter with { Destination = iso })">
                            <span class="lp-facet-label">@OrderPrintService.CountryName(iso)</span>
                            <span class="lp-count">@OpenCount(_openFilter with { Destination = iso })</span>
                        </button>
                    }
                </fieldset>
            }
        </aside>
        </div>
        }
    </MudTabPanel>

    <MudTabPanel Text="@($"To make ({_toMakeTotal})")">
        @if (_toMake.Count == 0)
        {
            <MudText Class="muted">Nothing to make.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <SortHeader Sort="_toMakeSort" Column="qty" Changed="StateHasChanged" Class="text-right">Qty</SortHeader>
                        <SortHeader Sort="_toMakeSort" Column="item" Changed="StateHasChanged">Item</SortHeader>
                        <SortHeader Sort="_toMakeSort" Column="variations" Changed="StateHasChanged">Variations</SortHeader>
                        <SortHeader Sort="_toMakeSort" Column="personalization" Changed="StateHasChanged">Personalization</SortHeader>
                        <SortHeader Sort="_toMakeSort" Column="shipby" Changed="StateHasChanged">Earliest ship-by</SortHeader>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _toMakeSort.Apply(_toMake))
                    {
                        <tr>
                            <td class="text-right"><b>@((int)row["quantity"]!)</b></td>
                            <td>@ShortTitle((string?)row["title"])</td>
                            <td>
                                @* One pill per variation, as on the order cards (one long pill wrapped into a circle on phones). *@
                                <div class="order-vars">
                                    @foreach (var v in row["variations"]?.AsArray().Select(n => n!.AsObject()) ?? [])
                                    {
                                        if ((string?)v["value"] is { Length: > 0 } value)
                                        {
                                            <ColorBox Text="@value" Title="@((string?)v["property"])" Seed="@($"make|{(string?)row["listing_id"]}|{value}")" />
                                        }
                                    }
                                </div>
                            </td>
                            <td>@if ((string?)row["personalization"] is { Length: > 0 } note) { <ColorBox Text="@note" Kind="@ColorBox.Note" Seed="@($"make|{note}")" /> }</td>
                            <td>@(row["ship_by_ts"] is { } ts ? ListingFormat.Local(DateTime.UnixEpoch.AddSeconds((long)ts), "ddd MMM d") : "—")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudTabPanel>

    <MudTabPanel Text="History">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap" Class="mb-2">
            <MudTextField T="string" Value="_historyText" ValueChanged="OnHistoryTextChanged" Label="Search buyer, item, SKU or receipt #"
                          Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300" Clearable="true" Class="esm-w-lg"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            <MudCheckBox T="bool" Value="_historyGifts" ValueChanged="OnHistoryGiftsChanged" Label="Gift orders" Dense="true" />
            <MudSpacer />
            @if (_historyPicked.Count > 0)
            {
                <span class="muted small">@_historyPicked.Count selected</span>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _historyPicked.Clear()">Clear</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Checklist"
                       Disabled="@(_historyPicked.Count == 0)" Href="@HistoryPrintLink("pick")" Target="_blank">Print pick list</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Print"
                       Disabled="@(_historyPicked.Count == 0)" Href="@HistoryPrintLink("slips")" Target="_blank">Print packing slips</MudButton>
        </MudStack>
        <MudTable @ref="_history" T="Order" ServerData="LoadHistoryAsync" Dense="true" Hover="true" RowsPerPage="50">
            <HeaderContent>
                @* Sorted by the server, so the order covers every page. The first column picks orders to print (any status). *@
                <MudTh>
                    <MudCheckBox T="bool" Value="@AllHistoryRowsPicked" ValueChanged="PickHistoryPage" Dense="true" Size="Size.Small"
                                 Disabled="@(_historyRows.Count == 0)" aria-label="Select every order on this page to print" />
                </MudTh>
                <MudTh><MudTableSortLabel T="Order" SortLabel="@OrderQueries.HistorySort.Date" InitialDirection="SortDirection.Descending">Date</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Order" SortLabel="@OrderQueries.HistorySort.Receipt">Receipt</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Order" SortLabel="@OrderQueries.HistorySort.Buyer">Buyer</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Order" SortLabel="@OrderQueries.HistorySort.Items">Items</MudTableSortLabel></MudTh>
                <MudTh Class="text-right"><MudTableSortLabel T="Order" SortLabel="@OrderQueries.HistorySort.Total">Total</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Order" SortLabel="@OrderQueries.HistorySort.Status">Status</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="Order" SortLabel="@OrderQueries.HistorySort.Shop">Shop</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudCheckBox T="bool" Value="@_historyPicked.Contains(context.Id)" ValueChanged="@(on => PickHistory(context.Id, on))"
                                 Dense="true" Size="Size.Small" aria-label="@($"Select order {context.EtsyReceiptId} to print")" />
                </MudTd>
                <MudTd>@ListingFormat.Local(context.EtsyCreatedAtUtc, "yyyy-MM-dd")</MudTd>
                <MudTd><a href="@OrderUrl(context.ShopId, context.EtsyReceiptId)" target="@OrderTarget(context.ShopId, context.EtsyReceiptId)">#@context.EtsyReceiptId</a></MudTd>
                <MudTd>
                    @context.BuyerName
                    @if (context.IsGift) { <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-1">Gift</MudChip> }
                </MudTd>
                <MudTd class="small">@string.Join(", ", context.Items.Select(i => (i.Quantity > 1 ? $"{i.Quantity}× " : "") + ShortTitle(i.Title)))</MudTd>
                <MudTd Class="text-right">@OrderTotal(context)</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsOpen ? Color.Warning : context.IsShipped ? Color.Success : Color.Default)">
                        @(context.IsOpen ? "open" : context.IsShipped ? "shipped" : context.Status)
                    </MudChip>
                </MudTd>
                <MudTd>@context.Shop.Name</MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText>No orders yet. The first poll pulls the shop's order history.</MudText></NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100, 200 }" /></PagerContent>
        </MudTable>
    </MudTabPanel>
</MudTabs>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // Used when a shop has no profile image, or its colour can't be read (--esm-shop-fallback-N in app.css).
    private const int FallbackAccentCount = 4;

    private List<OrderShopStatus> _status = [];
    private Dictionary<int, string> _accents = [];
    private Dictionary<int, string> _orderLinks = [];
    private bool _accentsRequested;
    private int? _shopId;
    private List<Order> _open = [];
    private List<JsonObject> _toMake = [];

    private readonly TableSort<JsonObject> _toMakeSort = new()
    {
        ["qty"] = r => (int?)r["quantity"],
        ["item"] = r => ShortTitle((string?)r["title"]),
        ["variations"] = r => string.Join(" ", r["variations"]?.AsArray().Select(v => (string?)v?["value"]) ?? []),
        ["personalization"] = r => (string?)r["personalization"],
        ["shipby"] = r => (long?)r["ship_by_ts"],
    };
    private int _toMakeTotal;
    private MudTable<Order>? _history;
    private string? _historyText;
    private bool _historyGifts;
    private Timer? _timer;
    private IDisposable? _live;
    private JsonObject? _colorConfig;

    protected override async Task OnInitializedAsync()
    {
        _colorConfig = (await Colors.GetAsync()).ToCardJson();
        await LoadAsync();
        // Orders change when a check for orders runs (or a shop is (re)connected): reload then.
        _live = JobEvents.Subscribe(
            c => c.JobType == PollShopOrdersJob.Type || c.JobType == EtsyShopManager.Web.Modules.Shops.ShopRefreshJob.Type,
            _ => InvokeAsync(async () =>
            {
                await LoadAsync();
                if (_history is not null) await _history.ReloadServerData();
                StateHasChanged();
            }));
        // Ship-by countdowns and "synced … ago" are relative to now: re-render every 30 s.
        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadAsync()
    {
        _status = await Queries.GetShopStatusAsync();
        var shopIds = _status.Select(s => s.ShopId).ToList();
        _accents = await ShopAccents.GetEffectiveAsync(shopIds);
        _orderLinks = await ShopOrderLinks.GetOverridesAsync(shopIds);
        _open = await Queries.GetOpenOrdersAsync(_shopId);
        RefreshShown();
        var payload = HaPayloadBuilder.OpenOrders(_open, TimeZoneInfo.Local);
        _toMake = payload["items_needed"]!.AsArray().Select(n => n!.AsObject()).ToList();
        _toMakeTotal = (int)payload["total_items_needed"]!;
    }

    // Color the variation pills and personalization notes rendered by <ColorBox> (new or changed ones only),
    // and read any shop accent not yet cached from the shop's profile image.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Js.InvokeVoidAsync("esm.colorOrders", _colorConfig);
        if (_status.Count > 0 && !_accentsRequested)
        {
            _accentsRequested = true;
            var changed = false;
            foreach (var s in _status.Where(s => !_accents.ContainsKey(s.ShopId)))
            {
                if (await Js.InvokeAsync<string?>("esm.dominantColor", ShopIconCache.UrlFor(s.ShopId)) is { } color)
                {
                    _accents[s.ShopId] = color;
                    await ShopAccents.SaveAutomaticAsync(s.ShopId, color);
                    changed = true;
                }
            }
            if (changed) StateHasChanged();
        }
    }

    private string Accent(int shopId)
    {
        if (_accents.TryGetValue(shopId, out var color)) return color;
        var index = _status.FindIndex(s => s.ShopId == shopId);
        return $"var(--esm-shop-fallback-{Math.Max(0, index) % FallbackAccentCount})";
    }

    private string ShopStyle(int shopId) => $"--shop: {Accent(shopId)}";

    private string OrderUrl(int shopId, long receiptId) =>
        EtsyShopManager.Web.Modules.Shops.ShopOrderLinkService.FormatUrl(_orderLinks.GetValueOrDefault(shopId), receiptId);

    private string? OrderTarget(int shopId, long receiptId) =>
        EtsyShopManager.Web.Modules.Shops.ShopOrderLinkService.OpensInNewTab(OrderUrl(shopId, receiptId)) ? "_blank" : null;

    private async Task OnShopChanged(int? id)
    {
        _shopId = id;
        await LoadAsync();
        if (_history is not null) await _history.ReloadServerData();
    }

    private async Task<TableData<Order>> LoadHistoryAsync(TableState state, CancellationToken ct)
    {
        var sortBy = state.SortDirection == SortDirection.None ? null : state.SortLabel;
        var (orders, total) = await Queries.GetHistoryAsync(_shopId, _historyText, state.Page * state.PageSize, state.PageSize, ct,
            sortBy, descending: state.SortDirection != SortDirection.Ascending, giftsOnly: _historyGifts);
        _historyRows = orders;
        return new TableData<Order> { Items = orders, TotalItems = total };
    }

    private async Task OnHistoryTextChanged(string? text)
    {
        _historyText = text;
        if (_history is not null) await _history.ReloadServerData();
    }

    private async Task OnHistoryGiftsChanged(bool on)
    {
        _historyGifts = on;
        if (_history is not null) await _history.ReloadServerData();
    }

    private async Task PollNowAsync()
    {
        var user = (await AuthState).User.Identity?.Name;
        var queued = 0;
        foreach (var s in _status.Where(s => s.IsHealthy && (_shopId is null || s.ShopId == _shopId)))
            if (await PollQueue.PollShopAsync(s.ShopId, user) is not null) queued++;
        Snackbar.Add(queued == 0 ? "A check is already queued" : "Checking Etsy for orders…", Severity.Info);
    }

    // Sort and filters of the Open tab (ship-by date first, as before); the To make tab still counts every open order.
    private OpenOrderFilter _openFilter = new();
    private List<Order> _shown = [];
    private List<string> _shippingMethods = [];
    private List<string> _destinations = [];

    private void RefreshShown()
    {
        _shown = _openFilter.Apply(_open);
        // A chosen value stays listed after its last order ships, so it can still be cleared.
        _shippingMethods = [.. _open.Select(OrderPrintService.ShippingMethod).Append(_openFilter.Shipping).OfType<string>()
            .Distinct().Order(StringComparer.OrdinalIgnoreCase)];
        _destinations = [.. _open.Select(OrderPrintService.CountryIso).Append(_openFilter.Destination).OfType<string>()
            .Distinct().OrderBy(iso => OrderPrintService.CountryName(iso), StringComparer.OrdinalIgnoreCase)];
    }

    private void SetOpenFilter(OpenOrderFilter filter)
    {
        _openFilter = filter;
        RefreshShown();
    }

    private void OnOpenSortChanged(string sort) => SetOpenFilter(_openFilter with { Sort = sort });

    private void ClearOpenFilters() => SetOpenFilter(new OpenOrderFilter { Sort = _openFilter.Sort });

    private int OpenCount(OpenOrderFilter filter) => _open.Count(filter.Matches);

    private static string Pressed(bool on) => on ? "true" : "false";

    private static string SortLabel(string? key) =>
        OpenOrderFilter.SortOptions.FirstOrDefault(s => s.Key == key).Label ?? "Ship by date";

    // Orders picked for printing (open orders shown by the filters only; one that ships or closes drops out on the next refresh).
    private readonly HashSet<int> _picked = [];
    private List<int> Picked => [.. _shown.Where(o => _picked.Contains(o.Id)).Select(o => o.Id)];

    private void Pick(int id, bool on)
    {
        if (on) _picked.Add(id); else _picked.Remove(id);
    }

    private void SelectAllOpen() => _picked.UnionWith(_shown.Select(o => o.Id));

    private string PrintLink(string kind) => $"orders/print/{kind}?ids={string.Join(",", Picked)}";

    // History orders picked for printing, of any status (reprints, and gift slips for orders already sent). Kept across
    // pages, searches and the gift filter, so orders can be gathered from several pages.
    private readonly HashSet<int> _historyPicked = [];
    private IReadOnlyList<Order> _historyRows = [];

    private bool AllHistoryRowsPicked => _historyRows.Count > 0 && _historyRows.All(o => _historyPicked.Contains(o.Id));

    private void PickHistory(int id, bool on)
    {
        if (on) _historyPicked.Add(id); else _historyPicked.Remove(id);
    }

    private void PickHistoryPage(bool on)
    {
        foreach (var o in _historyRows) PickHistory(o.Id, on);
    }

    private string HistoryPrintLink(string kind) => $"orders/print/{kind}?ids={string.Join(",", _historyPicked.Order())}";

    private static (List<OrderVariation> Variations, string? Personalization) Split(OrderItem i)
    {
        var personalization = i.Variations.Where(v => v.PropertyId == HaPayloadBuilder.PersonalizationPropertyId && v.Value.Length > 0)
            .Select(v => v.Name.Length > 0 && !v.Name.Trim().Equals("personalization", StringComparison.OrdinalIgnoreCase) ? $"{v.Name}: {v.Value}" : v.Value)
            .ToList();
        return (i.Variations.Where(v => v.PropertyId != HaPayloadBuilder.PersonalizationPropertyId && v.Value.Length > 0).ToList(),
            personalization.Count == 0 ? null : string.Join(" | ", personalization));
    }

    private static string ShortTitle(string? title) => (title ?? "").Split('|')[0].Trim();

    private static string OrderTotal(Order o) =>
        o.Grandtotal is { } g ? ListingFormat.Price(g, o.Divisor, o.CurrencyCode)
        : ListingFormat.Price(o.Items.Sum(i => i.PriceAmount * Math.Max(1, i.Quantity)), o.Items.FirstOrDefault()?.PriceDivisor ?? 100, o.CurrencyCode);

    private string Ago(DateTime? utc)
    {
        if (utc is null) return "never";
        var minutes = (Time.GetUtcNow().UtcDateTime - utc.Value).TotalMinutes;
        return minutes < 1 ? "just now" : minutes < 60 ? $"{minutes:0} min ago" : ListingFormat.Local(utc, "HH:mm");
    }

    private static string StatusTooltip(OrderShopStatus s) =>
        s.LastError ?? (s.BackfillDone ? $"Last checked {ListingFormat.Local(s.LastPolledAtUtc, "yyyy-MM-dd HH:mm:ss")}" : "First sync (order history) not finished yet");

    public void Dispose()
    {
        _live?.Dispose();
        _timer?.Dispose();
    }
}
