@using EtsyShopManager.Web.Modules.Orders
@* A variation pill or personalization note, tinted by the colors it names. The app's color engine draws it, the same
   engine that draws the boxes the Home Assistant card shows. *@

<span class="esm-colorbox esm-colorbox-@Kind" title="@Title"><span class="@(Kind + _box.Cls)" style="@_box.Style">@((MarkupString)_box.Inner)@Text</span></span>

@code {
    public const string Pill = "var";
    public const string Note = "note";

    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>The engine for the color list in use (the saved one, or the one being edited); uncolored while null.</summary>
    [Parameter, EditorRequired] public OrderColorEngine? Colors { get; set; }

    /// <summary><see cref="Pill"/> for a variation, <see cref="Note"/> for personalization (the card's class names).</summary>
    [Parameter] public string Kind { get; set; } = Pill;

    /// <summary>Keeps a "random" box's pattern the same between renders (the card uses receipt id and position).</summary>
    [Parameter] public string Seed { get; set; } = "";

    [Parameter] public string? Title { get; set; }

    private OrderColorBox _box = OrderColorBox.None;

    protected override void OnParametersSet() => _box = Colors?.Box(Text, Seed, Kind == Pill) ?? OrderColorBox.None;
}
