@page "/templates/variations/new"
@page "/templates/variations/{Id:int}"
@* The old addresses, from before the Templates page. *@
@page "/variation-lists/new"
@page "/variation-lists/{Id:int}"
@using EtsyShopManager.Web.Modules.Templates
@using EtsyShopManager.Web.Modules.Shops
@inject VariationListService Lists
@inject ShopService ShopService
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@(_saved?.Name ?? "New variation template") · Etsy Shop Manager</PageTitle>

<MudLink Href="templates/variations" Class="d-inline-flex align-center mb-2">
    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mr-1" /> All variation templates
</MudLink>

@if (Id is not null && _saved is null)
{
    <PageHeader Title="Variation template" />
    @if (_loaded) { <MudAlert Severity="Severity.Warning">This variation template no longer exists.</MudAlert> }
    else { <MudProgressLinear Indeterminate="true" /> }
}
else
{
    <PageHeader Title="@(_saved?.Name ?? "New variation template")">
        <Summary>
            @if (_saved is null)
            {
                <span>Name the template and add its options. After saving, the app lists the listings whose variations already use them.</span>
            }
            else
            {
                <span>Used by @_uses.Count listing@(_uses.Count == 1 ? "" : "s"). Saving the template changes no listing until you apply it.</span>
            }
        </Summary>
        <Actions>
            <AuthorizeView Roles="@Roles.Admin">
                @if (_saved is not null)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="DeleteAsync">Delete template</MudButton>
                }
                <SaveButtons Text="Save template" Changed="Dirty" OnSave="SaveAsync" OnCancel="Revert" />
            </AuthorizeView>
        </Actions>
    </PageHeader>

    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">Template</MudText>
        <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Immediate="true" Class="mb-3 esm-w-lg"
                      ReadOnly="!_canEdit" Counter="VariationListService.MaxNameLength" MaxLength="VariationListService.MaxNameLength" />
        <MudText Typo="Typo.body2" Class="muted mb-2">
            Switch an option off to retire it: linked listings keep the value but buyers can't pick it. Renaming an option renames
            it on the listings too. New options are added at the end of each listing's choices.
        </MudText>
        <MudSimpleTable Dense="true">
            @* An editing grid: rows keep their order while names are typed (not sortable). *@
            <thead class="esm-fixed-order"><tr><th>Option</th><th>On</th><th></th></tr></thead>
            <tbody>
                @foreach (var (o, i) in _options.Select((o, i) => (o, i)))
                {
                    var index = i;
                    <tr>
                        <td><MudTextField T="string" Value="o.Name" ValueChanged="@(v => _options[index] = o with { Name = v ?? "" })" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Immediate="true" ReadOnly="!_canEdit" aria-label="Option name" /></td>
                        <td><MudSwitch T="bool" Value="o.Enabled" ValueChanged="@(v => _options[index] = o with { Enabled = v })" Color="Color.Primary"
                                       Disabled="!_canEdit" aria-label="@($"{o.Name} on")" /></td>
                        <td class="text-right">
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(i == 0)" aria-label="@($"Move {o.Name} up")" OnClick="@(() => Move(index, -1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(i == _options.Count - 1)" aria-label="@($"Move {o.Name} down")" OnClick="@(() => Move(index, 1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@($"Remove {o.Name}")" OnClick="@(() => _options.RemoveAt(index))" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        @if (_canEdit)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                <MudTextField T="string" @bind-Value="_add" Label="Add options, separated by commas" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudButton Variant="Variant.Outlined" Disabled="@string.IsNullOrWhiteSpace(_add)" OnClick="AddOptions">Add</MudButton>
            </MudStack>
        }
        @if (_saved is not null && _saved.Options.Any(o => _options.All(x => x.Id != o.Id)))
        {
            <MudText Typo="Typo.body2" Class="muted mt-2">Removing an option removes it from linked listings when applied. Switch an option off instead to retire it (keep the value but hide it from buyers).</MudText>
        }
    </MudPaper>

    @if (_saved is not null)
    {
        <MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudTextField T="string" Value="_filterText" ValueChanged="OnFilterTextChanged" Placeholder="Search title, SKU, tag, listing ID..."
                              Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="esm-w-md" aria-label="Search listings" />
                <MudSelect T="int?" Value="_filterShopId" ValueChanged="OnFilterShopChanged" Label="Shop" Variant="Variant.Outlined" Margin="Margin.Dense" Class="esm-w-sm">
                    <MudSelectItem T="int?" Value="@((int?)null)">All shops</MudSelectItem>
                    @foreach (var s in FilterShops)
                    {
                        <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="_filterStatus" ValueChanged="OnFilterStatusChanged" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Class="esm-w-sm">
                    <MudSelectItem T="string" Value="@("all")">All</MudSelectItem>
                    <MudSelectItem T="string" Value="@("active")">Active</MudSelectItem>
                    <MudSelectItem T="string" Value="@("draft")">Draft</MudSelectItem>
                    <MudSelectItem T="string" Value="@("expired")">Expired</MudSelectItem>
                    <MudSelectItem T="string" Value="@("sold_out")">Sold out</MudSelectItem>
                    <MudSelectItem T="string" Value="@("inactive")">Inactive</MudSelectItem>
                    <MudSelectItem T="string" Value="@("missing")">Gone from Etsy</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-2">
                <MudText Typo="Typo.h6">Listings using this template</MudText>
                <MudStack Row="true" Spacing="2">
                    <AuthorizeView Roles="@Roles.Admin">
                        <MudButton Variant="Variant.Outlined" Disabled="@(WithChanges == 0 || Dirty)" OnClick="ApplyAsync">
                            Apply to @WithChanges listing@(WithChanges == 1 ? "" : "s")
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Pending == 0)" OnClick="ReviewAsync">
                            Review and push @Pending listing@(Pending == 1 ? "" : "s")
                        </MudButton>
                    </AuthorizeView>
                </MudStack>
            </MudStack>
            <MudText Typo="Typo.body2" Class="muted mb-2">
                Applying changes each listing's variations as unpushed edits; nothing is sent to Etsy until you review and push.
                New combinations start with the listing's current stock and follow its prices. Values a listing has of its own
                are left alone.
            </MudText>
            @if (_uses.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="muted">No listings yet. Link the ones below.</MudText>
            }
            else if (VisibleUses.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="muted">No listings match these filters.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true">
                    <thead>
                        <tr>
                            <SortHeader Sort="_useSort" Column="listing" Changed="StateHasChanged">Listing</SortHeader>
                            <SortHeader Sort="_useSort" Column="variation" Changed="StateHasChanged">Variation</SortHeader>
                            <SortHeader Sort="_useSort" Column="status" Changed="StateHasChanged">Status</SortHeader>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in _useSort.Apply(VisibleUses))
                        {
                            <tr>
                                <td><a href="@(_canEdit ? $"listings/{u.ListingId}/edit" : $"listings/{u.ListingId}")">@u.Title</a> <span class="muted small">· @u.ShopName</span></td>
                                <td>
                                    @u.VariationName
                                    @if (u.CombinedWith is { Count: > 0 } others)
                                    {
                                        <div class="small muted">Combined with @string.Join(", ", others)</div>
                                    }
                                </td>
                                <td>
                                    <span class="esm-status-dot @StatusClass(u.Status)"></span> @StatusText(u)
                                    @foreach (var c in u.Changes.Skip(1)) { <div class="small">@c</div> }
                                    @foreach (var n in u.Notes) { <div class="small muted">@n</div> }
                                </td>
                                <td class="text-right">
                                    @if (_canEdit)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => UnlinkAsync(u))">Unlink</MudButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>

        @if (_review is not null)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-2">
                    <MudText Typo="Typo.h6">Review the push</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _review = null)">Close</MudButton>
                </MudStack>
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    Each listing is pushed on its own, with all of its unpushed edits (not only this template), exactly as from its
                    editor. Listings with a problem are skipped; fix them in their editor.
                </MudText>
                <MudSimpleTable Dense="true">
                    <thead>
                        <tr>
                            <SortHeader Sort="_reviewSort" Column="listing" Changed="StateHasChanged">Listing</SortHeader>
                            <SortHeader Sort="_reviewSort" Column="changes" Changed="StateHasChanged">Changes</SortHeader>
                            <SortHeader Sort="_reviewSort" Column="ready" Changed="StateHasChanged">Ready</SortHeader>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _reviewSort.Apply(_review))
                        {
                            <tr>
                                <td><a href="@(_canEdit ? $"listings/{item.ListingId}/edit" : $"listings/{item.ListingId}")">@item.Title</a> <span class="muted small">· @item.ShopName</span></td>
                                <td>@string.Join(", ", item.Preview.Changes.Select(c => c.Label))</td>
                                <td>
                                    @if (item.Preview.CanPush)
                                    {
                                        <span><span class="esm-status-dot esm-dot-success"></span> Ready</span>
                                    }
                                    else
                                    {
                                        @foreach (var b in item.Preview.Blockers) { <div class="small error-text">@b</div> }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <AuthorizeView Roles="@Roles.Admin">
                    <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Ready == 0 || _pushing)" OnClick="PushAsync">
                        Push @Ready listing@(Ready == 1 ? "" : "s") to Etsy
                    </MudButton>
                </AuthorizeView>
            </MudPaper>
        }

        @if (_candidates.Count > 0)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Listings with matching variations</MudText>
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    Variations whose values are mostly in this list. Linking changes nothing yet: the next apply adds the list's
                    missing options to them and switches retired ones off. A variation that already follows another template
                    is counted on the values that template doesn't cover, and linking adds this one after it.
                </MudText>
                @if (VisibleCandidates.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="muted">No listings match these filters.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true">
                        <thead>
                            <tr>
                                <th class="esm-col-icon"><MudCheckBox T="bool?" Value="CandidateHeaderChecked" ValueChanged="@(_ => TogglePickAllVisible())" TriState="true" aria-label="Select all" Dense="true" Disabled="!_canEdit" /></th>
                                <SortHeader Sort="_candidateSort" Column="listing" Changed="StateHasChanged">Listing</SortHeader>
                                <SortHeader Sort="_candidateSort" Column="variation" Changed="StateHasChanged">Variation</SortHeader>
                                <SortHeader Sort="_candidateSort" Column="match" Changed="StateHasChanged">In the template</SortHeader>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _candidateSort.Apply(VisibleCandidates))
                            {
                                var key = (c.ListingId, c.PropertyId);
                                <tr @onclick="@((MouseEventArgs e) => HandleCandidateClick(key, e))">
                                    <td>
                                        <RangeCheckBox Value="@_picked.Contains(key)"
                                                       Clicked="@((MouseEventArgs e) => HandleCandidateClick(key, e))"
                                                       AriaLabel="@($"Link {c.Title}")"
                                                       Disabled="!_canEdit" />
                                    </td>
                                    <td><a href="@($"listings/{c.ListingId}")" @onclick:stopPropagation="true">@c.Title</a> <span class="muted small">· @c.ShopName</span></td>
                                    <td>
                                        @c.VariationName
                                        @if (c.CombinedWith is { Count: > 0 } others)
                                        {
                                            <div class="small muted">Follows @string.Join(", ", others); linking combines them</div>
                                        }
                                    </td>
                                    <td>@c.InList of @c.Values @(c.CombinedWith is { Count: > 0 } ? "other values" : "values")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                <AuthorizeView Roles="@Roles.Admin">
                    <MudButton Class="mt-3" Variant="Variant.Outlined" Disabled="@(_picked.Count == 0)" OnClick="LinkAsync">
                        Link @_picked.Count listing@(_picked.Count == 1 ? "" : "s")
                    </MudButton>
                </AuthorizeView>
            </MudPaper>
        }

        <AuthorizeView Roles="@Roles.Admin">
            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Add listings</MudText>
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    Adds the template's switched-on options to any listing as a new variation, and links it. Every combination the
                    listing has takes each option; the price stays as it is (it doesn't vary by the new variation) and the listing's
                    stock is shared. It's an unpushed edit until you review and push.
                </MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Start" Spacing="2">
                    <MudAutocomplete T="VariationListAddable" Value="@_addTo" ValueChanged="PickAddToAsync" SearchFunc="SearchAddableAsync"
                                     ToStringFunc="@(a => a is null ? "" : $"{a.Title} · {a.ShopName}")" Label="Listing" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" ResetValueOnEmptyText="true" Class="esm-w-lg" />
                    <MudTextField T="string" Value="@_addName" ValueChanged="SetAddNameAsync" Label="Variation name" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Class="esm-w-sm" />
                    <MudButton Variant="Variant.Outlined" Disabled="@(_addPlan is null)" OnClick="AddToListingAsync">Add to listing</MudButton>
                </MudStack>
                @if (_addTo is not null)
                {
                    @if (_addError is not null)
                    {
                        <MudText Typo="Typo.body2" Class="error-text mt-2">@_addError</MudText>
                    }
                    else if (_addPlan is not null)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2">
                            Adds @_addPlan.VariationName with @_addPlan.Values.Count option@(_addPlan.Values.Count == 1 ? "" : "s")
                            @(_addTo.Variations.Count > 0 ? $"next to {string.Join(" and ", _addTo.Variations)}" : ""):
                            @_addPlan.Combinations combination@(_addPlan.Combinations == 1 ? "" : "s").
                        </MudText>
                    }
                }
            </MudPaper>
        </AuthorizeView>
    }
}

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private VariationList? _saved;
    private bool _loaded, _pushing, _canEdit;
    private string _name = "";
    private string? _add;
    private List<VariationListOption> _options = [];
    private string? _filterText;
    private int? _filterShopId;
    private string _filterStatus = "all";
    private IReadOnlyList<ShopSummary> _shops = [];
    private IReadOnlyList<VariationListUse> _uses = [];
    private IReadOnlyList<VariationListCandidate> _candidates = [];
    private IReadOnlyList<TemplatePushItem>? _review;
    private readonly HashSet<(int, long)> _picked = [];
    private IReadOnlyList<VariationListAddable>? _addable;
    private VariationListAddable? _addTo;
    private string? _addName, _addError;
    private VariationListAddPlan? _addPlan;

    private TemplateListingFilter Filter => new()
    {
        Text = _filterText,
        ShopId = _filterShopId,
        Status = _filterStatus,
    };

    private IReadOnlyList<VariationListUse> VisibleUses =>
        [.. _uses.Where(u => TemplateFilterMatcher.Matches(u, Filter))];

    private IReadOnlyList<VariationListCandidate> VisibleCandidates =>
        [.. _candidates.Where(c => TemplateFilterMatcher.Matches(c, Filter))];

    private record ShopOption(int Id, string Name);

    private IEnumerable<ShopOption> FilterShops =>
        _shops.Select(s => new ShopOption(s.Id, s.Name))
            .Concat(_uses.Select(u => new ShopOption(u.ShopId, u.ShopName)))
            .Concat(_candidates.Select(c => new ShopOption(c.ShopId, c.ShopName)))
            .DistinctBy(s => s.Id)
            .OrderBy(s => s.Name);

    private bool? CandidateHeaderChecked
    {
        get
        {
            var visible = VisibleCandidates.Select(c => (c.ListingId, c.PropertyId)).ToList();
            if (visible.Count == 0) return false;
            var pickedCount = visible.Count(_picked.Contains);
            if (pickedCount == 0) return false;
            if (pickedCount == visible.Count) return true;
            return null;
        }
    }

    private readonly RangeSelection<(int ListingId, long PropertyId)> _range = new();

    private void HandleCandidateClick((int ListingId, long PropertyId) key, MouseEventArgs e)
    {
        if (!_canEdit) return;
        var visible = _candidateSort.Apply(VisibleCandidates).Select(c => (c.ListingId, c.PropertyId)).ToList();
        _range.HandleClick(key, e.ShiftKey, visible, _picked);
    }

    private void TogglePickAllVisible()
    {
        var visible = VisibleCandidates.Select(c => (c.ListingId, c.PropertyId)).ToList();
        if (visible.Count == 0) return;
        var allPicked = visible.All(_picked.Contains);
        if (allPicked)
            _picked.ExceptWith(visible);
        else
            _picked.UnionWith(visible);
        _range.Reset();
    }

    private void OnFilterTextChanged(string? val) => _filterText = val;
    private void OnFilterShopChanged(int? val) => _filterShopId = val;
    private void OnFilterStatusChanged(string val) => _filterStatus = val;

    private bool Dirty => _saved is null
        ? _name.Trim().Length > 0 || _options.Count > 0
        : _name.Trim() != _saved.Name || !_options.SequenceEqual(_saved.Options);
    private int WithChanges => _uses.Count(u => u.Status == VariationListUseStatus.HasChanges);
    private int Pending => _uses.Where(u => u.InventoryPending).Select(u => u.ListingId).Distinct().Count();
    private int Ready => _review?.Count(r => r.Preview.CanPush) ?? 0;

    private readonly TableSort<VariationListUse> _useSort = new()
    {
        ["listing"] = u => u.Title,
        ["variation"] = u => u.VariationName,
        ["status"] = u => StatusText(u),
    };
    private readonly TableSort<VariationListCandidate> _candidateSort = new()
    {
        ["listing"] = c => c.Title,
        ["variation"] = c => c.VariationName,
        ["match"] = c => (double)c.InList / c.Values,
    };
    private readonly TableSort<TemplatePushItem> _reviewSort = new()
    {
        ["listing"] = r => r.Title,
        ["changes"] = r => string.Join(", ", r.Preview.Changes.Select(c => c.Label)),
        ["ready"] = r => r.Preview.CanPush,
    };

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthState;
        _canEdit = state.User.IsInRole(Roles.Admin);
        if (Id is null && !_canEdit)
        {
            if (state.User.Identity?.IsAuthenticated == true)
                Nav.NavigateTo("account/access-denied", forceLoad: true);
            else
            {
                var returnUrl = Nav.ToBaseRelativePath(Nav.Uri);
                Nav.NavigateTo($"account/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            }
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _shops = await ShopService.ListAsync(); } catch { _shops = []; }
        if (Id is { } id && (_saved = await Lists.GetAsync(id)) is not null)
        {
            (_name, _options) = (_saved.Name, [.. _saved.Options]);
            _uses = await Lists.UsesAsync(id);
            _candidates = await Lists.CandidatesAsync(id);
            _picked.Clear();
            _range.Reset();
            _picked.UnionWith(_candidates.Where(c => c.InList == c.Values).Select(c => (c.ListingId, c.PropertyId)));
        }
        _loaded = true;
    }

    private async Task<string?> User() => (await AuthState).User.Identity?.Name;

    private void Revert()
    {
        _name = _saved?.Name ?? "";
        _options = [.. _saved?.Options ?? []];
    }

    private static string StatusText(VariationListUse u) => u.Status switch
    {
        VariationListUseStatus.UpToDate => u.InventoryPending ? "Up to date, not pushed yet" : "Up to date",
        VariationListUseStatus.HasChanges => "Will change",
        VariationListUseStatus.VariationMissing => "The linked variation is gone",
        VariationListUseStatus.TooManyOptions => "Too many options for Etsy",
        _ => "Variations changed on Etsy: resolve it in the listing's editor first",
    };

    private static string StatusClass(VariationListUseStatus s) => s switch
    {
        VariationListUseStatus.UpToDate => "esm-dot-success",
        VariationListUseStatus.HasChanges => "esm-dot-info",
        _ => "esm-dot-warning",
    };

    private void Move(int index, int by) => (_options[index], _options[index + by]) = (_options[index + by], _options[index]);

    private void AddOptions()
    {
        foreach (var name in (_add ?? "").Split(',').Select(n => n.Trim()).Where(n => n.Length > 0))
            if (_options.All(o => !string.Equals(o.Name, name, StringComparison.OrdinalIgnoreCase)))
                _options.Add(new VariationListOption(0, name, true));
        _add = null;
    }

    private void Pick((int, long) key, bool on)
    {
        if (on) _picked.Add(key); else _picked.Remove(key);
    }

    private async Task SaveAsync()
    {
        var (id, error) = await Lists.SaveAsync(_saved?.Id, _name, _options, await User());
        if (error is not null) { Snackbar.Add(error, Severity.Warning); return; }
        if (_saved is null) { Nav.NavigateTo($"templates/variations/{id}"); return; }
        await LoadAsync();
        Snackbar.Add(WithChanges > 0
            ? $"Template saved. {WithChanges} listing{(WithChanges == 1 ? "" : "s")} would change; apply it when you're ready."
            : "Template saved.", Severity.Success);
    }

    private async Task DeleteAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Delete variation template",
            $"Delete \"{_saved!.Name}\"? Listings keep their variations as they are; they're only no longer linked.",
            yesText: "Delete template", cancelText: "Cancel");
        if (ok != true) return;
        await Lists.DeleteAsync(_saved.Id, await User());
        Nav.NavigateTo("templates/variations");
    }

    private async Task ApplyAsync()
    {
        var needingPricing = await Lists.ListingsNeedingPricingAsync(_saved!.Id);
        VariationPricingStrategy strategy = VariationPricingStrategy.TakeHighest;
        IReadOnlyDictionary<int, decimal>? customPrices = null;

        if (needingPricing.Count > 0)
        {
            var dialog = await Dialogs.ShowAsync<ApplyVariationTemplateDialog>("Apply variation template",
                new DialogParameters<ApplyVariationTemplateDialog> { { d => d.Listings, needingPricing } },
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
            var result = await dialog.Result;
            if (result is null || result.Canceled) return;
            if (result.Data is ApplyVariationTemplateResult pricing)
            {
                strategy = pricing.Strategy;
                customPrices = pricing.CustomPrices;
            }
        }
        else
        {
            var ok = await Dialogs.ShowMessageBoxAsync("Apply the template",
                $"Change the variations of {WithChanges} listing{(WithChanges == 1 ? "" : "s")} to match the template? They become unpushed edits; " +
                "nothing is sent to Etsy until you review and push.", yesText: "Apply", cancelText: "Cancel");
            if (ok != true) return;
        }

        var count = await Lists.ApplyAsync(_saved!.Id, await User(), strategy, customPrices);
        await LoadAsync();
        _review = null;
        Snackbar.Add($"{count} listing{(count == 1 ? "" : "s")} updated as unpushed edits.", Severity.Success);
    }

    private async Task ReviewAsync() => _review = await Lists.ReviewAsync(_saved!.Id);

    private async Task PushAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Push to Etsy",
            $"Push {Ready} listing{(Ready == 1 ? "" : "s")} to Etsy? Each one is a normal push with a snapshot you can restore.",
            yesText: "Push to Etsy", cancelText: "Cancel");
        if (ok != true) return;
        _pushing = true;
        try
        {
            var results = await Lists.PushAsync(_saved!.Id, await User());
            var queued = results.Count(r => r.PushId is not null);
            Snackbar.Add($"{queued} push{(queued == 1 ? "" : "es")} queued; results appear on each listing and on the Jobs page.", Severity.Info);
            foreach (var s in results.Where(r => r.PushId is null)) Snackbar.Add($"{s.Title}: {string.Join(" ", s.Blockers)}", Severity.Warning);
            _review = null;
            await LoadAsync();
        }
        finally { _pushing = false; }
    }

    private async Task LinkAsync()
    {
        var picked = _picked.Count;
        var count = await Lists.LinkAsync(_saved!.Id, _picked.Select(k => (k.Item1, k.Item2)), await User());
        await LoadAsync();
        Snackbar.Add($"{count} listing{(count == 1 ? "" : "s")} linked.", Severity.Success);
        if (count < picked)
            Snackbar.Add($"{picked - count} not linked: their variation would have more than {VariationListService.MaxOptions} options with this template, " +
                "or it changed meanwhile.", Severity.Warning);
    }

    private async Task<IEnumerable<VariationListAddable>> SearchAddableAsync(string? text, CancellationToken ct)
    {
        _addable ??= await Lists.AddableAsync(_saved!.Id, ct);
        var words = (text ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return _addable.Where(a => words.All(w => a.Title.Contains(w, StringComparison.OrdinalIgnoreCase))).Take(50);
    }

    private async Task PickAddToAsync(VariationListAddable? listing)
    {
        _addTo = listing;
        if (listing is not null && string.IsNullOrWhiteSpace(_addName)) _addName = await Lists.SuggestedVariationNameAsync(_saved!.Id);
        await PreviewAddAsync();
    }

    private async Task SetAddNameAsync(string? name)
    {
        _addName = name;
        await PreviewAddAsync();
    }

    private async Task PreviewAddAsync()
    {
        (_addPlan, _addError) = _addTo is null ? (null, null) : await Lists.PreviewAddAsync(_saved!.Id, _addTo.ListingId, _addName ?? "");
    }

    private async Task AddToListingAsync()
    {
        if (Dirty) { Snackbar.Add("Save the template first.", Severity.Warning); return; }
        var (plan, error) = await Lists.AddToListingAsync(_saved!.Id, _addTo!.ListingId, _addName ?? "", await User());
        if (error is not null) { _addError = error; return; }
        Snackbar.Add($"{plan!.VariationName} added to {_addTo.Title} as an unpushed edit; review and push it when you're ready.", Severity.Success);
        (_addTo, _addPlan, _addError, _addable) = (null, null, null, null);
        _review = null;
        await LoadAsync();
    }

    private async Task UnlinkAsync(VariationListUse u)
    {
        await Lists.UnlinkAsync(_saved!.Id, u.ListingId, await User());
        await LoadAsync();
    }
}
