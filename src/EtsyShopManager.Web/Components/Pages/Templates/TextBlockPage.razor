@page "/templates/text/new"
@page "/templates/text/{Id:int}"
@* The old addresses, from before the Templates page. *@
@page "/text-blocks/new"
@page "/text-blocks/{Id:int}"
@using EtsyShopManager.Web.Modules.Listings
@using EtsyShopManager.Web.Modules.Templates
@using EtsyShopManager.Web.Modules.Shops
@inject TextBlockService Blocks
@inject ShopService ShopService
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime Js

<PageTitle>@(_saved?.Name ?? "New text template") · Etsy Shop Manager</PageTitle>

<MudLink Href="templates/text" Class="d-inline-flex align-center mb-2">
    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Class="mr-1" /> All text templates
</MudLink>

@if (Id is not null && _saved is null && !_loaded)
{
    <PageHeader Title="Text template" />
    <MudProgressLinear Indeterminate="true" />
}
else if (Id is not null && _saved is null)
{
    <PageHeader Title="Text template" />
    <MudAlert Severity="Severity.Warning">This text template no longer exists.</MudAlert>
}
else
{
    <PageHeader Title="@(_saved?.Name ?? "New text template")">
        <Summary>
            @if (_saved is null)
            {
                <span>Name the template and paste its text. After saving, the app lists the listings whose description already contains it.</span>
            }
            else
            {
                <span>Used by @_uses.Count listing@(_uses.Count == 1 ? "" : "s"). Saving the template changes no listing until you apply it.</span>
            }
        </Summary>
        <Actions>
            <AuthorizeView Roles="@Roles.Admin">
                @if (_saved is not null)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="DeleteAsync">Delete template</MudButton>
                }
                <SaveButtons Text="Save template" Changed="Dirty" OnSave="SaveAsync" OnCancel="Revert" />
            </AuthorizeView>
        </Actions>
    </PageHeader>

    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-2">Template</MudText>
        <MudTextField T="string" Value="_name" ValueChanged="NameChanged" Label="Name" Variant="Variant.Outlined" Immediate="true" Class="mb-3 esm-w-lg"
                      ReadOnly="!_canEdit" Counter="TextBlockService.MaxNameLength" MaxLength="TextBlockService.MaxNameLength" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3" Wrap="Wrap.Wrap">
            <MudTextField T="string" @bind-Value="_slug" Label="Placeholder name" Variant="Variant.Outlined" Immediate="true" Class="esm-w-lg"
                          ReadOnly="!_canEdit" Counter="TextBlockService.MaxSlugLength" MaxLength="TextBlockService.MaxSlugLength"
                          HelperText="@($"Put {TextBlockMarkup.Token(SlugOrDefault)} in a description to show this template there. Lowercase letters, numbers and hyphens.")" />
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyTokenAsync">Copy placeholder</MudButton>
        </MudStack>
        <MudTextField T="string" @bind-Value="_text" Label="Text" Lines="8" Variant="Variant.Outlined" Immediate="true" ReadOnly="!_canEdit"
                      HelperText="Exactly as it appears in every description that uses the template; it can only be changed here. Trailing spaces and blank lines around it are dropped." />
    </MudPaper>

    @if (_saved is not null)
    {
        <MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudTextField T="string" Value="_filterText" ValueChanged="OnFilterTextChanged" Placeholder="Search title, SKU, tag, listing ID..."
                              Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="esm-w-md" aria-label="Search listings" />
                <MudSelect T="int?" Value="_filterShopId" ValueChanged="OnFilterShopChanged" Label="Shop" Variant="Variant.Outlined" Margin="Margin.Dense" Class="esm-w-sm">
                    <MudSelectItem T="int?" Value="@((int?)null)">All shops</MudSelectItem>
                    @foreach (var s in FilterShops)
                    {
                        <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Value="_filterStatus" ValueChanged="OnFilterStatusChanged" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Class="esm-w-sm">
                    <MudSelectItem T="string" Value="@("all")">All</MudSelectItem>
                    <MudSelectItem T="string" Value="@("active")">Active</MudSelectItem>
                    <MudSelectItem T="string" Value="@("draft")">Draft</MudSelectItem>
                    <MudSelectItem T="string" Value="@("expired")">Expired</MudSelectItem>
                    <MudSelectItem T="string" Value="@("sold_out")">Sold out</MudSelectItem>
                    <MudSelectItem T="string" Value="@("inactive")">Inactive</MudSelectItem>
                    <MudSelectItem T="string" Value="@("missing")">Gone from Etsy</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-2">
                <MudText Typo="Typo.h6">Listings using this template</MudText>
                <AuthorizeView Roles="@Roles.Admin">
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined" Disabled="@(WillChange == 0 || Dirty)" OnClick="ApplyAsync">
                            Apply to @WillChange listing@(WillChange == 1 ? "" : "s")
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Pending == 0)" OnClick="ReviewAsync">
                            Review and push @Pending listing@(Pending == 1 ? "" : "s")
                        </MudButton>
                    </MudStack>
                </AuthorizeView>
            </MudStack>
            <MudText Typo="Typo.body2" Class="muted mb-2">
                Applying puts the template's new text into each listing's description as an unpushed edit; nothing is sent to Etsy
                until you review and push. Listings whose description changed on Etsy are left alone until that's resolved.
            </MudText>
            @if (_uses.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="muted">No listings yet. Use it in the listings below, or insert it from a listing's editor.</MudText>
            }
            else if (VisibleUses.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="muted">No listings match these filters.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true">
                    <thead>
                        <tr>
                            <SortHeader Sort="_useSort" Column="listing" Changed="StateHasChanged">Listing</SortHeader>
                            <SortHeader Sort="_useSort" Column="shop" Changed="StateHasChanged">Shop</SortHeader>
                            <SortHeader Sort="_useSort" Column="status" Changed="StateHasChanged">Status</SortHeader>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in _useSort.Apply(VisibleUses))
                        {
                            <tr>
                                <td><a href="@(_canEdit ? $"listings/{u.ListingId}/edit" : $"listings/{u.ListingId}")">@u.Title</a></td>
                                <td>@u.ShopName</td>
                                <td>
                                    <span class="esm-status-dot @StatusClass(u.Status)"></span> @StatusText(u)
                                    @if (u.Status == TextBlockUseStatus.WillChange)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Toggle(u.ListingId))">
                                            @(_open.Contains(u.ListingId) ? "Hide changes" : "Show changes")
                                        </MudButton>
                                    }
                                </td>
                                <td class="text-right">
                                    @if (_canEdit)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => DetachAsync(u))">Stop using</MudButton>
                                    }
                                </td>
                            </tr>
                            @if (_open.Contains(u.ListingId))
                            {
                                <tr><td colspan="4"><TextDiff Before="@u.Before" After="@u.After" /></td></tr>
                            }
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>

        @if (_review is not null)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-2">
                    <MudText Typo="Typo.h6">Review the push</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _review = null)">Close</MudButton>
                </MudStack>
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    Each listing is pushed on its own, with all of its unpushed edits (not only this template), exactly as from its
                    editor. Listings with a problem are skipped; fix them in their editor.
                </MudText>
                <MudSimpleTable Dense="true">
                    <thead>
                        <tr>
                            <SortHeader Sort="_reviewSort" Column="listing" Changed="StateHasChanged">Listing</SortHeader>
                            <SortHeader Sort="_reviewSort" Column="changes" Changed="StateHasChanged">Changes</SortHeader>
                            <SortHeader Sort="_reviewSort" Column="ready" Changed="StateHasChanged">Ready</SortHeader>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _reviewSort.Apply(_review))
                        {
                            <tr>
                                <td><a href="@(_canEdit ? $"listings/{item.ListingId}/edit" : $"listings/{item.ListingId}")">@item.Title</a> <span class="muted small">· @item.ShopName</span></td>
                                <td>@string.Join(", ", item.Preview.Changes.Select(c => c.Label))</td>
                                <td>
                                    @if (item.Preview.CanPush)
                                    {
                                        <span><span class="esm-status-dot esm-dot-success"></span> Ready</span>
                                    }
                                    else
                                    {
                                        @foreach (var b in item.Preview.Blockers) { <div class="small error-text">@b</div> }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <AuthorizeView Roles="@Roles.Admin">
                    <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(Ready == 0 || _pushing)" OnClick="PushAsync">
                        Push @Ready listing@(Ready == 1 ? "" : "s") to Etsy
                    </MudButton>
                </AuthorizeView>
            </MudPaper>
        }

        @if (_candidates.Count > 0)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-2">Listings that already contain this text</MudText>
                <MudText Typo="Typo.body2" Class="muted mb-2">
                    Their description has the template's text word for word. Using the template there puts its placeholder in place of the
                    text (nothing changes on Etsy); from then on they follow the template.
                </MudText>
                @if (VisibleCandidates.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="muted">No listings match these filters.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true">
                        <thead>
                            <tr>
                                <th class="esm-col-icon">
                                    <MudCheckBox T="bool?" Value="CandidateHeaderChecked" ValueChanged="@(_ => TogglePickAllVisible())" TriState="true" aria-label="Select all" Dense="true" Disabled="!_canEdit" />
                                </th>
                                <SortHeader Sort="_candidateSort" Column="listing" Changed="StateHasChanged">Listing</SortHeader>
                                <SortHeader Sort="_candidateSort" Column="shop" Changed="StateHasChanged">Shop</SortHeader>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _candidateSort.Apply(VisibleCandidates))
                            {
                                <tr>
                                    <td><MudCheckBox T="bool" Value="@_picked.Contains(c.ListingId)" ValueChanged="@(on => Pick(c.ListingId, on))" aria-label="@($"Link {c.Title}")" Dense="true" Disabled="!_canEdit" /></td>
                                    <td><a href="@($"listings/{c.ListingId}")">@c.Title</a></td>
                                    <td>@c.ShopName</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                <AuthorizeView Roles="@Roles.Admin">
                    <MudButton Class="mt-3" Variant="Variant.Outlined" Disabled="@(_picked.Count == 0)" OnClick="LinkAsync">
                        Use the template in @_picked.Count listing@(_picked.Count == 1 ? "" : "s")
                    </MudButton>
                </AuthorizeView>
            </MudPaper>
        }
    }
}

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private TextBlock? _saved;
    private bool _loaded, _pushing, _canEdit;
    private string _name = "", _text = "", _slug = "";
    private string? _filterText;
    private int? _filterShopId;
    private string _filterStatus = "all";
    private IReadOnlyList<ShopSummary> _shops = [];
    private IReadOnlyList<TextBlockUse> _uses = [];
    private IReadOnlyList<TextBlockCandidate> _candidates = [];
    private IReadOnlyList<TextBlockPushItem>? _review;
    private readonly HashSet<int> _picked = [];
    private readonly HashSet<int> _open = [];

    private TemplateListingFilter Filter => new()
    {
        Text = _filterText,
        ShopId = _filterShopId,
        Status = _filterStatus,
    };

    private IReadOnlyList<TextBlockUse> VisibleUses =>
        [.. _uses.Where(u => TemplateFilterMatcher.Matches(u, Filter))];

    private IReadOnlyList<TextBlockCandidate> VisibleCandidates =>
        [.. _candidates.Where(c => TemplateFilterMatcher.Matches(c, Filter))];

    private record ShopOption(int Id, string Name);

    private IEnumerable<ShopOption> FilterShops =>
        _shops.Select(s => new ShopOption(s.Id, s.Name))
            .Concat(_uses.Select(u => new ShopOption(u.ShopId, u.ShopName)))
            .Concat(_candidates.Select(c => new ShopOption(c.ShopId, c.ShopName)))
            .DistinctBy(s => s.Id)
            .OrderBy(s => s.Name);

    private bool? CandidateHeaderChecked
    {
        get
        {
            var visible = VisibleCandidates.Select(c => c.ListingId).ToList();
            if (visible.Count == 0) return false;
            var pickedCount = visible.Count(_picked.Contains);
            if (pickedCount == 0) return false;
            if (pickedCount == visible.Count) return true;
            return null;
        }
    }

    private void TogglePickAllVisible()
    {
        var visible = VisibleCandidates.Select(c => c.ListingId).ToList();
        if (visible.Count == 0) return;
        var allPicked = visible.All(_picked.Contains);
        if (allPicked)
            _picked.ExceptWith(visible);
        else
            _picked.UnionWith(visible);
    }

    private void OnFilterTextChanged(string? val) => _filterText = val;
    private void OnFilterShopChanged(int? val) => _filterShopId = val;
    private void OnFilterStatusChanged(string val) => _filterStatus = val;

    private bool Dirty => _saved is null
        ? _name.Trim().Length > 0 || _text.Trim().Length > 0
        : _name.Trim() != _saved.Name || SlugOrDefault != _saved.Slug || TextBlockService.Normalize(_text) != _saved.Text;
    private string SlugOrDefault => string.IsNullOrWhiteSpace(_slug) ? TextBlockMarkup.MakeSlug(_name) : _slug.Trim().ToLowerInvariant();
    private int WillChange => _uses.Count(u => u.Status == TextBlockUseStatus.WillChange);
    private int Pending => _uses.Count(u => u.DescriptionPending);
    private int Ready => _review?.Count(r => r.Preview.CanPush) ?? 0;

    private readonly TableSort<TextBlockUse> _useSort = new()
    {
        ["listing"] = u => u.Title,
        ["shop"] = u => u.ShopName,
        ["status"] = u => StatusText(u),
    };
    private readonly TableSort<TextBlockCandidate> _candidateSort = new()
    {
        ["listing"] = c => c.Title,
        ["shop"] = c => c.ShopName,
    };
    private readonly TableSort<TextBlockPushItem> _reviewSort = new()
    {
        ["listing"] = r => r.Title,
        ["changes"] = r => string.Join(", ", r.Preview.Changes.Select(c => c.Label)),
        ["ready"] = r => r.Preview.CanPush,
    };

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthState;
        _canEdit = state.User.IsInRole(Roles.Admin);
        if (Id is null && !_canEdit)
        {
            if (state.User.Identity?.IsAuthenticated == true)
                Nav.NavigateTo("account/access-denied", forceLoad: true);
            else
            {
                var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri);
                Nav.NavigateTo($"account/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            }
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _shops = await ShopService.ListAsync(); } catch { _shops = []; }
        if (Id is { } id)
        {
            _saved = await Blocks.GetAsync(id);
            if (_saved is not null)
            {
                (_name, _text, _slug) = (_saved.Name, _saved.Text, _saved.Slug);
                _uses = await Blocks.UsesAsync(id);
                _candidates = await Blocks.CandidatesAsync(id);
                _picked.Clear();
                _picked.UnionWith(_candidates.Select(c => c.ListingId));
            }
        }
        _loaded = true;
    }

    private async Task<string?> User() => (await AuthState).User.Identity?.Name;

    private void Revert() => (_name, _text, _slug) = _saved is null ? ("", "", "") : (_saved.Name, _saved.Text, _saved.Slug);

    private static string StatusText(TextBlockUse u) => u.Status switch
    {
        TextBlockUseStatus.UpToDate => u.DescriptionPending ? "Up to date, not pushed yet" : "Up to date",
        TextBlockUseStatus.WillChange => "Has the old text",
        _ => "Changed on Etsy: resolve it in the listing's editor first",
    };

    private static string StatusClass(TextBlockUseStatus s) => s switch
    {
        TextBlockUseStatus.UpToDate => "esm-dot-success",
        TextBlockUseStatus.WillChange => "esm-dot-info",
        _ => "esm-dot-warning",
    };

    private void Toggle(int listingId)
    {
        if (!_open.Remove(listingId)) _open.Add(listingId);
    }

    private void Pick(int listingId, bool on)
    {
        if (on) _picked.Add(listingId); else _picked.Remove(listingId);
    }

    private async Task SaveAsync()
    {
        var (id, error) = await Blocks.SaveAsync(_saved?.Id, _name, SlugOrDefault, _text, await User());
        if (error is not null) { Snackbar.Add(error, Severity.Warning); return; }
        if (_saved is null) { Nav.NavigateTo($"templates/text/{id}"); return; }
        await LoadAsync();
        Snackbar.Add(WillChange > 0
            ? $"Template saved. {WillChange} listing{(WillChange == 1 ? " has" : "s have")} the old text; apply it when you're ready."
            : "Template saved.", Severity.Success);
    }

    private async Task DeleteAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Delete text template",
            $"Delete \"{_saved!.Name}\"? Listings keep their text; they're only no longer linked to the template.",
            yesText: "Delete template", cancelText: "Cancel");
        if (ok != true) return;
        await Blocks.DeleteAsync(_saved.Id, await User());
        Nav.NavigateTo("templates/text");
    }

    private async Task ApplyAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Apply the template",
            $"Put the new text into {WillChange} listing description{(WillChange == 1 ? "" : "s")}? They become unpushed edits; " +
            "nothing is sent to Etsy until you review and push.", yesText: "Apply", cancelText: "Cancel");
        if (ok != true) return;
        var count = await Blocks.ApplyAsync(_saved!.Id, await User());
        await LoadAsync();
        _review = null;
        Snackbar.Add($"{count} listing{(count == 1 ? "" : "s")} updated as unpushed edits.", Severity.Success);
    }

    private async Task ReviewAsync() => _review = await Blocks.ReviewAsync(_saved!.Id);

    private async Task PushAsync()
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Push to Etsy",
            $"Push {Ready} listing{(Ready == 1 ? "" : "s")} to Etsy? Each one is a normal push with a snapshot you can restore.",
            yesText: "Push to Etsy", cancelText: "Cancel");
        if (ok != true) return;
        _pushing = true;
        try
        {
            var results = await Blocks.PushAsync(_saved!.Id, await User());
            var queued = results.Count(r => r.PushId is not null);
            var skipped = results.Where(r => r.PushId is null).ToList();
            Snackbar.Add($"{queued} push{(queued == 1 ? "" : "es")} queued; results appear on each listing and on the Jobs page.", Severity.Info);
            foreach (var s in skipped) Snackbar.Add($"{s.Title}: {string.Join(" ", s.Blockers)}", Severity.Warning);
            _review = null;
            await LoadAsync();
        }
        finally { _pushing = false; }
    }

    private async Task LinkAsync()
    {
        var count = await Blocks.LinkAsync(_saved!.Id, _picked, await User());
        await LoadAsync();
        Snackbar.Add($"{count} listing{(count == 1 ? "" : "s")} linked.", Severity.Success);
    }

    /// <summary>A new block's placeholder name follows its name until it's typed in.</summary>
    private void NameChanged(string? name)
    {
        if (_saved is null && (string.IsNullOrWhiteSpace(_slug) || _slug == TextBlockMarkup.MakeSlug(_name))) _slug = TextBlockMarkup.MakeSlug(name ?? "");
        _name = name ?? "";
    }

    private async Task CopyTokenAsync()
    {
        var ok = await Js.InvokeAsync<bool>("esm.copy", TextBlockMarkup.Token(SlugOrDefault));
        Snackbar.Add(ok ? $"Copied {TextBlockMarkup.Token(SlugOrDefault)}" : "Couldn't copy; select the placeholder and copy it.", ok ? Severity.Success : Severity.Warning);
    }

    private async Task DetachAsync(TextBlockUse u)
    {
        var ok = await Dialogs.ShowMessageBoxAsync("Stop using the template",
            $"Replace the placeholder in \"{u.Title}\" with the template's text? The listing keeps the text and can edit it, but no longer follows the template.",
            yesText: "Stop using", cancelText: "Cancel");
        if (ok != true) return;
        await Blocks.DetachAsync(_saved!.Id, u.ListingId, await User());
        await LoadAsync();
    }
}
