@using EtsyShopManager.Web.Modules.Listings
@using EtsyShopManager.Web.Modules.Templates
@inject TextBlockService Blocks

<div>
    @if (_blocks is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_blocks.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="muted">
            No text templates yet. Create one from text you use in several descriptions; the app finds the listings that already
            contain it.
        </MudText>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true">
            <thead>
                <tr>
                    <SortHeader Sort="_sort" Column="name" Changed="StateHasChanged">Name</SortHeader>
                    <SortHeader Sort="_sort" Column="slug" Changed="StateHasChanged">Placeholder</SortHeader>
                    <SortHeader Sort="_sort" Column="listings" Changed="StateHasChanged">Listings</SortHeader>
                    <SortHeader Sort="_sort" Column="update" Changed="StateHasChanged">Waiting for the new text</SortHeader>
                    <SortHeader Sort="_sort" Column="attention" Changed="StateHasChanged">Need a look</SortHeader>
                    <SortHeader Sort="_sort" Column="updated" Changed="StateHasChanged">Changed</SortHeader>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in _sort.Apply(_blocks))
                {
                    <tr>
                        <td><a href="@($"templates/text/{b.Id}")">@b.Name</a></td>
                        <td><code>@TextBlockMarkup.Token(b.Slug)</code></td>
                        <td>@b.Listings</td>
                        <td>@(b.WillChange == 0 ? "—" : b.WillChange.ToString())</td>
                        <td>@(b.NeedAttention == 0 ? "—" : b.NeedAttention.ToString())</td>
                        <td>@ListingFormat.Local(b.UpdatedAtUtc)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</div>

@code {
    private IReadOnlyList<TextBlockSummary>? _blocks;

    private readonly TableSort<TextBlockSummary> _sort = new()
    {
        ["name"] = b => b.Name,
        ["slug"] = b => b.Slug,
        ["listings"] = b => b.Listings,
        ["update"] = b => b.WillChange,
        ["attention"] = b => b.NeedAttention,
        ["updated"] = b => b.UpdatedAtUtc,
    };

    protected override async Task OnInitializedAsync() => _blocks = await Blocks.ListAsync();
}
