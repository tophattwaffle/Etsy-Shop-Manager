@page "/admin/audit"
@attribute [Authorize(Roles = Roles.Admin)]
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Audit log · Etsy Shop Manager</PageTitle>

<PageHeader Title="Audit log" />

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr>
                <SortHeader Sort="_sort" Column="when" Changed="LoadAsync">When</SortHeader>
                <SortHeader Sort="_sort" Column="user" Changed="LoadAsync">User</SortHeader>
                <SortHeader Sort="_sort" Column="action" Changed="LoadAsync">Action</SortHeader>
                <SortHeader Sort="_sort" Column="entity" Changed="LoadAsync">Entity</SortHeader>
                <SortHeader Sort="_sort" Column="details" Changed="LoadAsync">Details</SortHeader>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in _entries)
            {
                <tr>
                    <td>@e.AtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@e.UserName</td>
                    <td><code>@e.Action</code></td>
                    <td>@e.EntityType @e.EntityId</td>
                    <td>@e.Details</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    @if (_entries.Count == _pageSize)
    {
        <MudButton Class="mt-2" Variant="Variant.Text" OnClick="MoreAsync">Load more</MudButton>
    }
</MudPaper>

@code {
    private List<AuditEntry> _entries = [];
    private int _pageSize = 200;

    // Sorted in the query, so the order covers the whole log and "Load more" continues it.
    private readonly ColumnSort _sort = new("when", "user", "action", "entity", "details");

    protected override Task OnInitializedAsync()
    {
        _sort.Set("when", descending: true);
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.AuditEntries.AsNoTracking();
        var desc = _sort.Descending;
        var ordered = _sort.Column switch
        {
            "user" => q.OrderBy(e => EF.Functions.Collate(e.UserName!, "NOCASE"), desc),
            "action" => q.OrderBy(e => e.Action, desc),
            "entity" => q.OrderBy(e => e.EntityType, desc).ThenBy(e => e.EntityId),
            "details" => q.OrderBy(e => EF.Functions.Collate(e.Details!, "NOCASE"), desc),
            _ => q.OrderBy(e => e.Id, desc),
        };
        _entries = await ordered.ThenByDescending(e => e.Id).Take(_pageSize).ToListAsync();
    }

    private async Task MoreAsync()
    {
        _pageSize += 200;
        await LoadAsync();
    }
}
