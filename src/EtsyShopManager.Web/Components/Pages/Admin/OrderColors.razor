@page "/order-colors"
@page "/admin/order-colors"
@using EtsyShopManager.Web.Components.Pages.Orders
@using EtsyShopManager.Web.Modules.Orders
@inject OrderColorService Colors
@inject IAuditLog Audit
@inject ISnackbar Snackbar

<PageTitle>Order colors · Etsy Shop Manager</PageTitle>

<PageHeader Title="Order colors">
    <Summary>
        Color names found in variations and personalization tint those boxes on the Orders page and on the Home Assistant
        orders card. Home Assistant picks up changes on its next poll.
    </Summary>
    <Actions>
        <AuthorizeView Roles="@Roles.Admin">
            <SaveButtons Text="Save colors" Changed="Dirty" OnSave="SaveAsync" OnCancel="RevertAsync" />
        </AuthorizeView>
    </Actions>
</PageHeader>

@if (_problems.Count > 0)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @foreach (var p in _problems) { <div>@p</div> }
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4 esm-orders" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Metallic</MudText>
    <MudText Typo="Typo.body2" Class="muted mb-2">
        How strongly boxes are tinted and how metallic colors shine, here and on the Home Assistant card. 0 turns either off.
    </MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="4">
        <MudNumericField T="int" Value="_look.EffectiveMetallicTint" ValueChanged="@(v => SetLook(_look with { MetallicTint = v }))" Label="Tint strength (%)"
                         Min="0" Max="100" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!_canEdit" />
        <MudNumericField T="int" Value="_look.MetallicShine" ValueChanged="@(v => SetLook(_look with { MetallicShine = v }))" Label="Metal shine (%)"
                         Min="0" Max="100" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!_canEdit" />
        <MudSwitch T="bool" Value="_look.AnimateMetallic" ValueChanged="@(v => SetLook(_look with { AnimateMetallic = v }))" Color="Color.Primary"
                   Label="Glint sweeps across metal" Disabled="!_canEdit" />
    </MudStack>
    <div class="mt-3"><ColorBox Colors="_metallicColors" Text="@_metallicExample" Seed="preview" /> <ColorBox Colors="_metallicColors" Text="@($"{_metallicExample}, please")" Kind="@ColorBox.Note" Seed="preview" /></div>
</MudPaper>

<MudPaper Class="pa-4 mb-4 esm-orders" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Random</MudText>
    <MudText Typo="Typo.body2" Class="muted mb-2">
        Words that mean "any color". Those boxes get a multi-color effect drawn from the colors below, leaving out colors
        darker than the brightness given, greys, muddy browns and near-whites.
    </MudText>
    <MudTextField T="string" Value="_randomWords" ValueChanged="OnRandomWordsChanged" Label="Words, separated by commas" Immediate="true"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="esm-w-lg mb-3" ReadOnly="!_canEdit" />
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="4">
        <MudSelect T="string" Value="_look.RandomStyle" ValueChanged="@(v => SetLook(_look with { RandomStyle = v }))" Label="Effect"
                   Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!_canEdit">
            <MudSelectItem Value="@OrderColorLook.Lava">Lava lamp</MudSelectItem>
            <MudSelectItem Value="@OrderColorLook.Confetti">Confetti</MudSelectItem>
        </MudSelect>
        <MudNumericField T="int" Value="_look.EffectiveRandomTint" ValueChanged="@(v => SetLook(_look with { RandomTint = v }))"
                         Label="Tint strength (%)" Min="0" Max="100" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!_canEdit" />
        <MudNumericField T="int" Value="_look.RandomMinBrightness" ValueChanged="@(v => SetLook(_look with { RandomMinBrightness = v }))"
                         Label="Least brightness (%)" Min="0" Max="100" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="!_canEdit" />
        <MudSwitch T="bool" Value="_look.AnimateRandom" ValueChanged="@(v => SetLook(_look with { AnimateRandom = v }))" Color="Color.Primary"
                   Label="Effect moves" Disabled="!_canEdit" />
    </MudStack>
    <div class="mt-3"><ColorBox Colors="_colors" Text="Random" Seed="preview" /> <ColorBox Colors="_colors" Text="Random colors, please" Kind="@ColorBox.Note" Seed="preview" /></div>
</MudPaper>

<MudPaper Class="pa-4 esm-orders" Elevation="0" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-2">
        <MudText Typo="Typo.h6">Colors (@_rows.Count)</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudNumericField T="int" Value="_look.Tint" ValueChanged="@(v => SetLook(_look with { Tint = v, MetallicTint = _look.EffectiveMetallicTint, RandomTint = _look.EffectiveRandomTint }))"
                             Label="Tint strength (%)" Min="0" Max="100" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="esm-w-sm" ReadOnly="!_canEdit" />
            <MudTextField T="string" @bind-Value="_filter" Placeholder="Find a color" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" />
            <AuthorizeView Roles="@Roles.Admin">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="Add">Add color</MudButton>
            </AuthorizeView>
        </MudStack>
    </MudStack>
    <MudText Typo="Typo.body2" Class="muted mb-3">
        Give one color, or several separated by commas for a multi-color filament (they fade from one to the next).
        Metallic colors get a sheen and a glint of light.
    </MudText>

    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            @* Sorting reorders the rows once per click, so a row doesn't move while its name is being typed. *@
            <tr>
                <SortHeader Sort="_sort" Column="preview" Changed="SortRows">Preview</SortHeader>
                <SortHeader Sort="_sort" Column="name" Changed="SortRows">Name</SortHeader>
                <SortHeader Sort="_sort" Column="colors" Changed="SortRows">Colors</SortHeader>
                <SortHeader Sort="_sort" Column="metallic" Changed="SortRows">Metallic</SortHeader>
                <AuthorizeView Roles="@Roles.Admin">
                    <th class="esm-col-icon"></th>
                </AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Visible)
            {
                <tr @key="row">
                    <td class="esm-minw-sm"><ColorBox Colors="_colors" Text="@(string.IsNullOrWhiteSpace(row.Name) ? "New color" : row.Name)" Seed="preview" /></td>
                    <td><MudTextField T="string" @bind-Value="row.Name" @bind-Value:after="Changed" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" aria-label="Name" ReadOnly="!_canEdit" /></td>
                    <td><MudTextField T="string" @bind-Value="row.Hex" @bind-Value:after="Changed" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" aria-label="Colors" Placeholder="@OrderColorService.ExampleHex" ReadOnly="!_canEdit" /></td>
                    <td><MudCheckBox T="bool" @bind-Value="row.Metallic" @bind-Value:after="Changed" aria-label="Metallic" Disabled="!_canEdit" /></td>
                    <AuthorizeView Roles="@Roles.Admin">
                        <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@($"Remove {row.Name}")" OnClick="() => Remove(row)" /></td>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool _canEdit;

    private sealed class Row
    {
        public string Name { get; set; } = "";
        public string Hex { get; set; } = "";
        public bool Metallic { get; set; }
    }

    private List<Row> _rows = [];

    private readonly TableSort<Row> _sort = new()
    {
        ["preview"] = r => r.Name, // the swatch shows the name
        ["name"] = r => r.Name,
        ["colors"] = r => r.Hex,
        ["metallic"] = r => r.Metallic,
    };

    private void SortRows() => _rows = _sort.Apply(_rows).ToList();
    private string _randomWords = "";
    private string? _filter;
    private string _savedJson = "";
    private List<string> _problems = [];
    private OrderColorLook _look = OrderColorLook.Default;
    private OrderColorEngine? _colors;
    private OrderColorEngine? _metallicColors;
    private string _metallicExample = "Copper";

    private IEnumerable<Row> Visible => string.IsNullOrWhiteSpace(_filter)
        ? _rows
        : _rows.Where(r => r.Name.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase) || r.Name.Length == 0);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _canEdit = user.IsInRole(Roles.Admin);
        await RevertAsync();
    }

    private async Task RevertAsync()
    {
        var config = await Colors.GetAsync();
        _rows = config.Colors.Select(c => new Row { Name = c.Name, Hex = string.Join(", ", c.Hex), Metallic = c.Metallic }).ToList();
        _randomWords = string.Join(", ", config.RandomWords);
        _look = config.Style;
        _savedJson = Json(Current());
        _problems = [];
        UpdatePreview();
    }

    // Compared as JSON because the config holds lists; edits that end up back at the saved list aren't changes.
    private bool Dirty => Json(Current()) != _savedJson;

    private static string Json(OrderColorConfig config) => System.Text.Json.JsonSerializer.Serialize(config);

    private OrderColorConfig Current() => new(
        _rows.Select(r => new OrderColor(r.Name, Split(r.Hex), r.Metallic)).ToList(),
        Split(_randomWords),
        _look);

    private static List<string> Split(string text) =>
        text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private void UpdatePreview()
    {
        var current = Current();
        // Skip colors that don't parse yet, so a half-typed value doesn't break the preview.
        var usable = current with
        {
            Colors = current.Colors.Select(c => c with { Hex = c.Hex.Where(OrderColorService.IsHex).ToList() })
                .Where(c => c.Hex.Count > 0 && c.Name.Trim().Length > 0)
                .DistinctBy(c => c.Name.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToList(),
        };
        _colors = new OrderColorEngine(usable);
        var metalRow = usable.Colors.FirstOrDefault(c => c.Metallic);
        _metallicExample = metalRow?.Name ?? "Copper";
        _metallicColors = metalRow is not null
            ? _colors
            : new OrderColorEngine(usable with
            {
                Colors =
                [
                    .. usable.Colors.Where(c => !string.Equals(c.Name, "Copper", StringComparison.OrdinalIgnoreCase)),
                    new OrderColor("Copper", [OrderColorService.ExampleHex], true)
                ],
            });
    }

    private void Changed() => UpdatePreview();

    private void SetLook(OrderColorLook look)
    {
        _look = look;
        Changed();
    }

    private void OnRandomWordsChanged(string? value)
    {
        _randomWords = value ?? "";
        Changed();
    }

    private void Add()
    {
        _filter = null;
        _rows.Insert(0, new Row());
        Changed();
    }

    private void Remove(Row row)
    {
        _rows.Remove(row);
        Changed();
    }

    private async Task SaveAsync()
    {
        var config = Current();
        _problems = OrderColorService.Validate(config);
        if (_problems.Count > 0) return;

        var user = (await AuthState).User.Identity?.Name;
        await Colors.SaveAsync(config, user);
        await Audit.WriteAsync("orders.colors.saved", details: $"{config.Colors.Count} colors", userName: user);
        Snackbar.Add("Saved order colors", Severity.Success);
        await RevertAsync();
    }
}
