@page "/admin/api-keys"
@attribute [Authorize(Roles = Roles.Admin)]
@using EtsyShopManager.Web.Modules.Listings
@using EtsyShopManager.Web.Modules.Orders
@inject ApiKeyService Keys
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>API keys · Etsy Shop Manager</PageTitle>

<PageHeader Title="API keys">
    <Summary>
    Keys let other systems read from this app. Home Assistant uses one to read open orders
    (<code>@(Nav.BaseUri)api/ha/v1/open-orders</code>). A key is shown once, when you create it.
    </Summary>
</PageHeader>

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
        <MudTextField T="string" @bind-Value="_name" Label="Name (e.g. Home Assistant)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="esm-w-md" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">Create key</MudButton>
    </MudStack>
    @if (_newKey is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mt-3">
            Copy this key now; it won't be shown again.
            <div class="mt-2 d-flex align-center">
                <code class="redirect-uri">@_newKey</code>
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="CopyAsync" title="Copy" />
            </div>
        </MudAlert>
    }
</MudPaper>

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr>
                <SortHeader Sort="_sort" Column="name" Changed="StateHasChanged">Name</SortHeader>
                <SortHeader Sort="_sort" Column="key" Changed="StateHasChanged">Key</SortHeader>
                <SortHeader Sort="_sort" Column="created" Changed="StateHasChanged">Created</SortHeader>
                <SortHeader Sort="_sort" Column="used" Changed="StateHasChanged">Last used</SortHeader>
                <SortHeader Sort="_sort" Column="status" Changed="StateHasChanged">Status</SortHeader>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var k in _sort.Apply(_keys))
            {
                <tr class="@(k.RevokedAtUtc is null ? "" : "muted")">
                    <td>@k.Name</td>
                    <td><code>@k.Prefix…</code></td>
                    <td>@ListingFormat.Local(k.CreatedAtUtc) @(k.CreatedBy is null ? "" : $"by {k.CreatedBy}")</td>
                    <td>@ListingFormat.Local(k.LastUsedAtUtc)</td>
                    <td>@(k.RevokedAtUtc is null ? "Active" : $"Revoked {ListingFormat.Local(k.RevokedAtUtc)}")</td>
                    <td class="text-right">
                        @if (k.RevokedAtUtc is null)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => RevokeAsync(k)">Revoke</MudButton>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    @if (_keys.Count == 0) { <MudText Class="mt-2 muted">No keys yet.</MudText> }
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;

    private List<ApiKeyInfo> _keys = [];

    private readonly TableSort<ApiKeyInfo> _sort = new()
    {
        ["name"] = k => k.Name,
        ["key"] = k => k.Prefix,
        ["created"] = k => k.CreatedAtUtc,
        ["used"] = k => k.LastUsedAtUtc,
        ["status"] = k => k.RevokedAtUtc,
    };
    private string? _name = "Home Assistant";
    private string? _newKey;

    protected override async Task OnInitializedAsync() => _keys = await Keys.ListAsync();

    private async Task CreateAsync()
    {
        var user = (await AuthState).User.Identity?.Name;
        var (_, key) = await Keys.CreateAsync(_name ?? "", user);
        _newKey = key;
        _keys = await Keys.ListAsync();
    }

    private async Task CopyAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", _newKey);
            Snackbar.Add("Copied", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Copy failed; select the key and copy it manually", Severity.Warning);
        }
    }

    private async Task RevokeAsync(ApiKeyInfo k)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Revoke key",
            $"Revoke \"{k.Name}\"? Anything using it (e.g. Home Assistant) stops working until it gets a new key.",
            yesText: "Revoke", cancelText: "Cancel");
        if (confirmed != true) return;
        await Keys.RevokeAsync(k.Id, (await AuthState).User.Identity?.Name);
        _keys = await Keys.ListAsync();
    }
}
